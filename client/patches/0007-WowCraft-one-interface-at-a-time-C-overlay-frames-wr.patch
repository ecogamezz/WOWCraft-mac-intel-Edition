+    #[test]
+    fn one_interface_at_a_time() {
+        // (Minecraft in its world, WoW's mode, typing, a Minecraft screen) -> (WoW's, Minecraft's)
+        assert_eq!(interfaces_shown(true, false, false, false), (false, true), "playing Minecraft");
+        assert_eq!(interfaces_shown(true, true, false, false), (true, false), "WoW's mode (C)");
+        assert_eq!(interfaces_shown(true, false, true, false), (true, true), "typing in WoW's chat");
+        assert_eq!(interfaces_shown(true, false, false, true), (false, true), "a Minecraft screen");
+        assert_eq!(interfaces_shown(true, true, false, true), (false, true), "one that opened in WoW's mode");
+        assert_eq!(interfaces_shown(false, false, false, false), (true, false), "no Minecraft");
+    }
