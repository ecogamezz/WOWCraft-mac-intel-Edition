+/// A cheap fingerprint of a frame: a hash of every 509th byte (a prime, so it walks the columns;
+/// dense enough that a hotbar slot's highlight moving shows).
+fn sample(pixels: &[u8]) -> u64 {
+    pixels.iter().step_by(509).fold(0xcbf2_9ce4_8422_2325u64, |h, &b| (h ^ b as u64).wrapping_mul(0x0100_0000_01b3))
+}
+
+/// The newest frame for the render world to write into the overlay's texture: its pixels, top row
+/// first, and a number that changes with each frame.
+#[derive(Resource, Clone, Default, ExtractResource)]
+struct OverlayUpload {
+    image: Option<AssetId<Image>>,
+    size: UVec2,
+    pixels: Arc<Vec<u8>>,
+    seq: u64,
+}
+
+/// A published frame's rows top first: read back from the GPU's origin, `bottom_up`, they come
+/// bottom row first.
+fn top_first(pixels: &[u8], w: u32, h: u32, bottom_up: bool) -> Vec<u8> {
+    let row = (w * 4) as usize;
+    let rows = h as usize;
+    if !bottom_up {
+        return pixels[..row * rows].to_vec();
+    }
+    let mut out = Vec::with_capacity(row * rows);
+    for y in (0..rows).rev() {
+        out.extend_from_slice(&pixels[y * row..(y + 1) * row]);
+    }
+    out
 }
 
