+/// Which interfaces show, WoW's and Minecraft's: one at a time, switched with C along with the
+/// input. Minecraft's in its mode, and whenever one of its screens is open (it has the input
+/// then); WoW's in WoW's mode, while typing in its chat, and whenever Minecraft isn't in its world.
+pub(crate) fn interfaces_shown(mc_in_world: bool, wow_mode: bool, typing: bool, mc_screen: bool) -> (bool, bool) {
+    let minecraft = mc_in_world && (!wow_mode || mc_screen);
+    let wow = !mc_in_world || typing || (wow_mode && !mc_screen);
+    (wow, minecraft)
+}
+
