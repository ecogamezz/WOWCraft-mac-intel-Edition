+/// Every [`REPORT_SECS`] while Minecraft is in its world: how many frames Minecraft published and
+/// we took, and whether the newest one's pixels changed, which tells a Minecraft that stopped
+/// sending (or sends the same picture) from frames that arrive and don't show.
+fn report_flow(
+    wc: Res<WowCraft>,
+    overlay: Res<Overlay>,
+    time: Res<Time<Real>>,
+    mut next: Local<f32>,
+    mut last: Local<(u64, u64, u64)>,
+) {
+    let now = time.elapsed_secs();
+    if !wc.mc_in_world() || now < *next {
+        return;
+    }
+    *next = now + REPORT_SECS;
+    let published = wc.link.overlay_published();
+    let (last_published, last_taken, last_sample) = *last;
+    info!(
+        "wowcraft: overlay: Minecraft published {published} frames (+{}), we took {} (+{}); newest {}x{} id {}, pixels {} since the last report",
+        published.wrapping_sub(last_published),
+        overlay.taken,
+        overlay.taken - last_taken,
+        overlay.size.x,
+        overlay.size.y,
+        overlay.frame_id,
+        if overlay.sample == last_sample { "unchanged" } else { "changed" },
+    );
+    *last = (published, overlay.taken, overlay.sample);
+}
