+++ b/crates/wowcraft-link/src/lib.rs
@@ -0,0 +1,8 @@
+//! WowCraft's link to the Minecraft mod, with no Bevy in it: [`proto`], the byte layout both sides
+//! agree on, and [`link`], the game's end of the shared memory. `benilla-app`'s `wowcraft` module
+//! is the game on top of it.
+
+pub mod link;
+pub mod proto;
+
+pub use link::Link;
diff --git a/crates/wowcraft-link/src/link.rs b/crates/wowcraft-link/src/link.rs
new file mode 100644
index 00000000..c1b55d12
--- /dev/null
+++ b/crates/wowcraft-link/src/link.rs
@@ -0,0 +1,522 @@
+//! The game's end of the shared memory Minecraft reads: a POSIX shared memory object,
+//! `/SkyCraft_v1.<uid>`, where WowCraft on Windows had the named file mapping `Local\SkyCraft_v1`.
+//! The game makes it and Minecraft opens it (the mod's `MacNative.openFileMapping`).
+//!
+//! The object outlives both sides, as a Windows mapping outlives a process while the other still
+//! holds it: a game started again finds the one Minecraft has mapped and takes it over, resetting
+//! what the game owns (its state, its rings' heads, the overlay swap). The launcher removes it on
+//! Stop. Both sides stamp heartbeats in milliseconds of `CLOCK_UPTIME_RAW`.
+
+use std::ffi::CString;
+use std::sync::atomic::{fence, AtomicU32, AtomicU64, Ordering};
+
+use crate::proto::*;
+
+/// Minecraft counts as gone once its heartbeat is this old (ms).
+const MC_TIMEOUT_MS: u64 = 3000;
+
+/// Milliseconds of the clock both sides stamp heartbeats with.
+pub fn now_ms() -> u64 {
+    now_ns() / 1_000_000
+}
+
+// <time.h> on macOS 10.12 and later; the libc crate this workspace pins doesn't carry it.
+extern "C" {
+    fn clock_gettime_nsec_np(clock_id: libc::clockid_t) -> u64;
+}
+
+/// Nanoseconds of `CLOCK_UPTIME_RAW`, Minecraft's `QueryPerformanceCounter` (at 10⁹ a second).
+pub fn now_ns() -> u64 {
+    // SAFETY: a pure clock read.
+    unsafe { clock_gettime_nsec_np(libc::CLOCK_UPTIME_RAW) }
+}
+
+/// The POSIX name of a Windows mapping name, as `MacNative.shmName` makes it.
+pub fn shm_name(base: &str) -> String {
+    // SAFETY: getuid cannot fail.
+    format!("/{base}.{}", unsafe { libc::getuid() })
+}
+
+pub struct Link {
+    base: *mut u8,
+    /// The overlay slot we read (Minecraft writes into its private back slot, starting at 1).
+    overlay_front: u32,
+}
+
+// SAFETY: every access to the mapping goes through atomics or is ordered by the seqlocks and ring
+// indices the protocol defines; the pointer itself never changes while the link lives.
+unsafe impl Send for Link {}
+unsafe impl Sync for Link {}
+
+impl Drop for Link {
+    fn drop(&mut self) {
+        // SAFETY: `base` came from our own `mmap` of exactly this length.
+        unsafe {
+            libc::munmap(self.base.cast(), MAPPING_BYTES);
+        }
+    }
+}
+
+impl Link {
+    /// Makes (or takes over) the shared memory and resets everything the game side owns.
+    pub fn create() -> std::io::Result<Link> {
+        let name = CString::new(shm_name(MAPPING_NAME)).expect("no NUL in the name");
+        let base = Self::map(&name).or_else(|e| {
+            // A stale object of another size (an older protocol): it goes, and a fresh one is made.
+            if e.raw_os_error() == Some(libc::EINVAL) {
+                // SAFETY: a plain unlink by name.
+                unsafe { libc::shm_unlink(name.as_ptr()) };
+                Self::map(&name)
+            } else {
+                Err(e)
+            }
+        })?;
+        let link = Link {
+            base,
+            overlay_front: 2,
+        };
+        link.reset();
+        Ok(link)
+    }
+
+    fn map(name: &CString) -> std::io::Result<*mut u8> {
+        // SAFETY: plain POSIX calls on a descriptor we own and close.
+        unsafe {
+            let fd = libc::shm_open(name.as_ptr(), libc::O_CREAT | libc::O_RDWR, 0o600 as libc::c_uint);
+            if fd < 0 {
+                return Err(std::io::Error::last_os_error());
+            }
+            let mut st: libc::stat = std::mem::zeroed();
+            if libc::fstat(fd, &mut st) != 0 {
+                let e = std::io::Error::last_os_error();
+                libc::close(fd);
+                return Err(e);
+            }
+            // A new object is sized once (macOS allows one ftruncate of a shared memory object);
+            // one already the right size is reused, whoever made it.
+            if st.st_size == 0 {
+                if libc::ftruncate(fd, MAPPING_BYTES as libc::off_t) != 0 {
+                    let e = std::io::Error::last_os_error();
+                    libc::close(fd);
+                    return Err(e);
+                }
+            } else if st.st_size as usize != MAPPING_BYTES {
+                libc::close(fd);
+                return Err(std::io::Error::from_raw_os_error(libc::EINVAL));
+            }
+            let p = libc::mmap(
+                std::ptr::null_mut(),
+                MAPPING_BYTES,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_SHARED,
+                fd,
+                0,
+            );
+            libc::close(fd);
+            if p == libc::MAP_FAILED {
+                return Err(std::io::Error::last_os_error());
+            }
+            Ok(p.cast())
+        }
+    }
+
+    /// Everything the game owns, from a known state: Minecraft may still hold the object from a
+    /// game run before this one.
+    fn reset(&self) {
+        // SAFETY: all inside the mapping.
+        unsafe {
+            std::ptr::write_bytes(self.base.add(OFF_SKY_STATE), 0, std::mem::size_of::<SkyState>());
+            std::ptr::write_bytes(self.base.add(OFF_OVERLAY_CTL), 0, 0x100);
+            std::ptr::write_bytes(self.base.add(OFF_INPUT_RING), 0, RING_DATA);
+            std::ptr::write_bytes(self.base.add(OFF_COLLISION_RING), 0, RING_DATA);
+            std::ptr::write_bytes(self.base.add(OFF_ACTOR_TABLE), 0, AT_RECORDS + 64 * MAX_ACTORS);
+            std::ptr::write_bytes(self.base.add(OFF_EVENT_RING), 0, RING_DATA);
+            std::ptr::write_bytes(self.base.add(OFF_WORLD_ENTITIES), 0, WE_RECORDS + 96 * MAX_WORLD_ENTITIES);
+            std::ptr::write_bytes(self.base.add(OFF_RENDER_RING), 0, RING_DATA);
+        }
+        self.u32_at(H_VERSION).store(VERSION, Ordering::Relaxed);
+        self.u32_at(H_GAME_PID).store(std::process::id(), Ordering::Relaxed);
+        self.u64_at(H_GAME_HEARTBEAT).store(now_ms(), Ordering::Relaxed);
+        self.u32_at(H_MAGIC).store(MAGIC, Ordering::Release);
+    }
+
+    fn u32_at(&self, off: usize) -> &AtomicU32 {
+        debug_assert!(off % 4 == 0 && off + 4 <= MAPPING_BYTES);
+        // SAFETY: aligned, inside the mapping, which lives as long as `self`.
+        unsafe { AtomicU32::from_ptr(self.base.add(off).cast()) }
+    }
+
+    fn u64_at(&self, off: usize) -> &AtomicU64 {
+        debug_assert!(off % 8 == 0 && off + 8 <= MAPPING_BYTES);
+        // SAFETY: as `u32_at`.
+        unsafe { AtomicU64::from_ptr(self.base.add(off).cast()) }
+    }
+
+    fn write<T: bytemuck::Pod>(&self, off: usize, value: &T) {
+        let bytes = bytemuck::bytes_of(value);
+        // SAFETY: inside the mapping; ordering is the caller's protocol.
+        unsafe { std::ptr::copy_nonoverlapping(bytes.as_ptr(), self.base.add(off), bytes.len()) };
+    }
+
+    fn read<T: bytemuck::Pod>(&self, off: usize) -> T {
+        let mut out = T::zeroed();
+        let bytes = bytemuck::bytes_of_mut(&mut out);
+        // SAFETY: inside the mapping.
+        unsafe { std::ptr::copy_nonoverlapping(self.base.add(off), bytes.as_mut_ptr(), bytes.len()) };
+        out
+    }
+
+    /// The bytes at `off..off + len`, which Minecraft writes (a ring message, the overlay).
+    pub fn bytes(&self, off: usize, len: usize) -> &[u8] {
+        assert!(off + len <= MAPPING_BYTES);
+        // SAFETY: inside the mapping, which lives as long as `self`.
+        unsafe { std::slice::from_raw_parts(self.base.add(off), len) }
+    }
+
+    // ---- header -----------------------------------------------------------------------------
+
+    pub fn heartbeat(&self) {
+        self.u64_at(H_GAME_HEARTBEAT).store(now_ms(), Ordering::Release);
+    }
+
+    pub fn mc_alive(&self) -> bool {
+        let last = self.u64_at(H_MC_HEARTBEAT).load(Ordering::Acquire);
+        last != 0 && now_ms().saturating_sub(last) < MC_TIMEOUT_MS
+    }
+
+    pub fn mc_pid(&self) -> u32 {
+        self.u32_at(H_MC_PID).load(Ordering::Acquire)
+    }
+
+    // ---- seqlocked state --------------------------------------------------------------------
+
+    /// One frame's state, which Minecraft paces on (the sequence goes up 2 a frame).
+    pub fn write_sky_state(&self, state: &SkyState) {
+        self.seqlocked_write(OFF_SKY_STATE, state);
+    }
+
+    pub fn sky_state_seq(&self) -> u32 {
+        self.u32_at(OFF_SKY_STATE).load(Ordering::Acquire)
+    }
+
+    pub fn write_water_grid(&self, grid: &WaterGrid) {
+        self.seqlocked_write(OFF_WATER_GRID, grid);
+    }
+
+    /// Writes all of `value` but its leading sequence word, between the odd and even bumps.
+    fn seqlocked_write<T: bytemuck::Pod>(&self, off: usize, value: &T) {
+        let seq = self.u32_at(off);
+        let s = seq.load(Ordering::Relaxed);
+        seq.store(s.wrapping_add(1), Ordering::Relaxed);
+        fence(Ordering::Release);
+        let bytes = bytemuck::bytes_of(value);
+        // SAFETY: inside the mapping; the sequence word is skipped.
+        unsafe { std::ptr::copy_nonoverlapping(bytes.as_ptr().add(4), self.base.add(off + 4), bytes.len() - 4) };
+        seq.store(s.wrapping_add(2), Ordering::Release);
+    }
+
+    /// A consistent snapshot of Minecraft's state, or none if it kept changing under us.
+    pub fn read_mc_state(&self) -> Option<McState> {
+        self.seqlocked_read::<McState>(OFF_MC_STATE, 64)
+    }
+
+    fn seqlocked_read<T: bytemuck::Pod>(&self, off: usize, attempts: usize) -> Option<T> {
+        let seq = self.u32_at(off);
+        for _ in 0..attempts {
+            let s1 = seq.load(Ordering::Acquire);
+            if s1 & 1 != 0 {
+                std::hint::spin_loop();
+                continue;
+            }
+            let value: T = self.read(off);
+            fence(Ordering::Acquire);
+            if seq.load(Ordering::Relaxed) == s1 {
+                return Some(value);
+            }
+        }
+        None
+    }
+
+    /// Nearby units, which Minecraft mirrors as hittable stand-ins.
+    pub fn write_actors(&self, actors: &[ActorRecord]) {
+        let seq = self.u32_at(OFF_ACTOR_TABLE);
+        let s = seq.load(Ordering::Relaxed);
+        seq.store(s.wrapping_add(1), Ordering::Relaxed);
+        fence(Ordering::Release);
+        let count = actors.len().min(MAX_ACTORS);
+        self.u32_at(OFF_ACTOR_TABLE + 4).store(count as u32, Ordering::Relaxed);
+        if count > 0 {
+            let bytes: &[u8] = bytemuck::cast_slice(&actors[..count]);
+            // SAFETY: the table has room for `MAX_ACTORS` records.
+            unsafe { std::ptr::copy_nonoverlapping(bytes.as_ptr(), self.base.add(OFF_ACTOR_TABLE + AT_RECORDS), bytes.len()) };
+        }
+        seq.store(s.wrapping_add(2), Ordering::Release);
+    }
+
+    /// Minecraft's things we draw (arrows, items, cracks) and the block outline.
+    pub fn read_world_entities(&self) -> Option<(WorldEntitiesHeader, Vec<WorldEntity>)> {
+        let seq = self.u32_at(OFF_WORLD_ENTITIES);
+        for _ in 0..16 {
+            let s1 = seq.load(Ordering::Acquire);
+            if s1 & 1 != 0 {
+                std::hint::spin_loop();
+                continue;
+            }
+            let header: WorldEntitiesHeader = self.read(OFF_WORLD_ENTITIES);
+            let count = (header.count as usize).min(MAX_WORLD_ENTITIES);
+            let entities: Vec<WorldEntity> = (0..count)
+                .map(|i| self.read(OFF_WORLD_ENTITIES + WE_RECORDS + i * std::mem::size_of::<WorldEntity>()))
+                .collect();
+            fence(Ordering::Acquire);
+            if seq.load(Ordering::Relaxed) == s1 {
+                return Some((header, entities));
+            }
+        }
+        None
+    }
+
+    // ---- input ring (we produce) ------------------------------------------------------------
+
+    /// Queues one input event; dropped if Minecraft has fallen a whole ring behind.
+    pub fn push_input(&self, kind: u16, code: u16, a: i32, b: i32, c: i32) {
+        let head_at = self.u64_at(OFF_INPUT_RING + RING_HEAD);
+        let head = head_at.load(Ordering::Relaxed);
+        let tail = self.u64_at(OFF_INPUT_RING + RING_TAIL).load(Ordering::Acquire);
+        if head.wrapping_sub(tail) >= INPUT_RING_ENTRIES {
+            return;
+        }
+        let slot = OFF_INPUT_RING + RING_DATA + (head & (INPUT_RING_ENTRIES - 1)) as usize * 16;
+        self.write(slot, &InputEvent { kind, code, a, b, c });
+        head_at.store(head + 1, Ordering::Release);
+    }
+
+    // ---- collision ring (we produce, one thread) ----------------------------------------------
+
+    /// Appends one message; false if the ring has no room for it now (try again next frame).
+    pub fn write_collision(&self, kind: u32, payload: &[u8]) -> bool {
+        self.write_ring(OFF_COLLISION_RING, COLLISION_RING_BYTES - RING_DATA, kind, payload)
+    }
+
+    fn write_ring(&self, ring: usize, size: usize, kind: u32, payload: &[u8]) -> bool {
+        let msg = (8 + payload.len() + 7) & !7;
+        if msg > size / 2 {
+            return false;
+        }
+        let head_at = self.u64_at(ring + RING_HEAD);
+        let mut head = head_at.load(Ordering::Relaxed);
+        let tail = self.u64_at(ring + RING_TAIL).load(Ordering::Acquire);
+        let mut pos = (head % size as u64) as usize;
+        let pad = if pos + msg > size { size - pos } else { 0 };
+        if (size as u64).saturating_sub(head.wrapping_sub(tail)) < (msg + pad) as u64 {
+            return false;
+        }
+        let data = ring + RING_DATA;
+        if pad > 0 {
+            self.write(data + pos, &[COL_PAD, 0u32]);
+            head += pad as u64;
+            pos = 0;
+        }
+        self.write(data + pos, &[kind, payload.len() as u32]);
+        // SAFETY: the room was checked above and the message doesn't wrap.
+        unsafe { std::ptr::copy_nonoverlapping(payload.as_ptr(), self.base.add(data + pos + 8), payload.len()) };
+        head_at.store(head + msg as u64, Ordering::Release);
+        true
+    }
+
+    // ---- event ring (we consume) ------------------------------------------------------------
+
+    pub fn pop_event(&self) -> Option<McEvent> {
+        let head = self.u64_at(OFF_EVENT_RING + RING_HEAD).load(Ordering::Acquire);
+        let tail_at = self.u64_at(OFF_EVENT_RING + RING_TAIL);
+        let mut tail = tail_at.load(Ordering::Relaxed);
+        if tail >= head {
+            return None;
+        }
+        // Lapped: the oldest unread were overwritten.
+        if head - tail > EVENT_RING_ENTRIES {
+            tail = head - EVENT_RING_ENTRIES;
+        }
+        let event: McEvent = self.read(OFF_EVENT_RING + RING_DATA + (tail & (EVENT_RING_ENTRIES - 1)) as usize * 32);
+        tail_at.store(tail + 1, Ordering::Release);
+        Some(event)
+    }
+
+    // ---- render ring (we consume) -----------------------------------------------------------
+
+    /// Hands `each(type, payload)` every pending render message, up to about `max_bytes` of them.
+    /// The payload lies in the shared memory, valid until the next call frees its room.
+    pub fn drain_render(&self, max_bytes: usize, mut each: impl FnMut(u32, &[u8])) {
+        let ring = OFF_RENDER_RING;
+        let size = (RENDER_RING_BYTES - RING_DATA) as u64;
+        let head = self.u64_at(ring + RING_HEAD).load(Ordering::Acquire);
+        let tail_at = self.u64_at(ring + RING_TAIL);
+        let mut tail = tail_at.load(Ordering::Relaxed);
+        let mut done = 0usize;
+        while tail < head && done < max_bytes {
+            let pos = (tail % size) as usize;
+            let [kind, bytes]: [u32; 2] = self.read(ring + RING_DATA + pos);
+            if kind == REN_PAD {
+                tail += size - pos as u64;
+                continue;
+            }
+            each(kind, self.bytes(ring + RING_DATA + pos + 8, bytes as usize));
+            let msg = (8 + bytes as usize + 7) & !7;
+            tail += msg as u64;
+            done += msg;
+        }
+        tail_at.store(tail, Ordering::Release);
+    }
+
+    // ---- overlay triple buffer (we consume) ---------------------------------------------------
+
+    /// Swaps a newer frame into our front slot, if Minecraft published one.
+    pub fn acquire_overlay(&mut self) -> bool {
+        let state = self.u32_at(OFF_OVERLAY_CTL + OC_STATE);
+        if state.load(Ordering::Acquire) & OVERLAY_DIRTY == 0 {
+            return false;
+        }
+        let old = state.swap(self.overlay_front, Ordering::AcqRel);
+        self.overlay_front = old & 3;
+        true
+    }
+
+    /// Minecraft (re)connected: its writer starts again at slot 1.
+    pub fn reset_overlay(&mut self) {
+        self.u32_at(OFF_OVERLAY_CTL + OC_STATE).store(0, Ordering::Release);
+        self.overlay_front = 2;
+    }
+
+    pub fn overlay_front(&self) -> (OverlaySlotHdr, &[u8]) {
+        let slot = (self.overlay_front as usize).min(OVERLAY_SLOTS - 1);
+        let header: OverlaySlotHdr = self.read(OFF_OVERLAY_SLOT_HDR + slot * SLOT_HDR_BYTES);
+        let w = header.width.min(MAX_OVERLAY_W) as usize;
+        let h = header.height.min(MAX_OVERLAY_H) as usize;
+        (header, self.bytes(OFF_OVERLAY_PIXELS + slot * OVERLAY_SLOT_BYTES, w * h * 4))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// A link of its own per test: the name carries the test's tag, and the object goes after.
+    pub struct TestLink {
+        pub link: Link,
+        name: CString,
+    }
+
+    impl Drop for TestLink {
+        fn drop(&mut self) {
+            // SAFETY: unlink by name.
+            unsafe { libc::shm_unlink(self.name.as_ptr()) };
+        }
+    }
+
+    /// A `Link` on a private object, the protocol's layout and all.
+    pub fn test_link(tag: &str) -> TestLink {
+        let name = CString::new(format!("/wmc-{tag}-{}", std::process::id())).unwrap();
+        // SAFETY: as `Link::create`.
+        unsafe { libc::shm_unlink(name.as_ptr()) };
+        let base = Link::map(&name).expect("map");
+        let link = Link { base, overlay_front: 2 };
+        link.reset();
+        TestLink { link, name }
+    }
+
+    #[test]
+    fn the_header_says_who_we_are() {
+        let t = test_link("hdr");
+        assert_eq!(t.link.u32_at(H_MAGIC).load(Ordering::Relaxed), MAGIC);
+        assert_eq!(t.link.u32_at(H_VERSION).load(Ordering::Relaxed), VERSION);
+        assert_eq!(t.link.u32_at(H_GAME_PID).load(Ordering::Relaxed), std::process::id());
+        assert!(!t.link.mc_alive(), "no Minecraft yet");
+        t.link.u64_at(H_MC_HEARTBEAT).store(now_ms(), Ordering::Relaxed);
+        assert!(t.link.mc_alive());
+    }
+
+    #[test]
+    fn the_sky_state_goes_up_two_a_frame() {
+        let t = test_link("sky");
+        let state = SkyState { flags: SKY_IN_GAME, pos: [1.0, 2.0, 3.0], ..Default::default() };
+        t.link.write_sky_state(&state);
+        t.link.write_sky_state(&state);
+        assert_eq!(t.link.sky_state_seq(), 4);
+        let back: SkyState = t.link.read(OFF_SKY_STATE);
+        assert_eq!(back.pos, [1.0, 2.0, 3.0]);
+    }
+
+    #[test]
+    fn input_wraps_its_ring() {
+        let t = test_link("input");
+        for i in 0..5000u32 {
+            // Minecraft keeps up: consume as we go.
+            t.link.push_input(IN_KEY, (i % 300) as u16, 1, 0, 0);
+            let head = t.link.u64_at(OFF_INPUT_RING + RING_HEAD).load(Ordering::Relaxed);
+            t.link.u64_at(OFF_INPUT_RING + RING_TAIL).store(head, Ordering::Relaxed);
+        }
+        let head = t.link.u64_at(OFF_INPUT_RING + RING_HEAD).load(Ordering::Relaxed);
+        assert_eq!(head, 5000);
+        let last: InputEvent = t.link.read(OFF_INPUT_RING + RING_DATA + ((head - 1) & 4095) as usize * 16);
+        assert_eq!(last, InputEvent { kind: IN_KEY, code: (4999 % 300) as u16, a: 1, b: 0, c: 0 });
+    }
+
+    #[test]
+    fn collision_messages_pad_at_the_end_of_the_ring() {
+        let t = test_link("col");
+        let size = COLLISION_RING_BYTES - RING_DATA;
+        // Move the head and tail near the end, as after a long session.
+        let near_end = (size - 24) as u64;
+        t.link.u64_at(OFF_COLLISION_RING + RING_HEAD).store(near_end, Ordering::Relaxed);
+        t.link.u64_at(OFF_COLLISION_RING + RING_TAIL).store(near_end, Ordering::Relaxed);
+        assert!(t.link.write_collision(COL_CLEAR, &7u32.to_le_bytes()), "fits before the end");
+        assert!(t.link.write_collision(COL_TRIS, &[0u8; 64]), "wraps with a pad");
+        let head = t.link.u64_at(OFF_COLLISION_RING + RING_HEAD).load(Ordering::Relaxed);
+        let [pad_kind, _]: [u32; 2] = t.link.read(OFF_COLLISION_RING + RING_DATA + (near_end as usize + 16));
+        assert_eq!(pad_kind, COL_PAD);
+        let [kind, bytes]: [u32; 2] = t.link.read(OFF_COLLISION_RING + RING_DATA);
+        assert_eq!((kind, bytes), (COL_TRIS, 64));
+        assert_eq!(head, size as u64 + 72);
+    }
+
+    #[test]
+    fn events_come_back_in_order() {
+        let t = test_link("ev");
+        for i in 0..3u32 {
+            let e = McEvent { kind: EV_HIT_ACTOR, form_id: i, a: i as f32, ..Default::default() };
+            t.link.write(OFF_EVENT_RING + RING_DATA + i as usize * 32, &e);
+        }
+        t.link.u64_at(OFF_EVENT_RING + RING_HEAD).store(3, Ordering::Release);
+        let got: Vec<u32> = std::iter::from_fn(|| t.link.pop_event()).map(|e| e.form_id).collect();
+        assert_eq!(got, vec![0, 1, 2]);
+    }
+
+    #[test]
+    fn render_messages_are_drained_whole() {
+        let t = test_link("ren");
+        let ring = OFF_RENDER_RING;
+        t.link.write(ring + RING_DATA, &[REN_CLEAR_ALL, 0u32]);
+        t.link.write(ring + RING_DATA + 8, &[REN_ATLAS, 8u32]);
+        t.link.write(ring + RING_DATA + 16, &[16u32, 16u32]);
+        t.link.u64_at(ring + RING_HEAD).store(24, Ordering::Release);
+        let mut seen = Vec::new();
+        t.link.drain_render(1 << 20, |kind, payload| seen.push((kind, payload.to_vec())));
+        assert_eq!(seen.len(), 2);
+        assert_eq!(seen[0], (REN_CLEAR_ALL, vec![]));
+        assert_eq!(seen[1].0, REN_ATLAS);
+        assert_eq!(bytemuck::pod_read_unaligned::<RenAtlas>(&seen[1].1).width, 16);
+        assert_eq!(t.link.u64_at(ring + RING_TAIL).load(Ordering::Relaxed), 24);
+    }
+
+    #[test]
+    fn the_overlay_swaps_only_when_minecraft_published() {
+        let mut t = test_link("ovl");
+        assert!(!t.link.acquire_overlay(), "nothing published");
+        // Minecraft published slot 1.
+        t.link.u32_at(OFF_OVERLAY_CTL).store(1 | OVERLAY_DIRTY, Ordering::Release);
+        t.link.write(OFF_OVERLAY_SLOT_HDR + SLOT_HDR_BYTES, &OverlaySlotHdr { width: 2, height: 1, ..Default::default() });
+        assert!(t.link.acquire_overlay());
+        let (hdr, pixels) = t.link.overlay_front();
+        assert_eq!((hdr.width, hdr.height, pixels.len()), (2, 1, 8));
+        assert_eq!(t.link.u32_at(OFF_OVERLAY_CTL).load(Ordering::Relaxed), 2, "our old front is its next middle");
+    }
+}
