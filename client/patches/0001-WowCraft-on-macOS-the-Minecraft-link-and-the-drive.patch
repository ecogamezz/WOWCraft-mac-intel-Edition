@@ -0,0 +1,455 @@
+//! WowCraft: Minecraft played inside this client. The WowCraft Fabric mod runs a hidden Minecraft
+//! whose player is ours: Minecraft's physics move us, its hearts are our life, its hotbar and
+//! screens draw over WoW, its blocks stand in WoW's world. The two talk through shared memory
+//! ([`wowcraft_link`]); this module is the WoW side, in [`WowCraftPlugin`], on only when the
+//! launcher starts us with `WOWCRAFT=1`.
+//!
+//! Per frame, in order:
+//! - [`tick_link`] beats, reads Minecraft's state and its events, and decides who owns input;
+//! - [`input`] hands Minecraft the keyboard and mouse (all but WoW's own keys), and turns our view;
+//! - [`prepare_drive`] puts Minecraft's player, on our clock, where the controller reads it
+//!   (`crate::player`'s puppet branch walks our body there and streams it to the server);
+//! - [`publish_sky_state`] tells Minecraft where we are, where we look and what we're doing.
+//!
+//! Coordinates: Minecraft's blocks are our yards and its axes are Bevy's (+X east, +Y up, +Z
+//! south), so a position crosses unchanged. Minecraft's yaw is 0 facing +Z and grows to the west;
+//! ours (`Player::face_yaw`, the camera's) is 0 facing −Z, so one is π minus the other. Its pitch
+//! looks down where ours looks up.
+
+pub(crate) mod input;
+
+use std::path::PathBuf;
+
+use bevy::prelude::*;
+use bevy::window::PrimaryWindow;
+
+use wowcraft_link::proto::*;
+use wowcraft_link::Link;
+
+use crate::char_select::ClientState;
+use crate::player::Player;
+
+/// Whether the launcher started us as WowCraft's WoW (`WOWCRAFT=1`).
+pub(crate) fn enabled() -> bool {
+    std::env::var("WOWCRAFT").is_ok_and(|v| v == "1")
+}
+
+pub(crate) struct WowCraftPlugin;
+
+impl Plugin for WowCraftPlugin {
+    fn build(&self, app: &mut App) {
+        // Who owns input is asked by the bindings and the camera even with WowCraft off.
+        app.init_resource::<InputOwner>().init_resource::<Drive>();
+        if !enabled() {
+            return;
+        }
+        let link = match Link::create() {
+            Ok(link) => link,
+            Err(e) => {
+                error!("wowcraft: couldn't create the Minecraft link: {e}");
+                return;
+            }
+        };
+        info!("wowcraft: link up (pid {}), waiting for Minecraft", std::process::id());
+        app.insert_resource(WowCraft::new(link))
+            .add_systems(
+                PreUpdate,
+                tick_link.after(bevy::input::InputSystems),
+            )
+            .add_systems(
+                Update,
+                (
+                    input::forward_input.before(crate::ui_script::UiInput),
+                    watch_server_moves
+                        .in_set(benilla_world::schedule::WorldStage::Input)
+                        .before(crate::player::PlayerControlSet),
+                    prepare_drive
+                        .in_set(benilla_world::schedule::WorldStage::Input)
+                        .after(watch_server_moves)
+                        .before(crate::player::PlayerControlSet),
+                    input::hold_cursor.after(crate::player::PlayerControlSet),
+                ),
+            )
+            .add_systems(PostUpdate, publish_sky_state);
+        // `WOWCRAFT_TEST_CREATE=1`: an empty roster opens character creation by itself, so a
+        // scripted run (`WOW_CHARCREATE_NAME`, `WOW_CHARCREATE_PICK`) can make its character.
+        if std::env::var("WOWCRAFT_TEST_CREATE").is_ok_and(|v| v == "1") {
+            app.add_systems(Update, test_create_when_empty);
+        }
+    }
+}
+
+fn test_create_when_empty(
+    roster: Res<crate::char_select::Roster>,
+    state: Res<State<ClientState>>,
+    mut next: ResMut<NextState<ClientState>>,
+    time: Res<Time>,
+    mut since: Local<Option<f32>>,
+) {
+    if *state.get() != ClientState::CharSelect || !roster.is_empty() {
+        *since = None;
+        return;
+    }
+    let now = time.elapsed_secs();
+    // A moment for the roster to arrive before it counts as empty.
+    if now - *since.get_or_insert(now) > 3.0 {
+        info!("wowcraft: no character yet; opening character creation");
+        next.set(ClientState::CharCreate);
+        *since = None;
+    }
+}
+
+/// Who owns the keyboard and mouse this frame. With `minecraft`, WoW's bindings run only WoW's
+/// own keys ([`input::is_wow_key`]) and the world takes no clicks; everything else is Minecraft's.
+#[derive(Resource, Default, Clone, Copy, Debug)]
+pub(crate) struct InputOwner {
+    pub(crate) minecraft: bool,
+}
+
+/// Minecraft's player this frame, as the controller's puppet branch wants it. `active` only while
+/// Minecraft is in its world, alive to us, and has arrived where we last put it.
+#[derive(Resource, Default, Clone, Copy, Debug)]
+pub(crate) struct Drive {
+    pub(crate) active: bool,
+    /// Feet, Bevy space, interpolated between Minecraft's last two ticks on our clock.
+    pub(crate) feet: Vec3,
+    /// Where the eye is: feet plus Minecraft's smoothed eye height.
+    pub(crate) eye: Vec3,
+    /// Our view (Bevy convention: yaw 0 faces −Z, pitch up is positive), which the body faces.
+    pub(crate) yaw: f32,
+    pub(crate) pitch: f32,
+    pub(crate) on_ground: bool,
+    pub(crate) swimming: bool,
+    pub(crate) flying: bool,
+    pub(crate) sneaking: bool,
+    pub(crate) sprinting: bool,
+    /// Minecraft's camera: 0 first person, 1 behind, 2 in front.
+    pub(crate) camera_mode: u32,
+    pub(crate) camera_distance: f32,
+    /// Vertical, degrees.
+    pub(crate) fov_deg: f32,
+}
+
+#[derive(Resource)]
+pub(crate) struct WowCraft {
+    pub(crate) link: Link,
+    /// Minecraft's last state, while it's alive.
+    pub(crate) mc: Option<McState>,
+    /// The Minecraft process we last saw, so a restart resets the overlay swap.
+    mc_pid: u32,
+    /// C toggles WoW's cursor: on, WoW has the mouse and keyboard, Minecraft stands still.
+    pub(crate) cursor_mode: bool,
+    /// Our view, Minecraft degrees (what `SkyState` carries).
+    pub(crate) look_yaw: f32,
+    pub(crate) look_pitch: f32,
+    /// Bumped whenever WoW puts us somewhere (login, a teleport, a worldport, a landing).
+    teleport_seq: u32,
+    /// Where that put us, for `SkyState::pos` while Minecraft hasn't arrived.
+    teleport_pos: Vec3,
+    /// A server move landed this frame; it's published once the controller has applied it.
+    teleport_pending: bool,
+    collision_epoch: u32,
+    world_id: u32,
+    /// We were in the world last frame (an entry is a teleport).
+    was_in_world: bool,
+    /// We were carried (a taxi) last frame (the landing is a teleport).
+    was_carried: bool,
+    /// Minecraft's events this frame, for the systems that act on them.
+    pub(crate) events: Vec<McEvent>,
+    /// Logged once: Minecraft's first state.
+    seen_mc: bool,
+}
+
+impl WowCraft {
+    fn new(link: Link) -> Self {
+        WowCraft {
+            link,
+            mc: None,
+            mc_pid: 0,
+            cursor_mode: false,
+            look_yaw: 0.0,
+            look_pitch: 0.0,
+            teleport_seq: 0,
+            teleport_pos: Vec3::ZERO,
+            teleport_pending: false,
+            collision_epoch: 1,
+            world_id: 0,
+            was_in_world: false,
+            was_carried: false,
+            events: Vec::new(),
+            seen_mc: false,
+        }
+    }
+
+    /// Minecraft is there and in its world.
+    pub(crate) fn mc_in_world(&self) -> bool {
+        self.mc.is_some_and(|m| m.flags & MC_IN_WORLD != 0)
+    }
+
+    /// Minecraft has a screen open (its inventory, chat, a chest): it owns the cursor.
+    pub(crate) fn mc_screen_open(&self) -> bool {
+        self.mc.is_some_and(|m| m.flags & MC_SCREEN_OPEN != 0)
+    }
+
+    /// Minecraft has gone where we last put it.
+    fn mc_arrived(&self) -> bool {
+        self.mc.is_some_and(|m| m.teleport_ack == self.teleport_seq)
+    }
+
+    /// Point our view the way the body faces (Bevy yaw), as after a teleport.
+    pub(crate) fn face(&mut self, bevy_yaw: f32) {
+        self.look_yaw = mc_yaw_of(bevy_yaw);
+    }
+
+    fn teleport(&mut self, to: Vec3) {
+        self.teleport_seq = self.teleport_seq.wrapping_add(1);
+        self.teleport_pos = to;
+    }
+}
+
+/// Minecraft's yaw (degrees, 0 facing +Z) of our yaw (radians, 0 facing −Z), and back.
+pub(crate) fn mc_yaw_of(bevy_yaw: f32) -> f32 {
+    wrap_degrees(180.0 - bevy_yaw.to_degrees())
+}
+
+pub(crate) fn bevy_yaw_of(mc_yaw: f32) -> f32 {
+    (180.0 - mc_yaw).to_radians()
+}
+
+fn wrap_degrees(d: f32) -> f32 {
+    let w = d.rem_euclid(360.0);
+    if w > 180.0 {
+        w - 360.0
+    } else {
+        w
+    }
+}
+
+/// Beat, read Minecraft, collect its events, and settle who owns input.
+fn tick_link(
+    mut wc: ResMut<WowCraft>,
+    mut owner: ResMut<InputOwner>,
+    state: Res<State<ClientState>>,
+    capture: Res<crate::ui_script::UiKeyboardCapture>,
+) {
+    wc.link.heartbeat();
+    wc.mc = if wc.link.mc_alive() { wc.link.read_mc_state().or(wc.mc) } else { None };
+    let pid = if wc.mc.is_some() { wc.link.mc_pid() } else { 0 };
+    if pid != wc.mc_pid {
+        if pid != 0 {
+            info!("wowcraft: Minecraft is here (pid {pid})");
+            wc.link.reset_overlay();
+        } else {
+            info!("wowcraft: Minecraft has gone");
+        }
+        wc.mc_pid = pid;
+        wc.seen_mc = false;
+    }
+    if let (Some(mc), false) = (wc.mc, wc.seen_mc) {
+        if mc.flags & MC_IN_WORLD != 0 {
+            info!("wowcraft: Minecraft put us at {:.1} {:.1} {:.1}", mc.pos[0], mc.pos[1], mc.pos[2]);
+            wc.seen_mc = true;
+        }
+    }
+    let mut events = std::mem::take(&mut wc.events);
+    events.clear();
+    while let Some(e) = wc.link.pop_event() {
+        events.push(e);
+    }
+    wc.events = events;
+    // Minecraft has the keys while we play: in the world, Minecraft in its, no WoW cursor and no
+    // WoW edit box typing (chat), or whenever one of Minecraft's own screens is open.
+    let in_world = *state.get() == ClientState::InWorld;
+    owner.minecraft = in_world
+        && wc.mc_in_world()
+        && !capture.typing
+        && (!wc.cursor_mode || wc.mc_screen_open());
+}
+
+/// A server move (a teleport, a worldport, the GM `.tele`, a death's graveyard): Minecraft must
+/// follow, so the drive stops until it has.
+fn watch_server_moves(
+    mut wc: ResMut<WowCraft>,
+    mut teleports: MessageReader<crate::net::TeleportMessage>,
+    mut worldports: MessageReader<crate::net::WorldportMessage>,
+    mut self_moves: MessageReader<crate::net::SelfMoveMessage>,
+) {
+    let mut moved = false;
+    for t in teleports.read() {
+        info!("wowcraft: the server teleported us to {:?}", t.position);
+        moved = true;
+    }
+    for w in worldports.read() {
+        info!("wowcraft: the server sent us to map {} at {:?}", w.map_id, w.position);
+        wc.collision_epoch = wc.collision_epoch.wrapping_add(1);
+        moved = true;
+    }
+    if self_moves.read().count() > 0 {
+        moved = true;
+    }
+    if moved {
+        wc.teleport_pending = true;
+    }
+}
+
+/// Minecraft's player on our frame clock, for the controller: the last two physics ticks lerped
+/// at our time, as Minecraft's own renderer does with its partial tick.
+fn prepare_drive(wc: Res<WowCraft>, mut drive: ResMut<Drive>, player: Res<Player>) {
+    let Some(mc) = wc.mc.filter(|_| wc.mc_in_world()) else {
+        drive.active = false;
+        return;
+    };
+    let tick_ns = (mc.tick_ms.max(1.0) as f64) * 1.0e6;
+    let since = wowcraft_link::link::now_ns() as f64 - mc.tick_qpc as f64;
+    let t = (since / tick_ns).clamp(0.0, 1.0);
+    let lerp = |a: [f64; 3], b: [f64; 3]| {
+        Vec3::new(
+            (a[0] + (b[0] - a[0]) * t) as f32,
+            (a[1] + (b[1] - a[1]) * t) as f32,
+            (a[2] + (b[2] - a[2]) * t) as f32,
+        )
+    };
+    // No tick yet (a Minecraft that hasn't run one): its render position.
+    let feet = if mc.tick_qpc == 0 {
+        Vec3::new(mc.pos[0] as f32, mc.pos[1] as f32, mc.pos[2] as f32)
+    } else {
+        lerp(mc.prev, mc.cur)
+    };
+    let eye_height = mc.tick_eye_o + (mc.tick_eye - mc.tick_eye_o) * t as f32;
+    let eye_height = if eye_height > 0.0 { eye_height } else { mc.eye_height };
+    *drive = Drive {
+        // Not while a server move waits for Minecraft, nor while the server carries us.
+        active: player.active && wc.mc_arrived() && !wc.teleport_pending && !player.is_carried(),
+        feet,
+        eye: feet + Vec3::Y * eye_height,
+        yaw: bevy_yaw_of(wc.look_yaw),
+        pitch: -wc.look_pitch.to_radians(),
+        on_ground: mc.flags & MC_ON_GROUND != 0,
+        swimming: mc.flags & MC_SWIMMING != 0,
+        flying: mc.flags & MC_FLYING != 0,
+        sneaking: mc.flags & MC_SNEAKING != 0,
+        sprinting: mc.flags & MC_SPRINTING != 0,
+        camera_mode: mc.camera_mode,
+        camera_distance: mc.camera_distance,
+        fov_deg: if mc.fov_deg > 1.0 { mc.fov_deg } else { 70.0 },
+    };
+}
+
+/// Tell Minecraft where we are and what we're doing; Minecraft paces its frames on this.
+fn publish_sky_state(
+    mut wc: ResMut<WowCraft>,
+    player: Res<Player>,
+    state: Res<State<ClientState>>,
+    cover: Option<Res<crate::loading_screen::LoadingScreen>>,
+    owner: Res<InputOwner>,
+    map: Option<Res<benilla_world::world_map::CurrentMap>>,
+    window: Query<&Window, With<PrimaryWindow>>,
+    self_store: Query<&crate::net::ObjectStore, With<crate::net::SelfPlayer>>,
+) {
+    let in_world = *state.get() == ClientState::InWorld && player.active;
+    let loading = cover.is_some_and(|c| c.covering());
+    let carried = in_world && player.is_carried();
+    // Every way WoW puts us somewhere Minecraft must follow: entering the world, the server
+    // moving us, and a taxi landing ("carried no longer; Minecraft goes where we are").
+    if in_world && !wc.was_in_world {
+        info!("wowcraft: in the world at {:?}; Minecraft follows", player.pos);
+        let yaw = player.facing();
+        wc.face(yaw);
+        wc.teleport(player.pos);
+    } else if in_world && wc.teleport_pending {
+        let yaw = player.facing();
+        wc.face(yaw);
+        wc.teleport(player.pos);
+    } else if wc.was_carried && !carried && in_world {
+        info!("wowcraft: carried no longer; Minecraft goes where we are");
+        wc.teleport(player.pos);
+    }
+    wc.teleport_pending = false;
+    wc.was_in_world = in_world;
+    wc.was_carried = carried;
+    if let Some(map) = map.as_ref() {
+        let id = map.0 + 1;
+        if id != wc.world_id {
+            wc.world_id = id;
+            wc.collision_epoch = wc.collision_epoch.wrapping_add(1);
+        }
+    }
+
+    let mut flags = 0;
+    if in_world {
+        flags |= SKY_IN_GAME;
+    }
+    if loading {
+        flags |= SKY_LOADING;
+    }
+    // WoW has the input (its cursor, its chat): Minecraft lets go of what it holds.
+    if in_world && !owner.minecraft {
+        flags |= SKY_MENU_OPEN;
+    }
+    if carried {
+        flags |= SKY_CARRIED;
+    }
+    if player.is_riding_transport() {
+        flags |= SKY_RIDING;
+    }
+    if self_store.single().is_ok_and(|s| s.0.player_is_ghost()) {
+        flags |= SKY_GHOST;
+    }
+    let (w, h, hires) = window
+        .single()
+        .map(|w| (w.physical_width(), w.physical_height(), w.scale_factor() > 1.0))
+        .unwrap_or((1280, 800, false));
+    if hires {
+        flags |= SKY_HIRES;
+    }
+    // Before Minecraft has arrived, where we put it; after, where we are (it follows us there
+    // only on a new teleport).
+    let pos = if wc.mc_arrived() { player.pos } else { wc.teleport_pos };
+    let state = SkyState {
+        seq: 0,
+        flags,
+        world_id: wc.world_id,
+        collision_epoch: wc.collision_epoch,
+        pos: [pos.x as f64, pos.y as f64, pos.z as f64],
+        yaw: wc.look_yaw,
+        pitch: wc.look_pitch,
+        teleport_seq: wc.teleport_seq,
+        viewport_w: w.min(MAX_OVERLAY_W),
+        viewport_h: h.min(MAX_OVERLAY_H),
+        game_hour: 12.0,
+    };
+    wc.link.write_sky_state(&state);
+}
+
+/// The launcher's files for us (`WOWCRAFT_*_FILE`), read when there.
+pub(crate) fn env_file(var: &str) -> Option<PathBuf> {
+    std::env::var_os(var).map(PathBuf::from).filter(|p| !p.as_os_str().is_empty())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn yaws_cross_both_ways() {
+        // Facing north (−Z) is Minecraft's 180; west is 90 in both.
+        assert!((mc_yaw_of(0.0).abs() - 180.0).abs() < 1e-4);
+        assert!((mc_yaw_of(std::f32::consts::FRAC_PI_2) - 90.0).abs() < 1e-4);
+        for yaw in [-3.0f32, -1.0, 0.0, 0.5, 2.5] {
+            let back = bevy_yaw_of(mc_yaw_of(yaw));
+            let d = (back - yaw).rem_euclid(std::f32::consts::TAU);
+            assert!(d < 1e-4 || (std::f32::consts::TAU - d) < 1e-4, "{yaw} -> {back}");
+        }
+    }
+
+    /// A Minecraft yaw points the same way our yaw does.
+    #[test]
+    fn a_yaw_points_the_same_way() {
+        for mc in [0.0f32, 45.0, 90.0, 180.0, -90.0] {
+            let r = mc.to_radians();
+            let minecraft_forward = Vec3::new(-r.sin(), 0.0, r.cos());
+            let ours = Quat::from_rotation_y(bevy_yaw_of(mc)) * Vec3::NEG_Z;
+            assert!((minecraft_forward - ours).length() < 1e-4, "{mc}: {minecraft_forward} vs {ours}");
+        }
+    }
+}
