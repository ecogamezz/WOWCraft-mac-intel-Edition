+//! The shared-memory protocol between this client and the WowCraft Minecraft mod: SkyCraft's
+//! version 11 (`protocol/skycraft_protocol.h` in chasmlol/SkyCraft) with WowCraft's additions,
+//! byte for byte what the mod's `dev.skycraft.link.Proto` reads and writes. Every multi-byte value
+//! is little-endian; positions are Minecraft space, which is Bevy space here: blocks are yards,
+//! +X east, +Y up, +Z south.
+
+/// `"SKYC"`.
+pub const MAGIC: u32 = 0x4359_4B53;
+pub const VERSION: u32 = 11;
+/// The mapping's name on Windows; on macOS the POSIX object `/SkyCraft_v1.<uid>`.
+pub const MAPPING_NAME: &str = "SkyCraft_v1";
+
+// ---- regions ------------------------------------------------------------------------------------
+pub const OFF_HEADER: usize = 0x0;
+pub const OFF_SKY_STATE: usize = 0x100;
+pub const OFF_MC_STATE: usize = 0x200;
+pub const OFF_OVERLAY_CTL: usize = 0x300;
+pub const OFF_OVERLAY_SLOT_HDR: usize = 0x340;
+pub const OFF_WATER_GRID: usize = 0x400;
+pub const OFF_INPUT_RING: usize = 0x1000;
+pub const OFF_ACTOR_TABLE: usize = 0x12000;
+pub const OFF_EVENT_RING: usize = 0x17000;
+pub const OFF_WORLD_ENTITIES: usize = 0x1C000;
+pub const OFF_COLLISION_RING: usize = 0x20000;
+pub const COLLISION_RING_BYTES: usize = 32 << 20;
+pub const OFF_OVERLAY_PIXELS: usize = OFF_COLLISION_RING + COLLISION_RING_BYTES;
+pub const MAX_OVERLAY_W: u32 = 3840;
+pub const MAX_OVERLAY_H: u32 = 2160;
+pub const OVERLAY_SLOT_BYTES: usize = MAX_OVERLAY_W as usize * MAX_OVERLAY_H as usize * 4;
+pub const OVERLAY_SLOTS: usize = 3;
+pub const OFF_RENDER_RING: usize = OFF_OVERLAY_PIXELS + OVERLAY_SLOT_BYTES * OVERLAY_SLOTS;
+pub const RENDER_RING_BYTES: usize = 64 << 20;
+pub const MAPPING_BYTES: usize = OFF_RENDER_RING + RENDER_RING_BYTES;
+
+// ---- header -------------------------------------------------------------------------------------
+pub const H_MAGIC: usize = 0;
+pub const H_VERSION: usize = 4;
+pub const H_GAME_PID: usize = 8;
+pub const H_MC_PID: usize = 12;
+pub const H_GAME_HEARTBEAT: usize = 16;
+pub const H_MC_HEARTBEAT: usize = 24;
+
+// ---- game -> Minecraft state (seqlock) ----------------------------------------------------------
+pub const SKY_IN_GAME: u32 = 1 << 0;
+/// A WoW window owns input: Minecraft lets go of held keys.
+pub const SKY_MENU_OPEN: u32 = 1 << 1;
+pub const SKY_LOADING: u32 = 1 << 2;
+/// WowCraft: our character is a ghost; Minecraft runs half again as fast.
+pub const SKY_GHOST: u32 = 1 << 3;
+/// WowCraft: the server moves us (a taxi flight); Minecraft holds where we last put it.
+pub const SKY_CARRIED: u32 = 1 << 4;
+/// WowCraft: on a boat, zeppelin or tram; Minecraft shows "Space: get off".
+pub const SKY_RIDING: u32 = 1 << 5;
+/// WowCraft: the viewport is in physical pixels on a Retina screen; Minecraft scales its GUI up.
+pub const SKY_HIRES: u32 = 1 << 6;
+/// WowCraft: no first-person hands (a bag or another WoW window is over the view).
+pub const SKY_NO_HAND: u32 = 1 << 7;
+/// WowCraft: no left hand (WoW's chat sits where it would be).
+pub const SKY_NO_LEFT_HAND: u32 = 1 << 8;
+
+#[repr(C)]
+#[derive(Clone, Copy, Default, Debug, PartialEq, bytemuck::Pod, bytemuck::Zeroable)]
+pub struct SkyState {
+    pub seq: u32,
+    pub flags: u32,
+    /// The map id plus one (0 is "none").
+    pub world_id: u32,
+    /// Bumped on a world change: Minecraft drops every collision region it holds.
+    pub collision_epoch: u32,
+    pub pos: [f64; 3],
+    /// Minecraft degrees: yaw 0 faces +Z, pitch positive looks down.
+    pub yaw: f32,
+    pub pitch: f32,
+    /// Minecraft teleports its player to `pos` when this changes, and acks it in `McState`.
+    pub teleport_seq: u32,
+    pub viewport_w: u32,
+    pub viewport_h: u32,
+    pub game_hour: f32,
+}
+
+pub const WATER_GRID_SIZE: usize = 16;
+pub const NO_WATER: f32 = -1.0e30;
+
+#[repr(C)]
+#[derive(Clone, Copy, bytemuck::Pod, bytemuck::Zeroable)]
+pub struct WaterGrid {
+    pub seq: u32,
+    pub origin_x: i32,
+    pub origin_z: i32,
+    pub world_id: u32,
+    /// `[z * 16 + x]`: the water surface's Minecraft y over that column, or [`NO_WATER`].
+    pub surface: [f32; WATER_GRID_SIZE * WATER_GRID_SIZE],
+}
+
+// ---- Minecraft -> game state (seqlock) ----------------------------------------------------------
+pub const MC_IN_WORLD: u32 = 1 << 0;
+pub const MC_SCREEN_OPEN: u32 = 1 << 1;
+pub const MC_ON_GROUND: u32 = 1 << 2;
+pub const MC_SNEAKING: u32 = 1 << 3;
+pub const MC_SPRINTING: u32 = 1 << 4;
+pub const MC_DEAD: u32 = 1 << 5;
+pub const MC_SWIMMING: u32 = 1 << 6;
+pub const MC_FLYING: u32 = 1 << 7;
+
+#[repr(C)]
+#[derive(Clone, Copy, Default, Debug, bytemuck::Pod, bytemuck::Zeroable)]
+pub struct McState {
+    pub seq: u32,
+    pub flags: u32,
+    /// Feet, interpolated to Minecraft's render frame.
+    pub pos: [f64; 3],
+    pub yaw: f32,
+    pub pitch: f32,
+    pub eye_height: f32,
+    pub sensitivity: f32,
+    pub teleport_ack: u32,
+    pub gui_scale: u32,
+    pub frame_counter: u64,
+    /// Vertical, sprint and fluid modifiers included.
+    pub fov_deg: f32,
+    pub bob_phase: f32,
+    pub bob_amount: f32,
+    pub pad4c: u32,
+    pub eye: [f64; 3],
+    /// The physics tick, on the shared clock (nanoseconds), for our own interpolation.
+    pub tick_qpc: i64,
+    pub prev: [f64; 3],
+    pub cur: [f64; 3],
+    pub tick_eye_o: f32,
+    pub tick_eye: f32,
+    pub walk_dist_o: f32,
+    pub walk_dist: f32,
+    pub bob_o: f32,
+    pub bob: f32,
+    pub tick_ms: f32,
+    pub tick_pad: u32,
+    /// 0 first person, 1 behind, 2 in front.
+    pub camera_mode: u32,
+    pub camera_distance: f32,
+    /// WowCraft: Minecraft's hearts, which are our life.
+    pub health: f32,
+    pub max_health: f32,
+    /// WowCraft: Minecraft's mouse sensitivity option (0..1), for our mouse look.
+    pub mouse_sensitivity: f32,
+    pub tail_pad: u32,
+}
+
+// ---- overlay triple buffer ----------------------------------------------------------------------
+pub const OC_STATE: usize = 0;
+pub const OVERLAY_DIRTY: u32 = 1 << 2;
+pub const SLOT_HDR_BYTES: usize = 0x40;
+
+#[repr(C)]
+#[derive(Clone, Copy, Default, Debug, bytemuck::Pod, bytemuck::Zeroable)]
+pub struct OverlaySlotHdr {
+    pub width: u32,
+    pub height: u32,
+    /// bit 0: rows are bottom-up.
+    pub flags: u32,
+    pub pad: u32,
+    pub frame_id: u64,
+}
+
+// ---- input ring (game produces) -----------------------------------------------------------------
+pub const INPUT_RING_ENTRIES: u64 = 4096;
+pub const RING_HEAD: usize = 0x00;
+pub const RING_TAIL: usize = 0x40;
+pub const RING_DATA: usize = 0x80;
+
+/// SDL scancode, `a` 1 press / 0 release.
+pub const IN_KEY: u16 = 1;
+/// SDL button (1 left, 2 middle, 3 right, 4 X1, 5 X2), `a` 1 press / 0 release.
+pub const IN_MOUSE_BUTTON: u16 = 2;
+/// `a` = notches × 120, positive up.
+pub const IN_SCROLL: u16 = 3;
+/// `a`, `b` = the cursor in overlay pixels.
+pub const IN_CURSOR: u16 = 4;
+/// `a` = a Unicode code point.
+pub const IN_TEXT: u16 = 5;
+pub const IN_RELEASE_ALL: u16 = 6;
+/// `code` = [`HURT_MELEE`]..., `a` = WoW damage × 100, `b` = the attacker, `c` = flags.
+pub const IN_HURT: u16 = 7;
+pub const IN_OPEN_MENU: u16 = 8;
+/// WowCraft: `code` = the gift table's index (0 experience), `a` = count, `b` = enchant level.
+pub const IN_GIVE: u16 = 9;
+/// WowCraft: `code` = item | count << 8, `a`, `b`, `c` = where, in eighths of a block.
+pub const IN_DROP: u16 = 10;
+/// WowCraft: `code` = the progression tier our level reached.
+pub const IN_TIER: u16 = 11;
+/// WowCraft: `a` | `b` << 32 = the character's guid, whose gear Minecraft keeps.
+pub const IN_CHARACTER: u16 = 12;
+
+pub const HURT_MELEE: u16 = 0;
+pub const HURT_PROJECTILE: u16 = 1;
+pub const HURT_MAGIC: u16 = 2;
+pub const HURT_OTHER: u16 = 3;
+
+#[repr(C)]
+#[derive(Clone, Copy, Default, Debug, PartialEq, bytemuck::Pod, bytemuck::Zeroable)]
+pub struct InputEvent {
+    pub kind: u16,
+    pub code: u16,
+    pub a: i32,
+    pub b: i32,
+    pub c: i32,
+}
+
+// ---- actor table (game -> Minecraft, seqlock) ---------------------------------------------------
+pub const MAX_ACTORS: usize = 256;
+pub const AT_RECORDS: usize = 0x40;
+pub const ACTOR_HOSTILE: u32 = 1 << 0;
+pub const ACTOR_DEAD: u32 = 1 << 1;
+pub const ACTOR_ESSENTIAL: u32 = 1 << 2;
+pub const ACTOR_IN_COMBAT: u32 = 1 << 3;
+/// WowCraft: a mining node; `level` is its ore kind.
+pub const ACTOR_ORE: u32 = 1 << 8;
+/// WowCraft: a vendor; Minecraft offers block trades on right-click.
+pub const ACTOR_TRADER: u32 = 1 << 9;
+/// WowCraft: friendly to us (a guard, a quest giver, a party member).
+pub const ACTOR_FRIENDLY: u32 = 1 << 10;
+
+#[repr(C)]
+#[derive(Clone, Copy, Default, Debug, PartialEq, bytemuck::Pod, bytemuck::Zeroable)]
+pub struct ActorRecord {
+    pub form_id: u32,
+    pub flags: u32,
+    pub pos: [f32; 3],
+    pub yaw: f32,
+    pub width: f32,
+    pub height: f32,
+    pub health_frac: f32,
+    pub level: u16,
+    pub pad: u16,
+    pub name: [u8; 24],
+}
+
+// ---- event ring (Minecraft produces) ------------------------------------------------------------
+pub const EVENT_RING_ENTRIES: u64 = 512;
+/// `form_id` hit for `a` Minecraft damage; `b`, `c` the knockback direction, `d` its strength.
+pub const EV_HIT_ACTOR: u32 = 1;
+pub const EV_PLAYER_DIED: u32 = 2;
+pub const EV_EXPLOSION: u32 = 3;
+pub const EV_ARROW_STUCK: u32 = 4;
+pub const EV_SKILL_USE: u32 = 5;
+/// WowCraft: the node `form_id` was mined out.
+pub const EV_ORE_MINED: u32 = 6;
+
+pub const HIT_CRITICAL: u32 = 1 << 0;
+pub const HIT_PROJECTILE: u32 = 1 << 1;
+
+#[repr(C)]
+#[derive(Clone, Copy, Default, Debug, PartialEq, bytemuck::Pod, bytemuck::Zeroable)]
+pub struct McEvent {
+    pub kind: u32,
+    pub form_id: u32,
+    pub a: f32,
+    pub b: f32,
+    pub c: f32,
+    pub d: f32,
+    pub flags: u32,
+    pub weapon: u32,
+}
+
+// ---- world entities (Minecraft -> game, seqlock) ------------------------------------------------
+pub const MAX_WORLD_ENTITIES: usize = 160;
+pub const WE_RECORDS: usize = 0x40;
+pub const WE_ARROW: u32 = 1;
+pub const WE_ITEM: u32 = 2;
+pub const WE_TRIDENT: u32 = 3;
+pub const WE_BLOCK: u32 = 4;
+pub const WE_CRACK: u32 = 5;
+pub const WE_SHADOW: u32 = 6;
+/// WowCraft: a co-op partner's Minecraft body.
+pub const WE_PLAYER: u32 = 7;
+/// WowCraft: a line (a fishing line, a lead).
+pub const WE_LINE: u32 = 8;
+
+#[repr(C)]
+#[derive(Clone, Copy, Default, Debug, PartialEq, bytemuck::Pod, bytemuck::Zeroable)]
+pub struct WorldEntity {
+    pub kind: u32,
+    pub id: u32,
+    pub pos: [f32; 3],
+    pub yaw: f32,
+    pub pitch: f32,
+    pub scale: f32,
+    pub ext: [f32; 3],
+    pub uv: [[f32; 4]; 3],
+    pub tint: u32,
+}
+
+#[repr(C)]
+#[derive(Clone, Copy, Default, Debug, PartialEq, bytemuck::Pod, bytemuck::Zeroable)]
+pub struct WorldEntitiesHeader {
+    pub seq: u32,
+    pub count: u32,
+    pub has_selection: u32,
+    pub sel_min: [f32; 3],
+    pub sel_max: [f32; 3],
+    pub pad: [u32; 7],
+}
+
+// ---- render ring (Minecraft produces) -----------------------------------------------------------
+pub const REN_PAD: u32 = 0;
+/// [`RenAtlas`] + RGBA8, top row first.
+pub const REN_ATLAS: u32 = 1;
+/// [`RenSection`] + [`RenVertex`]s (a triangle list); none: the section goes.
+pub const REN_SECTION: u32 = 2;
+pub const REN_CLEAR_ALL: u32 = 3;
+/// [`RenTexture`] + RGBA8: an entity texture (a skin, armour).
+pub const REN_TEXTURE: u32 = 4;
+/// `{batches, vertices}` + [`RenBatch`]es + [`RenVertex`]es: our body this frame, from the feet.
+pub const REN_AVATAR: u32 = 5;
+/// [`RenScene`] + batches + vertices: every other entity and particle, from the scene's origin.
+pub const REN_SCENE: u32 = 6;
