diff --git a/crates/benilla-app/src/wowcraft/input.rs b/crates/benilla-app/src/wowcraft/input.rs
new file mode 100644
index 00000000..109d8e82
--- /dev/null
+++ b/crates/benilla-app/src/wowcraft/input.rs
@@ -0,0 +1,334 @@
+//! Minecraft's controls inside WoW. While Minecraft owns input ([`super::InputOwner`]) every key
+//! but WoW's own goes to Minecraft as its SDL scancode, the mouse buttons and wheel go too, and the
+//! mouse turns our view, as Minecraft's own mouse would: the look is ours (zero latency for the
+//! camera) and Minecraft is told it in `SkyState`. With one of Minecraft's screens open (its
+//! inventory, chat, a chest) the cursor is shown and its position goes instead, in the overlay's
+//! pixels.
+//!
+//! WoW keeps C (its cursor, for NPCs, loot and quests), Enter (its chat), M (the map), L (the
+//! quest log), B (the bags) and O (its menu). Esc is Minecraft's menu.
+
+use bevy::input::keyboard::{Key, KeyboardInput};
+use bevy::input::mouse::{AccumulatedMouseMotion, AccumulatedMouseScroll};
+use bevy::input::ButtonState;
+use bevy::prelude::*;
+use bevy::window::{CursorGrabMode, CursorOptions, PrimaryWindow};
+
+use wowcraft_link::proto::*;
+
+use super::{InputOwner, WowCraft};
+use crate::char_select::ClientState;
+
+/// The keys WoW keeps while Minecraft has the rest.
+pub(crate) fn is_wow_key(key: KeyCode) -> bool {
+    matches!(
+        key,
+        KeyCode::KeyC | KeyCode::Enter | KeyCode::NumpadEnter | KeyCode::KeyM | KeyCode::KeyL | KeyCode::KeyB | KeyCode::KeyO
+    )
+}
+
+/// What Minecraft has been told is down, so a hand-over to WoW lets go of exactly that.
+#[derive(Default)]
+pub(crate) struct Held {
+    keys: Vec<u16>,
+    buttons: Vec<u16>,
+    cursor: Option<(i32, i32)>,
+    owned: bool,
+    notches: f32,
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn forward_input(
+    mut wc: ResMut<WowCraft>,
+    owner: Res<InputOwner>,
+    state: Res<State<ClientState>>,
+    capture: Res<crate::ui_script::UiKeyboardCapture>,
+    mut keyboard: MessageReader<KeyboardInput>,
+    buttons: Res<ButtonInput<MouseButton>>,
+    motion: Res<AccumulatedMouseMotion>,
+    scroll: Res<AccumulatedMouseScroll>,
+    window: Query<&Window, With<PrimaryWindow>>,
+    mut held: Local<Held>,
+) {
+    let events: Vec<KeyboardInput> = keyboard.read().cloned().collect();
+    // C toggles WoW's cursor while in the world with Minecraft there, typing aside.
+    let in_world = *state.get() == ClientState::InWorld;
+    if in_world && wc.mc_in_world() && !capture.typing && !wc.mc_screen_open() {
+        for ev in &events {
+            if ev.state == ButtonState::Pressed && !ev.repeat && ev.key_code == KeyCode::KeyC {
+                wc.cursor_mode = !wc.cursor_mode;
+                info!("wowcraft: WoW cursor {}", if wc.cursor_mode { "on" } else { "off" });
+            }
+        }
+    }
+    if !owner.minecraft {
+        if held.owned {
+            // WoW took over (its cursor, its chat): Minecraft lets go of everything it holds.
+            wc.link.push_input(IN_RELEASE_ALL, 0, 0, 0, 0);
+            held.keys.clear();
+            held.buttons.clear();
+            held.cursor = None;
+            held.owned = false;
+        }
+        return;
+    }
+    held.owned = true;
+    let screen = wc.mc_screen_open();
+
+    for ev in &events {
+        // A Minecraft screen takes every key, WoW's too (typing in its chat or a sign).
+        if !screen && is_wow_key(ev.key_code) {
+            continue;
+        }
+        let Some(code) = sdl_scancode(ev.key_code) else {
+            continue;
+        };
+        match ev.state {
+            ButtonState::Pressed => {
+                // A repeat is a press Minecraft sees as one (its text fields repeat on it).
+                wc.link.push_input(IN_KEY, code, 1, 0, 0);
+                if !held.keys.contains(&code) {
+                    held.keys.push(code);
+                }
+                if screen {
+                    if let Some(text) = typed_text(ev) {
+                        for ch in text.chars().filter(|c| !c.is_control()) {
+                            wc.link.push_input(IN_TEXT, 0, ch as i32, 0, 0);
+                        }
+                    }
+                }
+            }
+            ButtonState::Released => {
+                wc.link.push_input(IN_KEY, code, 0, 0, 0);
+                held.keys.retain(|&k| k != code);
+            }
+        }
+    }
+
+    for (button, code) in [
+        (MouseButton::Left, 1u16),
+        (MouseButton::Middle, 2),
+        (MouseButton::Right, 3),
+        (MouseButton::Back, 4),
+        (MouseButton::Forward, 5),
+    ] {
+        if buttons.just_pressed(button) {
+            wc.link.push_input(IN_MOUSE_BUTTON, code, 1, 0, 0);
+            held.buttons.push(code);
+        }
+        if buttons.just_released(button) {
+            wc.link.push_input(IN_MOUSE_BUTTON, code, 0, 0, 0);
+            held.buttons.retain(|&b| b != code);
+        }
+    }
+
+    // The wheel in whole notches (a trackpad's fractions carry), 120 a notch as Windows counts.
+    let lines = crate::bindings::wheel_lines(scroll.unit, scroll.delta.y);
+    if lines != 0.0 {
+        held.notches += lines;
+        let whole = held.notches.trunc();
+        if whole != 0.0 {
+            held.notches -= whole;
+            wc.link.push_input(IN_SCROLL, 0, (whole * 120.0) as i32, 0, 0);
+        }
+    }
+
+    if screen {
+        // The cursor, in the overlay's (physical) pixels, when it moves.
+        if let Ok(w) = window.single() {
+            if let Some(p) = w.physical_cursor_position() {
+                let at = (p.x as i32, p.y as i32);
+                if held.cursor != Some(at) {
+                    wc.link.push_input(IN_CURSOR, 0, at.0, at.1, 0);
+                    held.cursor = Some(at);
+                }
+            }
+        }
+    } else {
+        held.cursor = None;
+        let d = motion.delta;
+        if d != Vec2::ZERO {
+            let sensitivity = wc.mc.map_or(0.5, |m| m.mouse_sensitivity);
+            let (dyaw, dpitch) = look_delta(sensitivity, d);
+            wc.look_yaw = super::wrap_degrees(wc.look_yaw + dyaw);
+            wc.look_pitch = (wc.look_pitch + dpitch).clamp(-90.0, 90.0);
+        }
+    }
+}
+
+/// Minecraft's mouse turn (`MouseHandler.turnPlayer`, `Entity.turn`): degrees of yaw and pitch for
+/// a mouse move, at its sensitivity option.
+pub(crate) fn look_delta(sensitivity: f32, delta: Vec2) -> (f32, f32) {
+    let s = sensitivity.clamp(0.0, 1.0) as f64 * 0.6 + 0.2;
+    let per = s * s * s * 8.0 * 0.15;
+    ((delta.x as f64 * per) as f32, (delta.y as f64 * per) as f32)
+}
+
+/// What a press typed, for Minecraft's text fields.
+fn typed_text(ev: &KeyboardInput) -> Option<String> {
+    if let Some(text) = &ev.text {
+        return Some(text.to_string());
+    }
+    match &ev.logical_key {
+        Key::Character(c) => Some(c.to_string()),
+        Key::Space => Some(" ".into()),
+        _ => None,
+    }
+}
+
+/// Minecraft wants the mouse hidden and held while it has it, and shown for its screens; WoW's own
+/// handling comes back when WoW has the input.
+pub(crate) fn hold_cursor(
+    wc: Res<WowCraft>,
+    owner: Res<InputOwner>,
+    mut cursor: Query<&mut CursorOptions, With<PrimaryWindow>>,
+    mut ours: Local<bool>,
+) {
+    let Ok(mut opts) = cursor.single_mut() else {
+        return;
+    };
+    let want_hidden = owner.minecraft && !wc.mc_screen_open();
+    if want_hidden {
+        if opts.visible || opts.grab_mode != CursorGrabMode::Locked {
+            opts.visible = false;
+            opts.grab_mode = CursorGrabMode::Locked;
+        }
+        *ours = true;
+    } else if *ours {
+        // Handed back: shown and free, as WoW's cursor code expects to find it.
+        opts.visible = true;
+        opts.grab_mode = CursorGrabMode::None;
+        *ours = false;
+    }
+}
+
+/// A key's SDL scancode (the USB HID usage), which Minecraft 26's SDL input reads.
+pub(crate) fn sdl_scancode(key: KeyCode) -> Option<u16> {
+    use KeyCode::*;
+    let letter = |k: KeyCode| -> Option<u16> {
+        let order = [
+            KeyA, KeyB, KeyC, KeyD, KeyE, KeyF, KeyG, KeyH, KeyI, KeyJ, KeyK, KeyL, KeyM, KeyN, KeyO, KeyP, KeyQ, KeyR, KeyS,
+            KeyT, KeyU, KeyV, KeyW, KeyX, KeyY, KeyZ,
+        ];
+        order.iter().position(|&o| o == k).map(|i| 4 + i as u16)
+    };
+    if let Some(code) = letter(key) {
+        return Some(code);
+    }
+    Some(match key {
+        Digit1 => 30,
+        Digit2 => 31,
+        Digit3 => 32,
+        Digit4 => 33,
+        Digit5 => 34,
+        Digit6 => 35,
+        Digit7 => 36,
+        Digit8 => 37,
+        Digit9 => 38,
+        Digit0 => 39,
+        Enter => 40,
+        Escape => 41,
+        Backspace => 42,
+        Tab => 43,
+        Space => 44,
+        Minus => 45,
+        Equal => 46,
+        BracketLeft => 47,
+        BracketRight => 48,
+        Backslash => 49,
+        Semicolon => 51,
+        Quote => 52,
+        Backquote => 53,
+        Comma => 54,
+        Period => 55,
+        Slash => 56,
+        CapsLock => 57,
+        F1 => 58,
+        F2 => 59,
+        F3 => 60,
+        F4 => 61,
+        F5 => 62,
+        F6 => 63,
+        F7 => 64,
+        F8 => 65,
+        F9 => 66,
+        F10 => 67,
+        F11 => 68,
+        F12 => 69,
+        PrintScreen => 70,
+        ScrollLock => 71,
+        Pause => 72,
+        Insert => 73,
+        Home => 74,
+        PageUp => 75,
+        Delete => 76,
+        End => 77,
+        PageDown => 78,
+        ArrowRight => 79,
+        ArrowLeft => 80,
+        ArrowDown => 81,
+        ArrowUp => 82,
+        NumLock => 83,
+        NumpadDivide => 84,
+        NumpadMultiply => 85,
+        NumpadSubtract => 86,
+        NumpadAdd => 87,
+        NumpadEnter => 88,
+        Numpad1 => 89,
+        Numpad2 => 90,
+        Numpad3 => 91,
+        Numpad4 => 92,
+        Numpad5 => 93,
+        Numpad6 => 94,
+        Numpad7 => 95,
+        Numpad8 => 96,
+        Numpad9 => 97,
+        Numpad0 => 98,
+        NumpadDecimal => 99,
+        IntlBackslash => 100,
+        ContextMenu => 101,
+        ControlLeft => 224,
+        ShiftLeft => 225,
+        AltLeft => 226,
+        SuperLeft => 227,
+        ControlRight => 228,
+        ShiftRight => 229,
+        AltRight => 230,
+        SuperRight => 231,
+        _ => return None,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn keys_are_sdl_scancodes() {
+        assert_eq!(sdl_scancode(KeyCode::KeyW), Some(26));
+        assert_eq!(sdl_scancode(KeyCode::KeyA), Some(4));
+        assert_eq!(sdl_scancode(KeyCode::KeyZ), Some(29));
+        assert_eq!(sdl_scancode(KeyCode::Space), Some(44));
+        assert_eq!(sdl_scancode(KeyCode::ShiftLeft), Some(225));
+        assert_eq!(sdl_scancode(KeyCode::Escape), Some(41));
+        assert_eq!(sdl_scancode(KeyCode::Digit1), Some(30));
+    }
+
+    #[test]
+    fn wow_keeps_its_own_keys() {
+        for k in [KeyCode::KeyC, KeyCode::Enter, KeyCode::KeyM, KeyCode::KeyL, KeyCode::KeyB, KeyCode::KeyO] {
+            assert!(is_wow_key(k));
+        }
+        for k in [KeyCode::KeyW, KeyCode::KeyE, KeyCode::KeyT, KeyCode::Escape, KeyCode::Space] {
+            assert!(!is_wow_key(k));
+        }
+    }
+
+    /// Minecraft's default sensitivity (0.5) turns 0.6^3 · 8 · 0.15 = 0.2592° a count.
+    #[test]
+    fn the_mouse_turns_as_minecrafts_does() {
+        let (yaw, pitch) = look_delta(0.5, Vec2::new(100.0, -10.0));
+        assert!((yaw - 25.92).abs() < 1e-3, "{yaw}");
+        assert!((pitch + 2.592).abs() < 1e-3, "{pitch}");
+    }
+}
