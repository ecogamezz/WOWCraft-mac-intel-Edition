diff --git a/crates/wowcraft-link/examples/fake_game.rs b/crates/wowcraft-link/examples/fake_game.rs
new file mode 100644
index 00000000..2f7f5732
--- /dev/null
+++ b/crates/wowcraft-link/examples/fake_game.rs
@@ -0,0 +1,50 @@
+//! The game's side alone, for checking the Minecraft mod against it: makes the real link, then
+//! for `secs` seconds beats, publishes a SkyState each frame (60 a second) and prints what
+//! Minecraft reports back. `cargo run -p wowcraft-link --example fake_game -- 10`.
+
+use std::time::{Duration, Instant};
+
+use wowcraft_link::proto::*;
+use wowcraft_link::Link;
+
+fn main() {
+    let secs: u64 = std::env::args().nth(1).and_then(|s| s.parse().ok()).unwrap_or(10);
+    let link = Link::create().expect("create the link");
+    println!("fake game: link up as pid {}", std::process::id());
+    let start = Instant::now();
+    let mut frame = 0u32;
+    let mut seen_mc = false;
+    while start.elapsed() < Duration::from_secs(secs) {
+        frame += 1;
+        link.heartbeat();
+        let state = SkyState {
+            flags: SKY_IN_GAME,
+            world_id: 1,
+            pos: [-8949.95, 82.1, 132.5],
+            yaw: (frame % 360) as f32,
+            teleport_seq: 1,
+            viewport_w: 1280,
+            viewport_h: 800,
+            game_hour: 12.0,
+            ..Default::default()
+        };
+        link.write_sky_state(&state);
+        if frame % 60 == 0 {
+            link.push_input(IN_KEY, 26, 1, 0, 0);
+        }
+        if let Some(mc) = link.read_mc_state().filter(|_| link.mc_alive()) {
+            if !seen_mc {
+                println!("fake game: Minecraft pid {} is alive", link.mc_pid());
+                seen_mc = true;
+            }
+            if frame % 60 == 0 {
+                println!("fake game: Minecraft at {:?} yaw {} health {}/{} flags {:#x}", mc.pos, mc.yaw, mc.health, mc.max_health, mc.flags);
+            }
+        }
+        while let Some(e) = link.pop_event() {
+            println!("fake game: event {} on {} ({})", e.kind, e.form_id, e.a);
+        }
+        std::thread::sleep(Duration::from_millis(16));
+    }
+    println!("fake game: {frame} frames, Minecraft seen: {seen_mc}");
+}
