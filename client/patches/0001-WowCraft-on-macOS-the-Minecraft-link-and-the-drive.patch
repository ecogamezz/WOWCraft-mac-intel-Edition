diff --git a/crates/benilla-app/src/player/puppet.rs b/crates/benilla-app/src/player/puppet.rs
new file mode 100644
index 00000000..e1b98ac5
--- /dev/null
+++ b/crates/benilla-app/src/player/puppet.rs
@@ -0,0 +1,116 @@
+//! WowCraft's drive: Minecraft's physics move our body. [`crate::wowcraft`] puts Minecraft's
+//! player, on our clock, in [`crate::wowcraft::Drive`]; here, in place of the input step, the body
+//! stands where that player stands and faces where we look, and everything after the input step
+//! runs as ever: the wire flags and their edges, the gait, the body's pose and the stream to the
+//! server. The camera is Minecraft's: at its eye in first person, behind or in front of it in its
+//! two third-person views, looking our way.
+
+use super::*;
+
+/// Slower than this (yd/s) along an axis is standing on it: Minecraft's own slide after a step.
+const MOVE_EPS: f32 = 0.6;
+/// Rising faster than this (yd/s) off the ground is a jump, not a step up.
+const JUMP_VY: f32 = 1.5;
+
+#[allow(clippy::too_many_arguments)]
+pub(super) fn step(
+    drive: &crate::wowcraft::Drive,
+    time: &Time,
+    player: &mut Player,
+    body: &mut BodyQuery,
+    hard_landing: &mut MessageWriter<crate::creature_anim::HardLanding>,
+    cam: &mut FlyCam,
+    cam_t: &mut Mut<Transform>,
+    sender: &crossbeam_channel::Sender<ClientCommand>,
+    speed_acks: &[crate::net::SpeedChangeMessage],
+    self_guid: Option<u64>,
+) {
+    let dt = time.delta_secs().max(1.0e-4);
+    let now = time.elapsed_secs();
+    let launch_y = player.pos.y;
+    let velocity = (drive.feet - player.pos) / dt;
+    player.pos = drive.feet;
+    player.face_yaw = drive.yaw;
+
+    // The axes Minecraft walked this frame, relative to where we face.
+    let face_rot = Quat::from_rotation_y(drive.yaw);
+    let forward = face_rot * Vec3::NEG_Z;
+    let right = face_rot * Vec3::X;
+    let flat = Vec3::new(velocity.x, 0.0, velocity.z);
+    let along = |axis: Vec3| {
+        let v = flat.dot(axis);
+        if v > MOVE_EPS {
+            1
+        } else if v < -MOVE_EPS {
+            -1
+        } else {
+            0
+        }
+    };
+    let (fwd, side) = (along(forward), along(right));
+    let swimming = drive.swimming;
+    player.swimming = swimming;
+    // Sneaking walks; a sprint is our run.
+    player.walking = drive.sneaking;
+    let airborne = !drive.on_ground && !swimming && !drive.flying;
+    let jumped = airborne && player.airborne_since.is_none() && velocity.y > JUMP_VY;
+    let axes = input::MoveAxes {
+        fwd,
+        side,
+        // The body faces the view, as with mouselook held: strafe is strafe, not a turn.
+        mouselook: true,
+        turning: false,
+        translating: fwd != 0 || side != 0,
+        autorun_armed: false,
+        strafe_left: side < 0,
+        strafe_right: side > 0,
+        turn_left: false,
+        turn_right: false,
+    };
+    let swim = swimming.then_some((fwd as f32, side as f32));
+    let frame = flags::this_frame(player, &axes, swim, airborne, jumped, false, false, true, true, now, launch_y);
+    let anim = gait::drive_body_heading(player, frame.pose, dt, swimming, axes.translating, airborne, true, TURN_RATE);
+    let _ = body_pose::drive(player, body, hard_landing, swimming, 0.0, frame.wire, anim, frame.landed, 0);
+
+    // Minecraft's camera, looking our way.
+    cam.yaw = drive.yaw;
+    cam.pitch = drive.pitch;
+    let look = Quat::from_euler(EulerRot::YXZ, drive.yaw, drive.pitch, 0.0);
+    let ahead = look * Vec3::NEG_Z;
+    let (at, rotation) = match drive.camera_mode {
+        1 => (drive.eye - ahead * drive.camera_distance, look),
+        2 => (
+            drive.eye + ahead * drive.camera_distance,
+            Quat::from_euler(EulerRot::YXZ, drive.yaw + std::f32::consts::PI, -drive.pitch, 0.0),
+        ),
+        _ => (drive.eye, look),
+    };
+    cam_t.translation = at;
+    cam_t.rotation = rotation;
+
+    // The stream to the server: a `MSG_MOVE_*` per axis edge, the jump and landing, heartbeats.
+    let transport = movement_net::wire_transport(player);
+    let skip = movement_net::SkipClock {
+        dt,
+        held: player.settling,
+        mover: player.foreign_mover.or(self_guid),
+    };
+    movement_net::stream_self_movement(
+        sender,
+        player,
+        frame.wire,
+        0.0,
+        movement_net::ArcEdges {
+            jumped,
+            wire_launch: false,
+            air_nudged: false,
+            landed: frame.landed,
+            fall_time: frame.fall_time,
+        },
+        now,
+        speed_acks,
+        None,
+        transport,
+        skip,
+    );
+}
