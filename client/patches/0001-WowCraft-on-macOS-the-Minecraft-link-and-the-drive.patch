+
+    /// The layout the mod's `Proto` names, offset by offset.
+    #[test]
+    fn the_layout_is_the_mods() {
+        assert_eq!(std::mem::size_of::<SkyState>(), 0x40);
+        assert_eq!(std::mem::size_of::<McState>(), 0xD8);
+        assert_eq!(std::mem::offset_of!(McState, eye), 80);
+        assert_eq!(std::mem::offset_of!(McState, tick_qpc), 104);
+        assert_eq!(std::mem::offset_of!(McState, prev), 112);
+        assert_eq!(std::mem::offset_of!(McState, cur), 136);
+        assert_eq!(std::mem::offset_of!(McState, tick_eye_o), 160);
+        assert_eq!(std::mem::offset_of!(McState, tick_ms), 184);
+        assert_eq!(std::mem::offset_of!(McState, camera_mode), 192);
+        assert_eq!(std::mem::offset_of!(McState, health), 200);
+        assert_eq!(std::mem::offset_of!(McState, mouse_sensitivity), 208);
+        assert_eq!(std::mem::size_of::<WaterGrid>(), 16 + 4 * 256);
+        assert_eq!(std::mem::size_of::<ActorRecord>(), 64);
+        assert_eq!(std::mem::offset_of!(ActorRecord, level), 36);
+        assert_eq!(std::mem::offset_of!(ActorRecord, name), 40);
+        assert_eq!(std::mem::size_of::<McEvent>(), 32);
+        assert_eq!(std::mem::size_of::<WorldEntity>(), 96);
+        assert_eq!(std::mem::size_of::<WorldEntitiesHeader>(), WE_RECORDS);
+        assert_eq!(std::mem::size_of::<InputEvent>(), 16);
+        assert_eq!(std::mem::size_of::<RenVertex>(), 32);
+        assert_eq!(std::mem::size_of::<ColTri>(), 40);
+        assert_eq!(std::mem::size_of::<ColRegion>(), 32);
+        assert_eq!(std::mem::size_of::<ColBlock>(), 80);
+        assert_eq!(OFF_OVERLAY_PIXELS, 33_685_504);
+        assert_eq!(OFF_RENDER_RING, 133_218_304);
+        assert_eq!(MAPPING_BYTES, 200_327_168);
+        assert!(OFF_WORLD_ENTITIES + WE_RECORDS + 96 * MAX_WORLD_ENTITIES <= OFF_COLLISION_RING);
+    }
+}
