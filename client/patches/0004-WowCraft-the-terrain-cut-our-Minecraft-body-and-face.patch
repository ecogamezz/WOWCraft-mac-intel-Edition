diff --git a/crates/benilla-app/src/wowcraft/cut.rs b/crates/benilla-app/src/wowcraft/cut.rs
new file mode 100644
index 00000000..7c1e7ce4
--- /dev/null
+++ b/crates/benilla-app/src/wowcraft/cut.rs
@@ -0,0 +1,270 @@
+//! WoW's land where Minecraft's blocks are. The mod sends, per 16-block section, which cells a
+//! full, opaque block fills (`REN_CUT`), which were dug out of WoW's ground (`REN_DUG`, for one
+//! world) and which hold anything with a collision shape (`REN_SOLIDS`). The first two are the
+//! terrain cut: [`benilla_world::terrain_cut`]'s volume round us, which `terrain.wgsl` drops the
+//! ground in, so a block set into a hillside shows its faces and a dug hole shows the walls the
+//! mod meshes with its section. The solids are what Minecraft's entity shadows fall on.
+
+use std::collections::HashMap;
+
+use bevy::prelude::*;
+use benilla_world::terrain_cut::{TerrainCut, CUT_D, CUT_H, CUT_W};
+
+use wowcraft_link::proto::*;
+
+use super::WowCraft;
+
+/// A section's cells, bit `x + 16 z + 256 y`.
+pub(crate) type Bits = [u64; 64];
+
+pub(crate) fn plugin(app: &mut App) {
+    app.init_resource::<Cells>().add_systems(
+        Update,
+        fill_terrain_cut.after(super::blocks::BlocksSet).after(crate::player::PlayerControlSet),
+    );
+}
+
+/// Minecraft's cells in WoW's world, by section.
+#[derive(Resource, Default)]
+pub(crate) struct Cells {
+    /// Cells a full, opaque block fills.
+    filled: HashMap<IVec3, Bits>,
+    /// Cells dug out of WoW's ground, with the world (map id + 1) they were dug in.
+    dug: HashMap<IVec3, (u32, Bits)>,
+    /// Cells with anything that collides.
+    solids: HashMap<IVec3, Bits>,
+    /// Bumped on every change to `filled` or `dug`, so the volume refills.
+    revision: u64,
+}
+
+/// A section's bitset from a message body: 512 bytes when `count` > 0, else none (the section has
+/// none left).
+fn bits_of(count: u32, body: &[u8]) -> Option<Bits> {
+    if count == 0 || body.len() < CELL_BITS_BYTES {
+        return None;
+    }
+    let mut bits = [0u64; 64];
+    for (word, chunk) in bits.iter_mut().zip(body.chunks_exact(8)) {
+        *word = u64::from_le_bytes(chunk.try_into().unwrap_or_default());
+    }
+    Some(bits)
+}
+
+/// A section's set cells, in world cells.
+fn cells_of(section: IVec3, bits: &Bits) -> impl Iterator<Item = IVec3> + '_ {
+    let origin = section * 16;
+    bits.iter().enumerate().flat_map(move |(w, &word)| {
+        (0..64).filter(move |b| word >> b & 1 == 1).map(move |b| {
+            let i = (w * 64 + b) as i32;
+            origin + IVec3::new(i & 15, i >> 8, (i >> 4) & 15)
+        })
+    })
+}
+
+fn has(bits: &Bits, local: IVec3) -> bool {
+    let i = (local.x + 16 * local.z + 256 * local.y) as usize;
+    bits[i >> 6] >> (i & 63) & 1 == 1
+}
+
+fn section_of(cell: IVec3) -> IVec3 {
+    cell.div_euclid(IVec3::splat(16))
+}
+
+impl Cells {
+    /// Minecraft resends everything (a new world, a new atlas): drop what we hold.
+    pub(crate) fn clear(&mut self) {
+        self.filled.clear();
+        self.dug.clear();
+        self.solids.clear();
+        self.revision += 1;
+    }
+
+    /// `REN_CUT`: the section's filled cells.
+    pub(crate) fn on_cut(&mut self, payload: &[u8]) {
+        let Some((h, body)) = split::<RenCells>(payload) else { return };
+        let key = IVec3::new(h.sx, h.sy, h.sz);
+        let changed = match bits_of(h.count, body) {
+            Some(bits) => self.filled.insert(key, bits) != Some(bits),
+            None => self.filled.remove(&key).is_some(),
+        };
+        if changed {
+            self.revision += 1;
+        }
+    }
+
+    /// `REN_DUG`: the section's dug cells, in the world the header names.
+    pub(crate) fn on_dug(&mut self, payload: &[u8]) {
+        let Some((h, body)) = split::<RenDug>(payload) else { return };
+        let key = IVec3::new(h.sx, h.sy, h.sz);
+        let changed = match bits_of(h.count, body) {
+            Some(bits) => self.dug.insert(key, (h.world_id, bits)) != Some((h.world_id, bits)),
+            None => self.dug.remove(&key).is_some(),
+        };
+        if changed {
+            self.revision += 1;
+        }
+    }
+
+    /// `REN_SOLIDS`: the section's cells with a collision shape.
+    pub(crate) fn on_solids(&mut self, payload: &[u8]) {
+        let Some((h, body)) = split::<RenCells>(payload) else { return };
+        let key = IVec3::new(h.sx, h.sy, h.sz);
+        match bits_of(h.count, body) {
+            Some(bits) => {
+                self.solids.insert(key, bits);
+            }
+            None => {
+                self.solids.remove(&key);
+            }
+        }
+    }
+
+    /// Whether a block that collides stands in this world cell.
+    pub(crate) fn solid(&self, cell: IVec3) -> bool {
+        let s = section_of(cell);
+        self.solids.get(&s).is_some_and(|bits| has(bits, cell - s * 16))
+    }
+
+    /// Whether the terrain is cut in this world cell (filled, or dug in `world`).
+    pub(crate) fn cut(&self, cell: IVec3, world: u32) -> bool {
+        let s = section_of(cell);
+        let local = cell - s * 16;
+        self.filled.get(&s).is_some_and(|bits| has(bits, local))
+            || self.dug.get(&s).is_some_and(|(w, bits)| *w == world && has(bits, local))
+    }
+
+    /// The top of the highest block that collides at or under `p`, at most `reach` cells down.
+    pub(crate) fn block_top_under(&self, p: Vec3, reach: i32) -> Option<f32> {
+        let cell = p.floor().as_ivec3();
+        (0..=reach).map(|d| cell - IVec3::Y * d).find(|&c| self.solid(c)).map(|c| (c.y + 1) as f32)
+    }
+
+    /// Every cut cell in `world` inside the box `[lo, lo + size)`, into `out`; how many landed.
+    fn fill(&self, cut: &mut TerrainCut, world: u32) -> usize {
+        let lo = cut.origin();
+        let hi = lo + IVec3::new(CUT_W, CUT_H, CUT_D) - IVec3::ONE;
+        let (slo, shi) = (section_of(lo), section_of(hi));
+        let near = |s: &IVec3| s.cmpge(slo).all() && s.cmple(shi).all();
+        let mut n = 0;
+        for (s, bits) in self.filled.iter().filter(|(s, _)| near(s)) {
+            n += cells_of(*s, bits).filter(|&c| cut.cut(c)).count();
+        }
+        for (s, (_, bits)) in self.dug.iter().filter(|(s, (w, _))| *w == world && near(s)) {
+            n += cells_of(*s, bits).filter(|&c| cut.cut(c)).count();
+        }
+        n
+    }
+}
+
+/// The volume's lowest corner for us at `pos`: our section's middle, the volume centred on it, so
+/// we stay at least 24 cells from a face and it moves only when we cross a section.
+fn volume_origin(pos: Vec3) -> IVec3 {
+    let middle = section_of(pos.floor().as_ivec3()) * 16 + IVec3::splat(8);
+    middle - IVec3::new(CUT_W / 2, CUT_H / 2, CUT_D / 2)
+}
+
+/// Refill the terrain cut round us when the cells change, we cross a section or the world changes.
+fn fill_terrain_cut(
+    wc: Res<WowCraft>,
+    cells: Res<Cells>,
+    player: Res<crate::player::Player>,
+    mut cut: ResMut<TerrainCut>,
+    mut filled: Local<Option<(u64, IVec3, u32)>>,
+    mut said: Local<usize>,
+) {
+    let origin = volume_origin(player.pos);
+    let world = wc.world_id();
+    let key = (cells.revision, origin, world);
+    if *filled == Some(key) {
+        return;
+    }
+    *filled = Some(key);
+    cut.reset(origin, true);
+    let n = cells.fill(&mut cut, world);
+    if n == 0 {
+        // Nothing to cut: the shader's test stays off.
+        cut.reset(origin, false);
+    }
+    if n != *said {
+        info!("wowcraft: terrain cut for {n} cells around {:?}", origin + IVec3::new(CUT_W / 2, CUT_H / 2, CUT_D / 2));
+        *said = n;
+    }
+}
+
+/// A message's fixed header and what follows it.
+fn split<T: bytemuck::Pod>(payload: &[u8]) -> Option<(T, &[u8])> {
+    let n = std::mem::size_of::<T>();
+    (payload.len() >= n).then(|| (bytemuck::pod_read_unaligned(&payload[..n]), &payload[n..]))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// A message as the mod writes it: the header, then the bits when there are any.
+    fn message(header: &[i32], cells: &[IVec3]) -> Vec<u8> {
+        let mut out: Vec<u8> = header.iter().flat_map(|v| v.to_le_bytes()).collect();
+        if !cells.is_empty() {
+            let mut bits = [0u64; 64];
+            for c in cells {
+                let i = (c.x + 16 * c.z + 256 * c.y) as usize;
+                bits[i >> 6] |= 1 << (i & 63);
+            }
+            out.extend(bits.iter().flat_map(|w| w.to_le_bytes()));
+        }
+        out
+    }
+
+    #[test]
+    fn filled_and_dug_cells_cut_the_terrain() {
+        let mut cells = Cells::default();
+        // Section (-1, 4, 2): local (15, 0, 3) is world (-1, 64, 35).
+        cells.on_cut(&message(&[-1, 4, 2, 1], &[IVec3::new(15, 0, 3)]));
+        // A hole dug in world 1 at section (0, 3, 2), local (2, 15, 0): world (2, 63, 32).
+        cells.on_dug(&message(&[0, 3, 2, 1, 1, 0], &[IVec3::new(2, 15, 0)]));
+        assert!(cells.cut(IVec3::new(-1, 64, 35), 1));
+        assert!(cells.cut(IVec3::new(2, 63, 32), 1));
+        assert!(!cells.cut(IVec3::new(2, 63, 32), 2), "dug in another world");
+        assert!(!cells.cut(IVec3::new(0, 64, 35), 1));
+
+        let mut cut = TerrainCut::default();
+        cut.reset(volume_origin(Vec3::new(0.5, 64.2, 33.0)), true);
+        assert_eq!(cells.fill(&mut cut, 1), 2);
+        assert!(cut.is_cut(IVec3::new(-1, 64, 35)) && cut.is_cut(IVec3::new(2, 63, 32)));
+
+        // An empty message takes the section's cells away.
+        let rev = cells.revision;
+        cells.on_dug(&message(&[0, 3, 2, 0, 1, 0], &[]));
+        assert!(!cells.cut(IVec3::new(2, 63, 32), 1));
+        assert!(cells.revision > rev);
+        // The same bits again change nothing.
+        let rev = cells.revision;
+        cells.on_cut(&message(&[-1, 4, 2, 1], &[IVec3::new(15, 0, 3)]));
+        assert_eq!(cells.revision, rev);
+        cells.clear();
+        assert!(!cells.cut(IVec3::new(-1, 64, 35), 1));
+    }
+
+    #[test]
+    fn the_volume_follows_us_by_section() {
+        let o = volume_origin(Vec3::new(5.0, 70.0, -3.0));
+        assert_eq!(o, IVec3::new(8 - 64, 72 - 32, -8 - 64));
+        assert_eq!(volume_origin(Vec3::new(15.9, 79.0, -0.5)), o, "still the same section");
+        assert_ne!(volume_origin(Vec3::new(16.1, 70.0, -3.0)), o);
+        // We stay well inside it.
+        for p in [Vec3::new(0.0, 64.0, -16.0), Vec3::new(15.99, 79.99, -0.01)] {
+            let c = p.floor().as_ivec3() - volume_origin(p);
+            assert!(c.x >= 24 && c.x < CUT_W - 24 && c.y >= 24 && c.y < CUT_H - 24 && c.z >= 24, "{c}");
+        }
+    }
+
+    #[test]
+    fn shadows_find_the_block_below() {
+        let mut cells = Cells::default();
+        cells.on_solids(&message(&[0, 4, 0, 1], &[IVec3::new(3, 2, 5)]));
+        assert!(cells.solid(IVec3::new(3, 66, 5)));
+        assert_eq!(cells.block_top_under(Vec3::new(3.5, 68.4, 5.5), 3), Some(67.0));
+        assert_eq!(cells.block_top_under(Vec3::new(3.5, 72.0, 5.5), 3), None, "too far down");
+        assert_eq!(cells.block_top_under(Vec3::new(4.5, 68.0, 5.5), 3), None);
+    }
+}
diff --git a/crates/benilla-app/src/wowcraft/head_portrait.rs b/crates/benilla-app/src/wowcraft/head_portrait.rs
new file mode 100644
index 00000000..a3ed76fa
--- /dev/null
+++ b/crates/benilla-app/src/wowcraft/head_portrait.rs
@@ -0,0 +1,84 @@
+//! Our Minecraft face is the player portrait: the skin's face with its hat layer over it
+//! ([`super::mc_body::Skin::face`]), in the `"player"` unit's portrait slot in place of the WoW
+//! head the booth bakes, so the player frame (and the micro button that crops it) shows who we are
+//! in the world.
+
+use bevy::asset::RenderAssetUsages;
+use bevy::image::{ImageSampler, ImageSamplerDescriptor};
+use bevy::prelude::*;
+use bevy::render::render_resource::{Extent3d, TextureDimension, TextureFormat};
+
+use crate::portrait::{PortraitImages, PortraitSource};
+
+use super::mc_body::McSkin;
+
+/// Each of the face's 8 × 8 pixels drawn this many texels wide, so the round cut and the frame's
+/// filtering keep its pixels square.
+const SCALE: u32 = 16;
+
+pub(crate) fn plugin(app: &mut App) {
+    // After the booth has written its own slots this frame, before the interface draws them.
+    app.add_systems(Update, show_face.after(crate::portrait::PortraitSync).before(crate::ui_script::UiPaint));
+}
+
+/// The face as an image: un-encoded RGBA8, the gamma bytes the interface composites in, opaque
+/// (a bake's premultiplied alpha is the same then).
+fn face_image(face: &[[u8; 4]; 64]) -> Image {
+    let side = 8 * SCALE;
+    let mut data = Vec::with_capacity((side * side * 4) as usize);
+    for y in 0..side {
+        for x in 0..side {
+            data.extend_from_slice(&face[((y / SCALE) * 8 + x / SCALE) as usize]);
+        }
+    }
+    let mut image = Image::new(
+        Extent3d { width: side, height: side, depth_or_array_layers: 1 },
+        TextureDimension::D2,
+        data,
+        TextureFormat::Rgba8Unorm,
+        RenderAssetUsages::RENDER_WORLD,
+    );
+    image.sampler = ImageSampler::Descriptor(ImageSamplerDescriptor::nearest());
+    image
+}
+
+fn show_face(
+    skin: Res<McSkin>,
+    mut portraits: ResMut<PortraitImages>,
+    mut images: ResMut<Assets<Image>>,
+    mut face: Local<Option<(u64, Handle<Image>)>>,
+) {
+    let Some(s) = skin.get() else { return };
+    if face.as_ref().is_none_or(|(rev, _)| *rev != skin.revision()) {
+        if face.is_none() {
+            info!("wowcraft: our Minecraft face is the player portrait");
+        }
+        *face = Some((skin.revision(), images.add(face_image(&s.face()))));
+    }
+    let Some((_, handle)) = face.as_ref() else { return };
+    let want = PortraitSource::Live(handle.clone());
+    if portraits.0.get("player") != Some(&want) {
+        portraits.0.insert("player".to_string(), want);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn each_face_pixel_is_a_square_block() {
+        let mut face = [[0u8; 4]; 64];
+        face[0] = [255, 0, 0, 255];
+        face[9] = [0, 255, 0, 255]; // (1, 1)
+        let image = face_image(&face);
+        assert_eq!(image.width(), 128);
+        let data = image.data.as_ref().unwrap();
+        let at = |x: usize, y: usize| &data[(y * 128 + x) * 4..(y * 128 + x) * 4 + 4];
+        assert_eq!(at(0, 0), [255, 0, 0, 255]);
+        assert_eq!(at(15, 15), [255, 0, 0, 255]);
+        assert_eq!(at(16, 16), [0, 255, 0, 255]);
+        assert_eq!(at(31, 31), [0, 255, 0, 255]);
+        assert_eq!(at(32, 16), [0, 0, 0, 0]);
+    }
+}
diff --git a/crates/benilla-app/src/wowcraft/labels.rs b/crates/benilla-app/src/wowcraft/labels.rs
new file mode 100644
index 00000000..05ebaae8
--- /dev/null
+++ b/crates/benilla-app/src/wowcraft/labels.rs
@@ -0,0 +1,192 @@
+//! Words WowCraft floats in WoW's world, in the overhead names' font and way ([`crate::nameplates`]:
+//! a camera-facing glyph mesh in the world pass, depth-tested, so walls hide it):
+//! - "Block trader (right-click)" in green under the name of an innkeeper or a general goods
+//!   vendor ([`super::combat::Traders`]), whom Minecraft trades blocks with on a right-click;
+//! - a co-op partner's name over their Minecraft body ([`super::blocks::Partners`]), as Minecraft's
+//!   name tag floats over a player.
+
+use std::collections::HashMap;
+
+use bevy::prelude::*;
+
+use crate::char_select::ClientState;
+use crate::entities::mount::MountChild;
+use crate::entities::{overhead_anchor, BoneAttach, OverheadFallback};
+use crate::ui_text::UiFontAtlas;
+use benilla_world::view::WorldCamera;
+
+use super::WowCraft;
+
+pub(crate) const TRADER_TEXT: &str = "Block trader (right-click)";
+/// WoW's `GREEN_FONT_COLOR` (raw gamma bytes, as the names' colours are).
+const GREEN: Color = Color::linear_rgb(0.1, 1.0, 0.1);
+/// Minecraft's name tag is white.
+const WHITE: Color = Color::linear_rgb(1.0, 1.0, 1.0);
+/// The baseline of a partner's name over their feet: Minecraft's tag, half a block over a player
+/// 1.8 high.
+const PARTNER_TAG: f32 = 2.3;
+
+pub(crate) fn plugin(app: &mut App) {
+    app.init_resource::<Labels>()
+        .add_systems(Update, float_labels.after(super::blocks::BlocksSet).after(crate::player::PlayerControlSet));
+}
+
+/// What a label stands for.
+#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]
+enum Subject {
+    /// A trader unit.
+    Trader(Entity),
+    /// A co-op partner, by their Minecraft entity id.
+    Partner(u32),
+}
+
+/// A floating label's entity.
+#[derive(Component)]
+pub(crate) struct LabelRoot;
+
+#[derive(Resource, Default)]
+struct Labels {
+    /// One mesh per text; their glyph UVs die with the font sheet's generation.
+    meshes: HashMap<String, Handle<Mesh>>,
+    green: Option<Handle<StandardMaterial>>,
+    white: Option<Handle<StandardMaterial>>,
+    live: HashMap<Subject, (Entity, String)>,
+    baked_from: Option<u64>,
+}
+
+impl Labels {
+    fn drop_all(&mut self, commands: &mut Commands) {
+        for (_, (e, _)) in self.live.drain() {
+            if let Ok(mut e) = commands.get_entity(e) {
+                e.despawn();
+            }
+        }
+    }
+}
+
+/// Where a one-line label goes for a name block anchored at `anchor` at `scale`: its baseline one
+/// pitch under the anchor's, as the next line of the block (the label mesh's baseline is at 1).
+fn under_name(anchor: Vec3, scale: f32) -> Vec3 {
+    anchor - Vec3::Y * scale
+}
+
+/// Where a partner's name goes over their feet at `scale`.
+fn over_partner(feet: Vec3, scale: f32) -> Vec3 {
+    feet + Vec3::Y * (PARTNER_TAG - scale)
+}
+
+#[allow(clippy::too_many_arguments, clippy::type_complexity)]
+fn float_labels(
+    mut commands: Commands,
+    wc: Res<WowCraft>,
+    state: Res<State<ClientState>>,
+    traders: Res<super::combat::Traders>,
+    partners: Res<super::blocks::Partners>,
+    units: Query<(&Transform, Option<&InheritedVisibility>), Without<LabelRoot>>,
+    camera: Query<&Transform, (With<WorldCamera>, Without<LabelRoot>)>,
+    anchor_q: (
+        Query<&BoneAttach>,
+        Query<&benilla_world::rig_anim::RigPose>,
+        Query<&OverheadFallback>,
+        Query<&GlobalTransform>,
+        Query<(), With<MountChild>>,
+    ),
+    mut placed: Query<&mut Transform, With<LabelRoot>>,
+    mut atlas: Option<ResMut<UiFontAtlas>>,
+    mut labels: ResMut<Labels>,
+    mut meshes: ResMut<Assets<Mesh>>,
+    mut materials: ResMut<Assets<StandardMaterial>>,
+) {
+    let labels = &mut *labels;
+    let (true, Some(atlas), Ok(cam)) = (*state.get() == ClientState::InWorld && wc.mc_in_world(), atlas.as_mut(), camera.single()) else {
+        labels.drop_all(&mut commands);
+        return;
+    };
+    // A glyph-sheet reset moves every cached UV.
+    if labels.baked_from != Some(atlas.generation) {
+        labels.drop_all(&mut commands);
+        labels.meshes.clear();
+        labels.baked_from = Some(atlas.generation);
+    }
+    let image = atlas.image();
+    let mut material = |color: Color| {
+        materials.add(StandardMaterial {
+            base_color: color,
+            base_color_texture: Some(image.clone()),
+            unlit: true,
+            alpha_mode: AlphaMode::Blend,
+            cull_mode: None,
+            depth_bias: benilla_world::sky_order::Rung::NAMEPLATE,
+            ..default()
+        })
+    };
+    let green = labels.green.get_or_insert_with(|| material(GREEN)).clone();
+    let white = labels.white.get_or_insert_with(|| material(WHITE)).clone();
+
+    // What shows this frame: the subject, its text and colour, and where.
+    let mut want: Vec<(Subject, String, Handle<StandardMaterial>, Vec3, f32)> = Vec::new();
+    for &unit in &traders.0 {
+        let Ok((tf, drawn)) = units.get(unit) else { continue };
+        if !drawn.is_none_or(|v| v.get()) {
+            continue;
+        }
+        let anchor = overhead_anchor(unit, tf, &anchor_q.0, &anchor_q.1, &anchor_q.2, &anchor_q.3, &anchor_q.4);
+        let scale = crate::nameplates::height_scale(anchor.y - tf.translation.y);
+        want.push((Subject::Trader(unit), TRADER_TEXT.to_string(), green.clone(), under_name(anchor, scale), scale));
+    }
+    for p in &partners.0 {
+        let scale = crate::nameplates::height_scale(PARTNER_TAG);
+        want.push((Subject::Partner(p.id), p.name.clone(), white.clone(), over_partner(p.feet, scale), scale));
+    }
+
+    let mut seen: Vec<Subject> = Vec::with_capacity(want.len());
+    for (subject, text, mat, at, scale) in want {
+        seen.push(subject);
+        let place = Transform { translation: at, rotation: cam.rotation, scale: Vec3::splat(scale) };
+        match labels.live.get(&subject) {
+            Some((e, shown)) if *shown == text => {
+                if let Ok(mut t) = placed.get_mut(*e) {
+                    if *t != place {
+                        *t = place;
+                    }
+                }
+            }
+            stale => {
+                if let Some(mut e) = stale.and_then(|(e, _)| commands.get_entity(*e).ok()) {
+                    e.despawn();
+                }
+                let mesh = labels
+                    .meshes
+                    .entry(text.clone())
+                    .or_insert_with(|| meshes.add(crate::nameplates::build_name_mesh(atlas, std::slice::from_ref(&text))))
+                    .clone();
+                let e = commands.spawn((Name::new("wowcraft label"), LabelRoot, Mesh3d(mesh), MeshMaterial3d(mat), place)).id();
+                labels.live.insert(subject, (e, text));
+            }
+        }
+    }
+    labels.live.retain(|subject, (e, _)| {
+        let keep = seen.contains(subject);
+        if let Some(mut e) = (!keep).then(|| commands.get_entity(*e).ok()).flatten() {
+            e.despawn();
+        }
+        keep
+    });
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_trader_label_is_the_line_under_the_name() {
+        let anchor = Vec3::new(1.0, 10.0, 2.0);
+        let scale = crate::nameplates::height_scale(2.0);
+        // The name's last line has its baseline one pitch over the anchor; ours is the next line.
+        assert_eq!(under_name(anchor, scale) + Vec3::Y * scale, anchor);
+        // A partner's name stands where Minecraft's tag does.
+        let feet = Vec3::new(0.0, 5.0, 0.0);
+        assert!(((over_partner(feet, scale) + Vec3::Y * scale).y - 7.3).abs() < 1e-5);
+        assert_eq!(TRADER_TEXT, "Block trader (right-click)");
+    }
+}
diff --git a/crates/benilla-app/src/wowcraft/mc_body.rs b/crates/benilla-app/src/wowcraft/mc_body.rs
new file mode 100644
index 00000000..72f92adb
--- /dev/null
+++ b/crates/benilla-app/src/wowcraft/mc_body.rs
@@ -0,0 +1,533 @@
+//! Our Minecraft body on the character screens. In the world we are Minecraft's body, which the
+//! mod poses and sends ([`super::blocks`]); at character select and create the stage shows it too,
+//! built here from our skin, where the WoW model stands. The WoW model stays loaded, lit and
+//! yawed under it, hidden, and comes back whenever there is no skin.
+//!
+//! The skin comes from the mod: the file it saves (`WOWCRAFT_SKIN_FILE`, read at start and again
+//! when it changes) and the texture it sends as ours while Minecraft runs ([`McSkin::offer`]).
+//! [`super::head_portrait`] makes the same skin's face our portrait.
+
+use std::path::PathBuf;
+use std::time::SystemTime;
+
+use bevy::asset::RenderAssetUsages;
+use bevy::camera::visibility::RenderLayers;
+use bevy::image::{ImageSampler, ImageSamplerDescriptor};
+use bevy::mesh::{Indices, Mesh, PrimitiveTopology};
+use bevy::prelude::*;
+use bevy::render::render_resource::{Extent3d, TextureDimension, TextureFormat};
+
+use crate::char_select::ClientState;
+
+/// A skin's side in pixels; a legacy skin is half as tall.
+const SKIN: u32 = 64;
+/// How often the skin file is looked at for a change, seconds.
+const FILE_CHECK_SECS: f32 = 2.0;
+/// The model's pixel in yards: Minecraft's sixteenth of a block, times the 15/16 its player
+/// renderer scales the model by (a block is a yard here, as in the world).
+const PX: f32 = 0.9375 / 16.0;
+
+pub(crate) fn plugin(app: &mut App) {
+    app.insert_resource(McSkin {
+        file: super::env_file("WOWCRAFT_SKIN_FILE"),
+        ..default()
+    })
+    .add_systems(Update, (watch_skin_file, stand_mc_body, swing_arms).chain().after(crate::portrait::PortraitSync));
+}
+
+/// Our skin as Minecraft draws it: 64 × 64 RGBA8 after Minecraft's own processing of a downloaded
+/// skin (a legacy 64 × 32 one widened with mirrored left limbs, its hat cleared if it covers it
+/// all, the base layer made opaque), and whether its arms are slim.
+#[derive(Clone, PartialEq, Debug)]
+pub(crate) struct Skin {
+    rgba: Vec<u8>,
+    pub(crate) slim: bool,
+}
+
+impl Skin {
+    /// A skin from RGBA8 pixels, or `None` for a size no Minecraft skin has.
+    pub(crate) fn from_rgba(width: u32, height: u32, rgba: &[u8]) -> Option<Skin> {
+        let legacy = match (width, height) {
+            (SKIN, SKIN) => false,
+            (SKIN, 32) => true,
+            _ => return None,
+        };
+        if rgba.len() < (width * height * 4) as usize {
+            return None;
+        }
+        let mut skin = Skin { rgba: vec![0; (SKIN * SKIN * 4) as usize], slim: false };
+        skin.rgba[..(width * height * 4) as usize].copy_from_slice(&rgba[..(width * height * 4) as usize]);
+        if legacy {
+            skin.widen_legacy();
+        } else {
+            skin.slim = skin.looks_slim();
+        }
+        // The base layer is opaque: Minecraft ignores its alpha.
+        for (x0, y0, x1, y1) in [(0, 0, 32, 16), (0, 16, 64, 32), (16, 48, 48, 64)] {
+            for y in y0..y1 {
+                for x in x0..x1 {
+                    skin.rgba[Self::at(x, y) + 3] = 255;
+                }
+            }
+        }
+        Some(skin)
+    }
+
+    /// A skin from a PNG file's bytes.
+    pub(crate) fn from_png(bytes: &[u8]) -> Result<Skin, String> {
+        let image = image::load_from_memory_with_format(bytes, image::ImageFormat::Png).map_err(|e| e.to_string())?;
+        let rgba = image.to_rgba8();
+        let (w, h) = rgba.dimensions();
+        Skin::from_rgba(w, h, rgba.as_raw()).ok_or_else(|| format!("{w}x{h}"))
+    }
+
+    fn at(x: u32, y: u32) -> usize {
+        ((y * SKIN + x) * 4) as usize
+    }
+
+    pub(crate) fn pixel(&self, x: u32, y: u32) -> [u8; 4] {
+        let i = Self::at(x, y);
+        [self.rgba[i], self.rgba[i + 1], self.rgba[i + 2], self.rgba[i + 3]]
+    }
+
+    /// Slim ("Alex") arms leave the last two columns of the right arm's texture (x 54-55, y 20-31)
+    /// unused: empty, or black where an exporter made them opaque.
+    fn looks_slim(&self) -> bool {
+        let unused: Vec<[u8; 4]> = (20..32).flat_map(|y| (54..56).map(move |x| (x, y))).map(|(x, y)| self.pixel(x, y)).collect();
+        unused.iter().all(|p| p[3] == 0) || unused.iter().all(|p| *p == [0, 0, 0, 255])
+    }
+
+    /// Minecraft's legacy conversion (`SkinTextureDownloader.processLegacySkin`): the left leg and
+    /// arm are the right ones mirrored, and a hat layer with no see-through pixel is cleared.
+    fn widen_legacy(&mut self) {
+        // (x, y, dx, dy, w, h): the rect at (x, y) copied to (x + dx, y + dy), mirrored left-right.
+        const COPIES: [(u32, u32, i32, i32, u32, u32); 12] = [
+            (4, 16, 16, 32, 4, 4),
+            (8, 16, 16, 32, 4, 4),
+            (0, 20, 24, 32, 4, 12),
+            (4, 20, 16, 32, 4, 12),
+            (8, 20, 8, 32, 4, 12),
+            (12, 20, 16, 32, 4, 12),
+            (44, 16, -8, 32, 4, 4),
+            (48, 16, -8, 32, 4, 4),
+            (40, 20, 0, 32, 4, 12),
+            (44, 20, -8, 32, 4, 12),
+            (48, 20, -16, 32, 4, 12),
+            (52, 20, -8, 32, 4, 12),
+        ];
+        for (x, y, dx, dy, w, h) in COPIES {
+            for row in 0..h {
+                for col in 0..w {
+                    let src = Self::at(x + col, y + row);
+                    let dst = Self::at((x as i32 + dx) as u32 + (w - 1 - col), (y as i32 + dy) as u32 + row);
+                    let p: [u8; 4] = self.rgba[src..src + 4].try_into().unwrap_or_default();
+                    self.rgba[dst..dst + 4].copy_from_slice(&p);
+                }
+            }
+        }
+        // The "Notch transparency hack": an all-opaque hat region was never meant as a hat.
+        let opaque = (0..32).all(|y| (32..64).all(|x| self.pixel(x, y)[3] >= 128));
+        if opaque {
+            for y in 0..32 {
+                for x in 32..64 {
+                    self.rgba[Self::at(x, y) + 3] = 0;
+                }
+            }
+        }
+    }
+
+    /// The face as Minecraft shows it: the head's front with the hat layer over it, 8 × 8.
+    pub(crate) fn face(&self) -> [[u8; 4]; 64] {
+        let mut out = [[0u8; 4]; 64];
+        for y in 0..8 {
+            for x in 0..8 {
+                let base = self.pixel(8 + x, 8 + y);
+                let hat = self.pixel(40 + x, 8 + y);
+                let a = hat[3] as u32;
+                let mix = |b: u8, h: u8| ((h as u32 * a + b as u32 * (255 - a) + 127) / 255) as u8;
+                out[(y * 8 + x) as usize] = [mix(base[0], hat[0]), mix(base[1], hat[1]), mix(base[2], hat[2]), 255];
+            }
+        }
+        out
+    }
+
+    /// The skin as a texture: un-encoded RGBA8 (the screens composite in gamma bytes, as WoW's own
+    /// textures are), sampled nearest, as Minecraft draws its pixels.
+    fn image(&self) -> Image {
+        let mut image = Image::new(
+            Extent3d { width: SKIN, height: SKIN, depth_or_array_layers: 1 },
+            TextureDimension::D2,
+            self.rgba.clone(),
+            TextureFormat::Rgba8Unorm,
+            RenderAssetUsages::RENDER_WORLD,
+        );
+        image.sampler = ImageSampler::Descriptor(ImageSamplerDescriptor::nearest());
+        image
+    }
+}
+
+/// Our skin, from the file or from Minecraft; `revision` bumps on every change.
+#[derive(Resource, Default)]
+pub(crate) struct McSkin {
+    skin: Option<Skin>,
+    revision: u64,
+    file: Option<PathBuf>,
+    file_stamp: Option<SystemTime>,
+}
+
+impl McSkin {
+    pub(crate) fn get(&self) -> Option<&Skin> {
+        self.skin.as_ref()
+    }
+
+    pub(crate) fn revision(&self) -> u64 {
+        self.revision
+    }
+
+    /// Take a skin (the file's, or the one Minecraft sends as ours); whether it was new.
+    pub(crate) fn offer(&mut self, skin: Skin) -> bool {
+        if self.skin.as_ref() == Some(&skin) {
+            return false;
+        }
+        self.skin = Some(skin);
+        self.revision += 1;
+        true
+    }
+}
+
+/// Read the skin file at start and whenever it changes (the mod rewrites it with our skin).
+fn watch_skin_file(mut skin: ResMut<McSkin>, time: Res<Time<Real>>, mut next: Local<f32>) {
+    let now = time.elapsed_secs();
+    if now < *next {
+        return;
+    }
+    *next = now + FILE_CHECK_SECS;
+    let Some(path) = skin.file.clone() else { return };
+    let Ok(stamp) = std::fs::metadata(&path).and_then(|m| m.modified()) else { return };
+    if skin.file_stamp == Some(stamp) {
+        return;
+    }
+    skin.file_stamp = Some(stamp);
+    let Ok(bytes) = std::fs::read(&path) else { return };
+    match Skin::from_png(&bytes) {
+        Ok(s) => {
+            let slim = s.slim;
+            if skin.offer(s) {
+                info!("wowcraft: our Minecraft body for the character screens, from {} ({} arms)", path.display(), if slim { "slim" } else { "wide" });
+            }
+        }
+        Err(e) => warn!("wowcraft: the skin {} is {e}, not a Minecraft skin", path.display()),
+    }
+}
+
+/// One limb of the player model: its pivot (pixels, from the feet, facing −Z, its right at +X),
+/// its cubes and, for an arm, which way its idle swing turns (+1 right, −1 left).
+struct Limb {
+    pivot: Vec3,
+    cubes: Vec<Cube>,
+    swing: f32,
+}
+
+/// A cube of the model: its corner and size relative to the pivot (pixels), where its texture
+/// starts, and how far it is grown (the second layer's 0.5 or 0.25 px).
+#[derive(Clone, Copy)]
+struct Cube {
+    min: Vec3,
+    size: Vec3,
+    uv: UVec2,
+    grow: f32,
+}
+
+fn cube(min: [f32; 3], size: [f32; 3], uv: [u32; 2], grow: f32) -> Cube {
+    Cube { min: Vec3::from(min), size: Vec3::from(size), uv: UVec2::from(uv), grow }
+}
+
+/// Minecraft's player model (`PlayerModel`), both layers.
+fn limbs(slim: bool) -> Vec<Limb> {
+    let arm = if slim { 3.0 } else { 4.0 };
+    let arm_y = if slim { 21.5 } else { 22.0 };
+    vec![
+        Limb { pivot: Vec3::new(0.0, 24.0, 0.0), cubes: vec![cube([-4.0, 0.0, -4.0], [8.0, 8.0, 8.0], [0, 0], 0.0), cube([-4.0, 0.0, -4.0], [8.0, 8.0, 8.0], [32, 0], 0.5)], swing: 0.0 },
+        Limb { pivot: Vec3::new(0.0, 24.0, 0.0), cubes: vec![cube([-4.0, -12.0, -2.0], [8.0, 12.0, 4.0], [16, 16], 0.0), cube([-4.0, -12.0, -2.0], [8.0, 12.0, 4.0], [16, 32], 0.25)], swing: 0.0 },
+        // The right arm (+X) and the left.
+        Limb { pivot: Vec3::new(5.0, arm_y, 0.0), cubes: vec![cube([-1.0, -10.0, -2.0], [arm, 12.0, 4.0], [40, 16], 0.0), cube([-1.0, -10.0, -2.0], [arm, 12.0, 4.0], [40, 32], 0.25)], swing: 1.0 },
+        Limb { pivot: Vec3::new(-5.0, arm_y, 0.0), cubes: vec![cube([1.0 - arm, -10.0, -2.0], [arm, 12.0, 4.0], [32, 48], 0.0), cube([1.0 - arm, -10.0, -2.0], [arm, 12.0, 4.0], [48, 48], 0.25)], swing: -1.0 },
+        // The right leg and the left.
+        Limb { pivot: Vec3::new(1.9, 12.0, 0.0), cubes: vec![cube([-2.0, -12.0, -2.0], [4.0, 12.0, 4.0], [0, 16], 0.0), cube([-2.0, -12.0, -2.0], [4.0, 12.0, 4.0], [0, 32], 0.25)], swing: 0.0 },
+        Limb { pivot: Vec3::new(-1.9, 12.0, 0.0), cubes: vec![cube([-2.0, -12.0, -2.0], [4.0, 12.0, 4.0], [16, 48], 0.0), cube([-2.0, -12.0, -2.0], [4.0, 12.0, 4.0], [0, 48], 0.25)], swing: 0.0 },
+    ]
+}
+
+/// A limb's cubes as one mesh, in yards from its pivot. Each face takes its rect of the skin as
+/// Minecraft's `ModelPart.Cube` lays them out (`d` deep, `w` wide, `h` high from the texture
+/// corner): the top and bottom in the first row, then the right side, front, left side and back;
+/// and Minecraft's fixed face shading (top 1.0, bottom 0.5, front and back 0.8, sides 0.6) in the
+/// vertex colours.
+fn limb_mesh(cubes: &[Cube]) -> Mesh {
+    let mut pos: Vec<[f32; 3]> = Vec::new();
+    let mut uv: Vec<[f32; 2]> = Vec::new();
+    let mut nrm: Vec<[f32; 3]> = Vec::new();
+    let mut col: Vec<[f32; 4]> = Vec::new();
+    let mut idx: Vec<u32> = Vec::new();
+    for c in cubes {
+        let (lo, hi) = ((c.min - Vec3::splat(c.grow)) * PX, (c.min + c.size + Vec3::splat(c.grow)) * PX);
+        let (w, h, d) = (c.size.x, c.size.y, c.size.z);
+        let (u, v) = (c.uv.x as f32, c.uv.y as f32);
+        let p = |x: bool, y: bool, z: bool| [if x { hi.x } else { lo.x }, if y { hi.y } else { lo.y }, if z { hi.z } else { lo.z }];
+        // (corners, their texels, the outward normal, the shade); the corners run clockwise as
+        // seen from outside.
+        let faces: [([[f32; 3]; 4], [[f32; 2]; 4], [f32; 3], f32); 6] = [
+            // Front, −Z: the texture's left is the model's right (+X).
+            ([p(true, true, false), p(false, true, false), p(false, false, false), p(true, false, false)], [[u + d, v + d], [u + d + w, v + d], [u + d + w, v + d + h], [u + d, v + d + h]], [0.0, 0.0, -1.0], 0.8),
+            // Back, +Z.
+            ([p(false, true, true), p(true, true, true), p(true, false, true), p(false, false, true)], [[u + 2.0 * d + w, v + d], [u + 2.0 * (d + w), v + d], [u + 2.0 * (d + w), v + d + h], [u + 2.0 * d + w, v + d + h]], [0.0, 0.0, 1.0], 0.8),
+            // Right side, +X: back to front.
+            ([p(true, true, true), p(true, true, false), p(true, false, false), p(true, false, true)], [[u, v + d], [u + d, v + d], [u + d, v + d + h], [u, v + d + h]], [1.0, 0.0, 0.0], 0.6),
+            // Left side, −X: front to back.
+            ([p(false, true, false), p(false, true, true), p(false, false, true), p(false, false, false)], [[u + d + w, v + d], [u + 2.0 * d + w, v + d], [u + 2.0 * d + w, v + d + h], [u + d + w, v + d + h]], [-1.0, 0.0, 0.0], 0.6),
+            // Top, +Y: the back edge at the texture's top.
+            ([p(true, true, true), p(false, true, true), p(false, true, false), p(true, true, false)], [[u + d, v], [u + d + w, v], [u + d + w, v + d], [u + d, v + d]], [0.0, 1.0, 0.0], 1.0),
+            // Bottom, −Y: the next rect along, the same way round.
+            ([p(true, false, true), p(false, false, true), p(false, false, false), p(true, false, false)], [[u + d + w, v], [u + d + 2.0 * w, v], [u + d + 2.0 * w, v + d], [u + d + w, v + d]], [0.0, -1.0, 0.0], 0.5),
+        ];
+        for (corners, texels, normal, shade) in faces {
+            let base = pos.len() as u32;
+            pos.extend(corners);
+            uv.extend(texels.map(|[x, y]| [x / SKIN as f32, y / SKIN as f32]));
+            nrm.extend([normal; 4]);
+            col.extend([[shade, shade, shade, 1.0]; 4]);
+            // Counter-clockwise from outside.
+            idx.extend([base, base + 3, base + 2, base, base + 2, base + 1]);
+        }
+    }
+    Mesh::new(PrimitiveTopology::TriangleList, RenderAssetUsages::RENDER_WORLD)
+        .with_inserted_attribute(Mesh::ATTRIBUTE_POSITION, pos)
+        .with_inserted_attribute(Mesh::ATTRIBUTE_NORMAL, nrm)
+        .with_inserted_attribute(Mesh::ATTRIBUTE_UV_0, uv)
+        .with_inserted_attribute(Mesh::ATTRIBUTE_COLOR, col)
+        .with_inserted_indices(Indices::U32(idx))
+}
+
+/// A limb of the body on the stage; `swing` as [`Limb`]'s.
+#[derive(Component)]
+pub(crate) struct McBody {
+    swing: f32,
+}
+
+/// The body's root on the stage, which stands where the WoW model's root does.
+#[derive(Component)]
+struct McBodyRoot;
+
+/// The body as built: its root, and the skin revision its limbs and texture are from.
+#[derive(Default)]
+struct Built {
+    root: Option<Entity>,
+    revision: u64,
+    material: Option<Handle<StandardMaterial>>,
+    /// The WoW model's root we hid, to show again.
+    hid: Option<Entity>,
+}
+
+/// Stand the body on the character screens' stage, in place of the WoW model, while there's a
+/// skin and a character on the stage.
+#[allow(clippy::too_many_arguments)]
+fn stand_mc_body(
+    mut commands: Commands,
+    skin: Res<McSkin>,
+    state: Res<State<ClientState>>,
+    preview: Res<crate::portrait::GluePreview>,
+    stage: Option<Res<crate::portrait::GlueStage>>,
+    mut meshes: ResMut<Assets<Mesh>>,
+    mut materials: ResMut<Assets<StandardMaterial>>,
+    mut images: ResMut<Assets<Image>>,
+    mut transforms: Query<&mut Transform>,
+    mut visibility: Query<&mut Visibility>,
+    mut built: Local<Built>,
+) {
+    let on_stage = matches!(state.get(), ClientState::CharSelect | ClientState::CharCreate) && preview.look.is_some();
+    let (Some(stage), Some(s)) = (stage, skin.get().filter(|_| on_stage)) else {
+        // Off the stage: the body goes and the WoW model comes back.
+        if let Some(mut v) = built.root.and_then(|r| visibility.get_mut(r).ok()) {
+            *v = Visibility::Hidden;
+        }
+        if let Some(mut v) = built.hid.take().and_then(|r| visibility.get_mut(r).ok()) {
+            *v = Visibility::Visible;
+        }
+        return;
+    };
+    if built.root.is_none() || built.revision != skin.revision() {
+        if let Some(root) = built.root.take() {
+            commands.entity(root).despawn();
+        }
+        let texture = images.add(s.image());
+        let material = match built.material.clone() {
+            Some(m) => {
+                if let Some(m) = materials.get_mut(&m) {
+                    m.base_color_texture = Some(texture);
+                }
+                m
+            }
+            None => materials.add(StandardMaterial {
+                base_color_texture: Some(texture),
+                // Minecraft's own face shading is in the vertex colours.
+                unlit: true,
+                // The second layer is cut out where it's see-through.
+                alpha_mode: AlphaMode::Mask(0.5),
+                // A grown second-layer face seen from inside stays drawn, as Minecraft draws it.
+                cull_mode: None,
+                ..default()
+            }),
+        };
+        built.material = Some(material.clone());
+        let root = commands.spawn((Name::new("wowcraft Minecraft body"), McBodyRoot, Transform::default(), Visibility::Visible)).id();
+        for limb in limbs(s.slim) {
+            commands.spawn((
+                McBody { swing: limb.swing },
+                Mesh3d(meshes.add(limb_mesh(&limb.cubes))),
+                MeshMaterial3d(material.clone()),
+                Transform::from_translation(limb.pivot * PX),
+                Visibility::Inherited,
+                RenderLayers::clone(&stage.layer),
+                ChildOf(root),
+            ));
+        }
+        built.root = Some(root);
+        built.revision = skin.revision();
+    }
+    let Some(root) = built.root else { return };
+    // Where the WoW model stands (its seat, the stage's frame and the yaw), the body stands.
+    if let Ok(seat) = transforms.get(stage.root).copied() {
+        if let Ok(mut t) = transforms.get_mut(root) {
+            if *t != seat {
+                *t = seat;
+            }
+        }
+    }
+    if let Ok(mut v) = visibility.get_mut(root) {
+        if *v != Visibility::Visible {
+            *v = Visibility::Visible;
+        }
+    }
+    if let Ok(mut v) = visibility.get_mut(stage.root) {
+        if *v != Visibility::Hidden {
+            *v = Visibility::Hidden;
+        }
+        built.hid = Some(stage.root);
+    }
+}
+
+/// Minecraft's idle arm sway (`AnimationUtils.bobModelPart`), on Minecraft's 20 ticks a second.
+fn arm_sway(seconds: f32, swing: f32) -> Quat {
+    let ticks = seconds * 20.0;
+    let out = (ticks * 0.09).cos() * 0.05 + 0.05;
+    let forward = (ticks * 0.067).sin() * 0.05;
+    Quat::from_rotation_z(swing * out) * Quat::from_rotation_x(swing * forward)
+}
+
+fn swing_arms(time: Res<Time>, mut limbs: Query<(&McBody, &mut Transform)>) {
+    for (limb, mut t) in &mut limbs {
+        if limb.swing != 0.0 {
+            t.rotation = arm_sway(time.elapsed_secs(), limb.swing);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// A skin with each region painted its own colour: (x, y) → [x, y, 7, 255].
+    fn painted(width: u32, height: u32) -> Vec<u8> {
+        (0..height).flat_map(|y| (0..width).flat_map(move |x| [x as u8, y as u8, 7, 255])).collect()
+    }
+
+    #[test]
+    fn only_minecraft_skin_sizes_are_skins() {
+        assert!(Skin::from_rgba(64, 64, &painted(64, 64)).is_some());
+        assert!(Skin::from_rgba(64, 32, &painted(64, 32)).is_some());
+        assert!(Skin::from_rgba(128, 128, &painted(128, 128)).is_none());
+        assert!(Skin::from_rgba(64, 64, &painted(64, 32)).is_none(), "too few pixels");
+    }
+
+    #[test]
+    fn a_legacy_skin_gets_mirrored_left_limbs() {
+        let mut px = painted(64, 32);
+        // An opaque hat region: the Notch hack clears it.
+        let skin = Skin::from_rgba(64, 32, &px).unwrap();
+        // The right leg's front (4..8, 20..32) mirrored is the left leg's front (20..24, 52..64).
+        assert_eq!(skin.pixel(20, 52), [7, 20, 7, 255]);
+        assert_eq!(skin.pixel(23, 52), [4, 20, 7, 255]);
+        // The right arm's top (44..48, 16..20) mirrored to the left arm's (36..40, 48..52).
+        assert_eq!(skin.pixel(36, 48), [47, 16, 7, 255]);
+        assert_eq!(skin.pixel(40, 0)[3], 0, "an all-opaque hat is no hat");
+        // A hat with a hole is kept.
+        let i = ((64 + 40) * 4 + 3) as usize; // (40, 1)
+        px[i] = 0;
+        let skin = Skin::from_rgba(64, 32, &px).unwrap();
+        assert_eq!(skin.pixel(41, 0)[3], 255);
+        assert!(!skin.slim);
+    }
+
+    #[test]
+    fn slim_arms_are_told_by_their_empty_columns() {
+        let mut px = painted(64, 64);
+        assert!(!Skin::from_rgba(64, 64, &px).unwrap().slim);
+        for y in 20..32 {
+            for x in 54..56 {
+                px[((y * 64 + x) * 4 + 3) as usize] = 0;
+            }
+        }
+        let skin = Skin::from_rgba(64, 64, &px).unwrap();
+        assert!(skin.slim);
+        // The base layer is drawn opaque whatever its alpha.
+        assert_eq!(skin.pixel(54, 20)[3], 255);
+    }
+
+    #[test]
+    fn the_face_wears_its_hat() {
+        let mut px = vec![0u8; 64 * 64 * 4];
+        let put = |px: &mut Vec<u8>, x: usize, y: usize, c: [u8; 4]| px[(y * 64 + x) * 4..(y * 64 + x) * 4 + 4].copy_from_slice(&c);
+        for y in 8..16 {
+            for x in 8..16 {
+                put(&mut px, x, y, [200, 150, 100, 255]);
+            }
+        }
+        put(&mut px, 40, 8, [0, 0, 255, 255]); // the hat over the face's top left
+        put(&mut px, 41, 8, [0, 0, 0, 0]); // a see-through hat pixel
+        let face = Skin::from_rgba(64, 64, &px).unwrap().face();
+        assert_eq!(face[0], [0, 0, 255, 255]);
+        assert_eq!(face[1], [200, 150, 100, 255]);
+        assert_eq!(face[63], [200, 150, 100, 255]);
+    }
+
+    /// The head's faces sample the rects a skin paints them in, and the body stands 1.875 yd.
+    #[test]
+    fn the_model_maps_the_skin_as_minecraft_does() {
+        let head = &limbs(false)[0];
+        let mesh = limb_mesh(&head.cubes[..1]);
+        let Some(bevy::mesh::VertexAttributeValues::Float32x2(uv)) = mesh.attribute(Mesh::ATTRIBUTE_UV_0) else { panic!() };
+        let Some(bevy::mesh::VertexAttributeValues::Float32x3(pos)) = mesh.attribute(Mesh::ATTRIBUTE_POSITION) else { panic!() };
+        let px = |i: usize| (uv[i][0] * 64.0, uv[i][1] * 64.0);
+        // The front's top left corner is the model's top right (+X), at the face's (8, 8).
+        assert_eq!(px(0), (8.0, 8.0));
+        assert!(pos[0][0] > 0.0 && pos[0][2] < 0.0);
+        // The top face starts at (8, 0), the right side at (0, 8), the back at (24, 8).
+        assert_eq!(px(16), (8.0, 0.0));
+        assert_eq!(px(8), (0.0, 8.0));
+        assert_eq!(px(4), (24.0, 8.0));
+        // Feet to the top of the hat: 32 px and the hat's half pixel, at 15/16 of a sixteenth.
+        let top = limbs(false).iter().flat_map(|l| l.cubes.iter().map(move |c| (l.pivot.y + c.min.y + c.size.y + c.grow) * PX)).fold(0.0, f32::max);
+        assert!((top - 32.5 * PX).abs() < 1e-5 && (32.0 * PX - 1.875).abs() < 1e-5);
+        // Slim arms are a pixel narrower.
+        assert_eq!(limbs(true)[2].cubes[0].size.x, 3.0);
+    }
+
+    #[test]
+    fn the_arms_sway_outward() {
+        for t in [0.0, 1.3, 7.7] {
+            let hand = arm_sway(t, 1.0) * Vec3::NEG_Y;
+            assert!(hand.x >= 0.0, "the right hand stays out at +X ({hand})");
+            assert!((arm_sway(t, -1.0) * Vec3::NEG_Y).x <= 0.0);
+        }
+    }
+}
