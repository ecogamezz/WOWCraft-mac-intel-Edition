+//! Cells cut out of the terrain: a [`CUT_W`] × [`CUT_H`] × [`CUT_D`] bit volume of one-yard world
+//! cells round an origin, in one storage buffer every terrain material binds at `storage(91)`.
+//! `terrain.wgsl` drops its ground in a set cell, so something standing in the land (a block set
+//! into the ground, a hole dug in it) is not drawn over. The volume starts empty and off; the world
+//! engine itself never fills it.
+//!
+//! The buffer is the shader's `TerrainCut`: `origin: vec4<i32>` (`w` = enabled), then the bits,
+//! cell (x, y, z) of the volume at bit `x + CUT_W · (z + CUT_D · y)`.
+
+use bevy::prelude::*;
+use bevy::render::extract_resource::{ExtractResource, ExtractResourcePlugin};
+use bevy::render::render_resource::{Buffer, BufferDescriptor, BufferUsages};
+use bevy::render::renderer::{RenderDevice, RenderQueue};
+use bevy::render::{Render, RenderApp, RenderSystems};
+
+/// The volume's width (x), height (y) and depth (z) in cells.
+pub const CUT_W: i32 = 128;
+pub const CUT_H: i32 = 64;
+pub const CUT_D: i32 = 128;
+/// The volume's bits as `u32` words.
+pub const CUT_WORDS: usize = (CUT_W * CUT_H * CUT_D) as usize / 32;
+/// The buffer's size: the origin row, then the words.
+pub const CUT_BYTES: u64 = 16 + 4 * CUT_WORDS as u64;
+
+/// The persistent buffer the terrain materials bind, created with the shared light at startup;
+/// a `Buffer` clone shares the GPU resource. Zeroed at creation, so the cut starts off.
+#[derive(Resource, Clone, ExtractResource)]
+pub struct TerrainCutBuffer(pub Buffer);
+
+/// Creates [`TerrainCutBuffer`] from the main-world `RenderDevice`.
+pub fn new_terrain_cut_buffer(device: &RenderDevice) -> TerrainCutBuffer {
+    TerrainCutBuffer(device.create_buffer(&BufferDescriptor {
+        label: Some("wow_terrain_cut"),
+        size: CUT_BYTES,
+        usage: BufferUsages::STORAGE | BufferUsages::COPY_DST,
+        mapped_at_creation: false,
+    }))
+}
+
+/// The cut volume as the main world fills it; extracted and uploaded whole when it changes.
+#[derive(Resource, Clone, ExtractResource)]
+pub struct TerrainCut {
+    /// The volume's lowest corner, in world cells (`floor` of Bevy yards).
+    origin: IVec3,
+    enabled: bool,
+    bits: Vec<u32>,
+}
+
+impl Default for TerrainCut {
+    fn default() -> Self {
+        Self {
+            origin: IVec3::ZERO,
+            enabled: false,
+            bits: vec![0; CUT_WORDS],
+        }
+    }
+}
+
+impl TerrainCut {
+    /// Empty the volume and move it to `origin`; `enabled` turns the shader's test on.
+    pub fn reset(&mut self, origin: IVec3, enabled: bool) {
+        self.origin = origin;
+        self.enabled = enabled;
+        self.bits.fill(0);
+    }
+
+    pub fn origin(&self) -> IVec3 {
+        self.origin
+    }
+
+    pub fn enabled(&self) -> bool {
+        self.enabled
+    }
+
+    /// A world cell's bit, or `None` outside the volume.
+    fn index(&self, cell: IVec3) -> Option<usize> {
+        let c = cell - self.origin;
+        let inside = c.cmpge(IVec3::ZERO).all() && c.cmplt(IVec3::new(CUT_W, CUT_H, CUT_D)).all();
+        inside.then(|| (c.x + CUT_W * (c.z + CUT_D * c.y)) as usize)
+    }
+
+    /// Cut a world cell; one outside the volume is ignored. Whether it landed.
+    pub fn cut(&mut self, cell: IVec3) -> bool {
+        let Some(i) = self.index(cell) else {
+            return false;
+        };
+        self.bits[i >> 5] |= 1 << (i & 31);
+        true
+    }
+
+    /// Whether the shader drops terrain in this world cell.
+    pub fn is_cut(&self, cell: IVec3) -> bool {
+        self.enabled
+            && self
+                .index(cell)
+                .is_some_and(|i| self.bits[i >> 5] >> (i & 31) & 1 == 1)
+    }
+
+    /// The buffer's bytes: `origin.xyz`, the enable flag, then the words.
+    pub fn bytes(&self) -> Vec<u8> {
+        let mut out = Vec::with_capacity(CUT_BYTES as usize);
+        for v in [
+            self.origin.x,
+            self.origin.y,
+            self.origin.z,
+            i32::from(self.enabled),
+        ] {
+            out.extend_from_slice(&v.to_le_bytes());
+        }
+        out.extend_from_slice(bytemuck::cast_slice(&self.bits));
+        out
+    }
+}
+
+/// Registers the volume, its extracts and the render-world upload.
+pub fn plugin(app: &mut App) {
+    app.init_resource::<TerrainCut>()
+        .add_plugins(ExtractResourcePlugin::<TerrainCut>::default())
+        .add_plugins(ExtractResourcePlugin::<TerrainCutBuffer>::default());
+    // A headless build (no GPU) has no render app.
+    if let Some(render_app) = app.get_sub_app_mut(RenderApp) {
+        render_app.add_systems(Render, upload_cut.in_set(RenderSystems::PrepareResources));
+    }
+}
+
+/// Render world: writes the volume into the buffer when the main world changed it.
+fn upload_cut(
+    queue: Res<RenderQueue>,
+    buffer: Option<Res<TerrainCutBuffer>>,
+    cut: Option<Res<TerrainCut>>,
+) {
+    let (Some(buffer), Some(cut)) = (buffer, cut) else {
+        return;
+    };
+    if cut.is_changed() {
+        queue.write_buffer(&buffer.0, 0, &cut.bytes());
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// The shader's indexing (`x + 128 (z + 128 y)`), its bounds and the header's layout.
+    #[test]
+    fn cells_land_where_the_shader_reads_them() {
+        let mut cut = TerrainCut::default();
+        cut.reset(IVec3::new(-64, 10, 200), true);
+        assert!(cut.cut(IVec3::new(-64, 10, 200)));
+        assert!(cut.cut(IVec3::new(-63, 11, 202)));
+        assert!(!cut.cut(IVec3::new(64, 10, 200)), "x past the volume");
+        assert!(!cut.cut(IVec3::new(0, 9, 200)), "y below it");
+        assert!(cut.is_cut(IVec3::new(-63, 11, 202)));
+        assert!(!cut.is_cut(IVec3::new(-62, 11, 202)));
+        let bytes = cut.bytes();
+        assert_eq!(bytes.len() as u64, CUT_BYTES);
+        assert_eq!(
+            &bytes[..16],
+            bytemuck::cast_slice::<i32, u8>(&[-64, 10, 200, 1])
+        );
+        let word = |i: usize| u32::from_le_bytes(bytes[16 + 4 * i..20 + 4 * i].try_into().unwrap());
+        assert_eq!(word(0), 1, "the origin cell is bit 0");
+        let i = 1 + 128 * (2 + 128);
+        assert_eq!(word(i >> 5) >> (i & 31) & 1, 1);
+        // Off, nothing is cut, whatever the bits say.
+        cut.reset(IVec3::ZERO, false);
+        cut.cut(IVec3::ONE);
+        assert!(!cut.is_cut(IVec3::ONE));
+        assert_eq!(&cut.bytes()[12..16], &[0, 0, 0, 0]);
+    }
+
+    /// The WGSL reads the layout this module writes.
+    #[test]
+    fn the_terrain_shader_reads_this_layout() {
+        let src = include_str!("../../benilla-assets/src/shaders/terrain.wgsl");
+        assert!(src.contains("@binding(91) var<storage, read> terrain_cut: TerrainCut;"));
+        assert!(src.contains("let i = u32(c.x + 128 * (c.z + 128 * c.y));"));
+        assert!(src.contains("any(c >= vec3<i32>(128, 64, 128))"));
+    }
+}
