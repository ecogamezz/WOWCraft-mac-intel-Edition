+/// A shadow's half size for an entity `width` wide: Minecraft's shadow radii run about four
+/// fifths of the width (a player 0.6 wide casts 0.5, a cow 0.9 wide 0.7, a spider 1.4 wide 1.0).
+fn shadow_radius(width: f32) -> f32 {
+    (width * 0.8).clamp(0.25, 3.0)
+}
+
+/// How dark a shadow is (Minecraft's `renderShadow`): half at the feet, gone two blocks up and
+/// sixteen blocks from the eye.
+fn shadow_alpha(drop: f32, eye_dist_sq: f32) -> f32 {
+    ((1.0 - drop.max(0.0) / SHADOW_REACH) * 0.5 * (1.0 - eye_dist_sq / 256.0)).clamp(0.0, 1.0)
+}
+
+/// Minecraft's soft round shadow: solid to half its radius, then fading to its edge.
+fn shadow_image() -> Image {
+    const SIDE: u32 = 32;
+    let mut data = Vec::with_capacity((SIDE * SIDE * 4) as usize);
+    for y in 0..SIDE {
+        for x in 0..SIDE {
+            let d = Vec2::new(x as f32 + 0.5, y as f32 + 0.5) / (SIDE as f32 * 0.5) - Vec2::ONE;
+            let a = ((1.0 - d.length()) * 2.0).clamp(0.0, 1.0);
+            data.extend_from_slice(&[0, 0, 0, (a * 255.0).round() as u8]);
         }
     }
+    Image::new(
+        Extent3d { width: SIDE, height: SIDE, depth_or_array_layers: 1 },
+        TextureDimension::D2,
+        data,
+        TextureFormat::Rgba8Unorm,
+        RenderAssetUsages::RENDER_WORLD,
+    )
 }
 
-/// Textured quads on the atlas, built up into one mesh.
+/// A co-op partner's WoW character isn't drawn while their Minecraft body is near it: their
+/// Minecraft drives it there, and the body in the scene is them, as ours is us.
+#[allow(clippy::type_complexity)]
+fn hide_partner_bodies(
+    mut commands: Commands,
+    partners: Res<Partners>,
+    names: Res<NameCache>,
+    mut players: Query<(Entity, &Guid, &NetEntity, Option<&ObjectStore>, &Transform, &mut Visibility, Has<HiddenPartner>), Without<SelfPlayer>>,
+) {
+    for (e, guid, net, store, tf, mut v, hidden) in &mut players {
+        if net.kind != benilla_protocol::EntityKind::Player {
+            continue;
+        }
+        let name = names.peek_unit(guid.0, store).unwrap_or("");
+        if is_partner(&partners.0, name, tf.translation) {
+            if *v != Visibility::Hidden {
+                *v = Visibility::Hidden;
+            }
+            if !hidden {
+                info!("wowcraft: {name}'s WoW character hidden; their Minecraft body is them");
+                commands.entity(e).insert(HiddenPartner);
+            }
+        } else if hidden {
+            *v = Visibility::Inherited;
+            commands.entity(e).remove::<HiddenPartner>();
+        }
+    }
+}
+
+/// Whether a WoW player named `name` at `at` is one of the partners.
+fn is_partner(partners: &[Partner], name: &str, at: Vec3) -> bool {
+    !name.is_empty() && partners.iter().any(|p| p.name.eq_ignore_ascii_case(name) && p.feet.distance(at) <= PARTNER_NEAR)
+}
