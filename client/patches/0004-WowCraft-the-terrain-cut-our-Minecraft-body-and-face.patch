+/// A co-op partner's name, which the mod packs one UTF-16 unit to a float: `ext`, then `uv`, then
+/// `scale`, up to the first 0.
+fn partner_name(e: &WorldEntity) -> String {
+    let floats = e.ext.iter().chain(e.uv.iter().flatten()).chain(std::iter::once(&e.scale));
+    let units: Vec<u16> = floats.map(|&f| f.clamp(0.0, 65535.0) as u16).take_while(|&u| u != 0).collect();
+    String::from_utf16_lossy(&units)
