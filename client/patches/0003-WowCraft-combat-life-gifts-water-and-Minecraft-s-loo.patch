+/// What a GameObject is to Minecraft, by its name.
+pub(crate) fn node_of(name: &str) -> Option<Node> {
+    let n = name.to_ascii_lowercase();
+    if let Some(&(_, kind)) = ORES.iter().find(|(k, _)| n.contains(k)) {
+        return Some(Node { kind, size: [2.0, 1.5, 2.0] });
+    }
+    if let Some(&(_, kind)) = HERBS.iter().find(|(k, _)| n.contains(k)) {
+        return Some(Node { kind, size: [1.0, 1.0, 1.0] });
+    }
+    let station = |kind, size| Some(Node { kind, size });
+    if n.contains("anvil") {
+        return station(28, [1.0, 1.0, 1.0]);
+    }
+    if n.contains("forge") {
+        return station(29, [2.0, 2.0, 2.0]);
+    }
+    if n.contains("cooking") || n.contains("campfire") || n.contains("bonfire") {
+        return station(30, [1.0, 1.0, 1.0]);
+    }
+    if n.contains("mailbox") {
+        return station(31, [1.0, 1.0, 1.0]);
+    }
+    if n.contains("chest") || n.contains("footlocker") || n.contains("strongbox") {
+        return station(32, [1.0, 1.0, 1.0]);
+    }
+    None
+}
+
+/// NPC flags (vmangos `UNIT_NPC_FLAG_*`).
+const NPC_VENDOR: u32 = 0x4;
+const NPC_INNKEEPER: u32 = 0x80;
+/// `UNIT_FLAG_IN_COMBAT`.
+const UNIT_IN_COMBAT: u32 = 0x8_0000;
+/// `UNIT_FLAG_NON_ATTACKABLE`, `UNIT_FLAG_NOT_SELECTABLE`.
+const UNIT_UNHITTABLE: u32 = 0x2 | 0x200_0000;
+
+/// Innkeepers and general goods vendors trade blocks.
+fn is_trader(npc_flags: u32, subname: Option<&str>) -> bool {
+    if npc_flags & NPC_INNKEEPER != 0 {
+        return true;
+    }
+    npc_flags & NPC_VENDOR != 0
+        && subname.is_some_and(|s| {
+            let s = s.to_ascii_lowercase();
+            s.contains("general") || s.contains("goods") || s.contains("supplies")
+        })
+}
+
+/// A name as the record's 24 bytes, cut on a character boundary.
+fn name_bytes(name: &str) -> [u8; 24] {
+    let mut out = [0u8; 24];
+    let mut end = name.len().min(23);
+    while !name.is_char_boundary(end) {
+        end -= 1;
+    }
+    out[..end].copy_from_slice(&name.as_bytes()[..end]);
+    out
+}
