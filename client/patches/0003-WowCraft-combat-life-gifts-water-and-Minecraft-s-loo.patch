index 00000000..6bac4985
--- /dev/null
+++ b/crates/benilla-app/src/wowcraft/water.rs
@@ -0,0 +1,90 @@
+//! WoW's water as Minecraft's: the surface over each column of a 16×16 grid round our feet, so
+//! Minecraft's player swims in WoW's lakes and seas (and its boats float there) and burns in its
+//! lava. The mod fills air below a column's surface with its fluid; lava is told apart by a
+//! surface raised by [`LAVA_OFFSET`], as the mod reads it.
+
+use bevy::prelude::*;
+
+use benilla_assets::coords::bevy_to_wow;
+use benilla_formats::LiquidKind;
+use benilla_world::world_point::{Subject, WorldPoint};
+
+use wowcraft_link::proto::*;
+
+use super::WowCraft;
+use crate::player::Player;
+
+/// The mod's `SkyWater.LAVA_OFFSET`.
+const LAVA_OFFSET: f32 = 100_000.0;
+/// How often the grid is sampled again while we stand in one block.
+const PERIOD: f32 = 0.25;
+
+pub(crate) fn plugin(app: &mut App) {
+    app.add_systems(PostUpdate, publish_water);
+}
+
+/// One column's entry: the surface's Minecraft y, lava raised, or none.
+pub(crate) fn column(surface_y: Option<f32>, kind: Option<LiquidKind>) -> f32 {
+    match (surface_y, kind) {
+        (Some(y), Some(LiquidKind::Magma)) => y + LAVA_OFFSET,
+        (Some(y), _) => y,
+        (None, _) => NO_WATER,
+    }
+}
+
+fn publish_water(
+    wc: Res<WowCraft>,
+    player: Res<Player>,
+    world: WorldPoint,
+    time: Res<Time>,
+    mut last: Local<Option<(IVec2, u32)>>,
+    mut next: Local<f32>,
+) {
+    if !player.active || !wc.mc_in_world() {
+        *last = None;
+        return;
+    }
+    let feet = player.pos;
+    let origin = IVec2::new(feet.x.floor() as i32 - 8, feet.z.floor() as i32 - 8);
+    let now = time.elapsed_secs();
+    if *last == Some((origin, wc.world_id())) && now < *next {
+        return;
+    }
+    *next = now + PERIOD;
+    let mut grid = WaterGrid {
+        seq: 0,
+        origin_x: origin.x,
+        origin_z: origin.y,
+        world_id: wc.world_id(),
+        surface: [NO_WATER; WATER_GRID_SIZE * WATER_GRID_SIZE],
+    };
+    for dz in 0..WATER_GRID_SIZE {
+        for dx in 0..WATER_GRID_SIZE {
+            // The column's centre, asked at our feet's height: a building's pool answers only on
+            // its own floor.
+            let at = Vec3::new(origin.x as f32 + dx as f32 + 0.5, feet.y, origin.y as f32 + dz as f32 + 0.5);
+            let wow = bevy_to_wow(at);
+            let hit = world.liquid_at(Subject::Player, wow);
+            // A whole flooded room answers with no surface of its own: it's over our head.
+            let surface = hit.map(|h| if h.surface_z == f32::MAX { feet.y + 3.0 } else { at.y + (h.surface_z - wow[2]) });
+            grid.surface[dz * WATER_GRID_SIZE + dx] = column(surface, hit.map(|h| h.kind));
+        }
+    }
+    wc.link.write_water_grid(&grid);
+    *last = Some((origin, wc.world_id()));
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn columns_as_the_mod_reads_them() {
+        assert_eq!(column(None, None), NO_WATER);
+        assert_eq!(column(Some(12.5), Some(LiquidKind::Still)), 12.5);
+        assert_eq!(column(Some(12.5), Some(LiquidKind::Ocean)), 12.5);
+        // The mod reads anything over 50000 as lava, 100000 lower.
+        let lava = column(Some(-3.0), Some(LiquidKind::Magma));
+        assert!(lava > 50_000.0 && (lava - LAVA_OFFSET + 3.0).abs() < 1e-3);
+    }
+}
