+//! Fighting WoW's creatures with Minecraft's weapons, both ways:
+//! - every unit near us goes to Minecraft's actor table (20 times a second) as a hittable stand-in,
+//!   friendly ones unhittable and innkeepers and general goods vendors as block traders;
+//! - a Minecraft hit on one (`EV_HIT_ACTOR`) selects it and deals WoW damage by GM `.damage`,
+//!   scaled by its level and health, and WoW's own auto-attack is stopped, so the swing is
+//!   Minecraft's;
+//! - whatever WoW hits us for (melee, spells, their ticks, lava, fire) hurts Minecraft's player
+//!   (`IN_HURT`), scaled to our health: Minecraft's hearts are our life ([`super::life`]);
+//! - ore veins, herbs, anvils, forges, cooking fires, mailboxes and chests are nodes Minecraft
+//!   places as its own blocks; one mined there is hidden here a while (`EV_ORE_MINED`);
+//! - a creature we fought that dies drops Minecraft loot where it fell.
+
+use std::collections::{HashMap, HashSet};
+
+use benilla_protocol::guid;
+use benilla_protocol::messages::PeriodicTick;
+use benilla_protocol::{SessionEvent, SessionEventKind};
+use bevy::prelude::*;
+
+use wowcraft_link::proto::*;
+
+use super::WowCraft;
+use crate::char_select::ClientState;
+use crate::entities::CollisionHeight;
+use crate::names::NameCache;
+use crate::net::{ClientCommand, Guid, GuidIndex, NetCommands, NetHandlerApp, ObjectStore, Reputations, SelfGuid, SelfPlayer};
+use crate::player::Player;
+
+/// How far round us units and nodes go to Minecraft (its stand-ins live in loaded chunks only).
+const ACTOR_RANGE: f32 = 64.0;
+/// The table's refresh: Minecraft's own tick.
+const ACTOR_PERIOD: f32 = 0.05;
+/// A node mined in Minecraft stays hidden here, and out of the table, this long.
+const TAKEN_SECS: f32 = 300.0;
+/// A unit we hit counts as our fight this long: its death is our kill.
+const FIGHT_SECS: f32 = 60.0;
+
+pub(crate) fn plugin(app: &mut App) {
+    use SessionEventKind as K;
+    app.init_resource::<FormIds>()
+        .init_resource::<Fights>()
+        .add_systems(
+            Update,
+            (publish_actors, apply_hits, kill_loot).chain().run_if(in_world),
+        )
+        .add_systems(PostUpdate, hide_taken_nodes.before(bevy::camera::visibility::VisibilitySystems::VisibilityPropagate))
+        .net_handler(K::AttackerState, on_attacker_state)
+        .net_handler(K::SpellDamageLog, on_spell_damage)
+        .net_handler(K::PeriodicAuraLog, on_periodic_damage)
+        .net_handler(K::EnvironmentalDamageLog, on_environmental_damage)
+        .net_handler(K::AttackStart, on_attack_start);
+}
+
+fn in_world(state: Res<State<ClientState>>, wc: Res<WowCraft>) -> bool {
+    *state.get() == ClientState::InWorld && wc.mc_in_world()
+}
+
+/// The ids Minecraft knows our units and nodes by: a guid is 64 bits, a form id 32. Never 0,
+/// which is "no attacker".
+#[derive(Resource, Default)]
+pub(crate) struct FormIds {
+    by_guid: HashMap<u64, u32>,
+    by_id: HashMap<u32, u64>,
+    next: u32,
+}
+
+impl FormIds {
+    pub(crate) fn id(&mut self, guid: u64) -> u32 {
+        if let Some(&id) = self.by_guid.get(&guid) {
+            return id;
+        }
+        self.next = self.next.wrapping_add(1).max(1);
+        let id = self.next;
+        self.by_guid.insert(guid, id);
+        self.by_id.insert(id, guid);
+        id
+    }
+
+    pub(crate) fn peek(&self, guid: u64) -> Option<u32> {
+        self.by_guid.get(&guid).copied()
+    }
+
+    pub(crate) fn guid(&self, id: u32) -> Option<u64> {
+        self.by_id.get(&id).copied()
+    }
+}
+
+/// Who we've been fighting, and which nodes Minecraft has taken.
+#[derive(Resource, Default)]
+pub(crate) struct Fights {
+    /// Guid to when we last hit it.
+    hit: HashMap<u64, f32>,
+    /// Kills already looted.
+    looted: HashSet<u64>,
+    /// WoW's word that we killed these (an XP award names the victim).
+    pub(crate) kills: Vec<u64>,
+    /// Node guid to when it comes back.
+    taken: HashMap<u64, f32>,
+}
