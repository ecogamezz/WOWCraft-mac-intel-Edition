+/// Minecraft's view: its field of view (sprinting and water change it), and WoW's longest view
+/// distance once Minecraft flies, as an elytra climbs past where WoW's ground view reaches.
+fn follow_minecraft_view(
+    drive: Res<Drive>,
+    mut cameras: Query<&mut Projection, With<benilla_world::view::WorldCamera>>,
+    mut cvars: ResMut<crate::cvars::Cvars>,
+    mut far: Local<bool>,
+) {
+    if !drive.active {
+        return;
+    }
+    let fov = drive.fov_deg.clamp(30.0, 130.0).to_radians();
+    for mut projection in &mut cameras {
+        if let Projection::Perspective(p) = &*projection {
+            if (p.fov - fov).abs() > 1e-4 {
+                if let Projection::Perspective(p) = &mut *projection {
+                    p.fov = fov;
+                }
+            }
+        }
+    }
+    if drive.flying && !*far {
+        info!("wowcraft: view distance 500 (farclip) for flying");
+        let _ = cvars.set("farclip", "500");
+        *far = true;
+    }
+}
