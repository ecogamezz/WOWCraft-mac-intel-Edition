+/// Minecraft's hits and mined nodes.
+fn apply_hits(
+    wc: Res<WowCraft>,
+    ids: Res<FormIds>,
+    index: Res<GuidIndex>,
+    stores: Query<&ObjectStore>,
+    names: Res<NameCache>,
+    mut select: crate::target::SelectCommit,
+    gm: Gm,
+    mut fights: ResMut<Fights>,
+    time: Res<Time>,
+) {
+    let now = time.elapsed_secs();
+    let mut hits: Vec<(u64, f32)> = Vec::new();
+    for e in &wc.events {
+        match e.kind {
+            EV_HIT_ACTOR if e.a > 0.0 => {
+                let Some(g) = ids.guid(e.form_id) else { continue };
+                match hits.iter_mut().find(|(h, _)| *h == g) {
+                    Some(h) => h.1 += e.a,
+                    None => hits.push((g, e.a)),
+                }
+            }
+            EV_ORE_MINED => {
+                if let Some(g) = ids.guid(e.form_id) {
+                    info!("wowcraft: node {g:#x} taken in Minecraft; hidden here for {TAKEN_SECS:.0} s");
+                    fights.taken.insert(g, now + TAKEN_SECS);
+                }
+            }
+            _ => {}
+        }
+    }
+    for (g, mc) in hits {
+        let Some(store) = index.0.get(&g).and_then(|&e| stores.get(e).ok()) else { continue };
+        if store.0.unit_is_dead() {
+            continue;
+        }
+        let level = store.0.unit_level().unwrap_or(1);
+        let damage = wow_damage(mc, level, store.0.unit_max_health().unwrap_or(1));
+        let name = names.peek_unit(g, Some(store)).unwrap_or("?");
+        info!("wowcraft: hit {name} for {mc:.1} Minecraft -> {damage}");
+        select.select_unit(g);
+        gm.say(&format!(".damage {damage}"));
+        fights.hit.insert(g, now);
+    }
+    fights.taken.retain(|_, until| now < *until);
+}
+
+/// Our kills drop Minecraft loot where they fell.
+fn kill_loot(
+    wc: Res<WowCraft>,
+    index: Res<GuidIndex>,
+    units: Query<(&ObjectStore, &GlobalTransform)>,
+    names: Res<NameCache>,
+    mut fights: ResMut<Fights>,
+    time: Res<Time>,
+) {
+    let now = time.elapsed_secs();
+    let mut dead: Vec<u64> = std::mem::take(&mut fights.kills);
+    for (&g, &when) in &fights.hit {
+        if now - when > FIGHT_SECS {
+            continue;
+        }
+        if index.0.get(&g).and_then(|&e| units.get(e).ok()).is_some_and(|(s, _)| s.0.unit_is_dead()) {
+            dead.push(g);
+        }
+    }
+    for g in dead {
+        if !fights.looted.insert(g) {
+            continue;
+        }
+        fights.hit.remove(&g);
+        let Some((store, at)) = index.0.get(&g).and_then(|&e| units.get(e).ok()) else { continue };
+        let entry = store.0.object_entry().unwrap_or(0);
+        let name = names.peek_unit(g, Some(store)).unwrap_or("?").to_string();
+        let ctype = names.creature_type(entry).unwrap_or(0);
+        let level = store.0.unit_level().unwrap_or(1);
+        let loot = loot_for(&name, ctype, level, g);
+        let pos = at.translation() + Vec3::Y * 0.5;
+        let list: Vec<String> = loot.iter().map(|(i, n)| format!("{n} {}", super::gifts::TABLE[*i as usize])).collect();
+        info!("wowcraft: killed {name} (level {level}); Minecraft loot: {}", list.join(", "));
+        for (item, count) in loot {
+            super::gifts::drop_at(&wc.link, item, count, pos);
+        }
+    }
+    fights.hit.retain(|_, when| now - *when <= FIGHT_SECS);
+    if fights.looted.len() > 4096 {
+        fights.looted.clear();
+    }
+}
+
+/// What a creature drops in Minecraft: by its kind and name, emeralds more likely as it levels.
+/// `seed` makes it the same every time for the one creature.
+pub(crate) fn loot_for(name: &str, creature_type: u32, level: u32, seed: u64) -> Vec<(u8, u8)> {
+    use super::gifts::item;
+    let n = name.to_ascii_lowercase();
+    let has = |words: &[&str]| words.iter().any(|w| n.contains(w));
+    let roll = |salt: u64| (seed.wrapping_mul(0x9E37_79B9_7F4A_7C15).wrapping_add(salt.wrapping_mul(0xBF58_476D_1CE4_E5B9)) >> 33) % 100;
+    let mut out: Vec<(u8, u8)> = Vec::new();
+    match creature_type {
+        // Beast and critter: their meat, by what they are.
+        1 | 8 => {
+            let count = if creature_type == 8 { 1 } else { 1 + (roll(1) % 2) as u8 };
+            if has(&["boar", "pig", "swine", "hog"]) {
+                out.push((item("porkchop"), count));
+            } else if has(&["chicken", "hen", "rooster", "owl", "hawk", "vulture", "condor", "buzzard", "carrion", "bird", "parrot", "turkey"]) {
+                out.push((item("chicken"), count));
+                out.push((item("feather"), 1 + (roll(2) % 3) as u8));
+            } else if has(&["rabbit", "hare"]) {
+                out.push((item("rabbit"), count));
+            } else if has(&["sheep", "ram", "goat", "mountain"]) && !has(&["lion"]) {
+                out.push((item("mutton"), count));
+            } else if has(&["crab", "turtle", "crocolisk", "fish", "shark", "eel", "makrura", "clam"]) {
+                out.push((item(if roll(3) < 50 { "cod" } else { "salmon" }), count));
+            } else if has(&["spider", "widow", "tarantula", "crawler", "lurker", "creeper"]) {
+                out.push((item("string"), 1 + (roll(4) % 3) as u8));
+                if roll(5) < 40 {
+                    out.push((item("spider_eye"), 1));
+                }
+            } else if has(&["scorpid", "scorpion", "silithid", "wasp", "bug", "beetle"]) {
+                out.push((item("string"), 1));
+            } else if has(&["ooze", "slime", "jelly"]) {
+                out.push((item("slime_ball"), 1 + (roll(6) % 2) as u8));
+            } else if creature_type == 1 {
+                out.push((item("beef"), count));
+            }
+            if creature_type == 1 && roll(7) < 50 {
+                out.push((item("leather"), 1));
+            }
+        }
+        // Dragonkin.
+        2 => {
+            out.push((item("gold_nugget"), 2 + (roll(1) % 4) as u8));
+            if roll(2) < 15 {
+                out.push((item("ender_pearl"), 1));
+            }
+        }
+        // Demon.
+        3 => out.push((item("blaze_powder"), 1 + (roll(1) % 2) as u8)),
+        // Elemental.
+        4 => {
+            let dust = match roll(1) % 3 {
+                0 => "redstone",
+                1 => "glowstone_dust",
+                _ => "gunpowder",
+            };
+            out.push((item(dust), 1 + (roll(2) % 3) as u8));
+            if has(&["ooze", "slime", "sludge"]) {
+                out.push((item("slime_ball"), 1));
+            }
+        }
+        // Giant.
+        5 => {
+            out.push((item("bone"), 2 + (roll(1) % 3) as u8));
+            out.push((item("iron_ingot"), 1));
+        }
+        // Undead.
+        6 => {
+            out.push((item("rotten_flesh"), 1 + (roll(1) % 2) as u8));
+            if roll(2) < 60 {
+                out.push((item("bone"), 1 + (roll(3) % 2) as u8));
+            }
+        }
+        // Humanoid.
+        7 => {
+            if has(&["murloc", "naga", "makrura"]) {
+                out.push((item(if roll(1) < 50 { "cod" } else { "salmon" }), 1));
+            } else if has(&["kobold", "miner", "tunneler"]) {
+                out.push((item("torch"), 1 + (roll(1) % 3) as u8));
+            } else if roll(1) < 35 {
+                out.push((item("bread"), 1));
+            }
+            if roll(2) < 40 {
+                out.push((item("iron_nugget"), 1 + (roll(3) % 3) as u8));
+            }
+            if has(&["archer", "hunter", "ranger", "tracker", "scout", "poacher"]) {
+                out.push((item("arrow"), 2 + (roll(4) % 5) as u8));
+            }
+        }
+        // Mechanical.
+        9 => {
+            out.push((item("iron_nugget"), 2 + (roll(1) % 4) as u8));
+            if roll(2) < 30 {
+                out.push((item("redstone"), 1));
+            }
+        }
+        _ => {}
+    }
+    // Emeralds: one in five at level 1, most of the time by 60.
+    let emerald_chance = 20 + level.min(60) as u64;
+    if creature_type != 8 && roll(9) < emerald_chance {
+        out.push((item("emerald"), 1 + (level / 25) as u8));
+    }
+    out
+}
+
+/// The share of our health a WoW hit takes, onto Minecraft's player.
+fn hurt(wc: &WowCraft, me: Option<&ObjectStore>, kind: u16, wow: u32, attacker: u32, flags: i32) {
+    if !wc.mc_in_world() || wow == 0 {
+        return;
+    }
+    let (max, level) = me.map_or((100, 1), |s| (s.0.unit_max_health().unwrap_or(100), s.0.unit_level().unwrap_or(1)));
+    let mc = mc_damage(wow, max, level);
+    let amount = hurt_amount(mc);
+    if amount <= 0 {
+        return;
+    }
+    debug!("wowcraft: WoW hit us for {wow} of {max}: {mc:.2} Minecraft");
+    wc.link.push_input(IN_HURT, kind, amount, attacker as i32, flags);
+}
+
+/// `HITINFO_CRITICALHIT`: a crit knocks Minecraft's player back.
+const HITINFO_CRITICAL: u32 = 0x80;
+const HURT_KNOCKBACK: i32 = 2;
+
+fn on_attacker_state(
+    In(ev): In<SessionEvent>,
+    wc: Res<WowCraft>,
+    self_guid: Res<SelfGuid>,
+    ids: Res<FormIds>,
+    me: Query<&ObjectStore, With<SelfPlayer>>,
+) {
+    let SessionEvent::AttackerState(s) = ev else { return };
+    if Some(s.victim) != self_guid.0 || s.attacker == s.victim {
+        return;
+    }
+    let flags = if s.hit_info & HITINFO_CRITICAL != 0 { HURT_KNOCKBACK } else { 0 };
+    hurt(&wc, me.single().ok(), HURT_MELEE, s.damage, ids.peek(s.attacker).unwrap_or(0), flags);
+}
+
+fn on_spell_damage(
+    In(ev): In<SessionEvent>,
+    wc: Res<WowCraft>,
+    self_guid: Res<SelfGuid>,
+    ids: Res<FormIds>,
+    me: Query<&ObjectStore, With<SelfPlayer>>,
+) {
+    let SessionEvent::SpellDamageLog(s) = ev else { return };
+    if Some(s.target) != self_guid.0 || s.attacker == s.target {
+        return;
+    }
+    // Physical school is a shot or a throw; anything else is magic.
+    let kind = if s.school == 0 { HURT_PROJECTILE } else { HURT_MAGIC };
+    hurt(&wc, me.single().ok(), kind, s.damage, ids.peek(s.attacker).unwrap_or(0), 0);
+}
+
+fn on_periodic_damage(
+    In(ev): In<SessionEvent>,
+    wc: Res<WowCraft>,
+    self_guid: Res<SelfGuid>,
+    ids: Res<FormIds>,
+    me: Query<&ObjectStore, With<SelfPlayer>>,
+) {
+    let SessionEvent::PeriodicAuraLog(s) = ev else { return };
+    if Some(s.target) != self_guid.0 || s.caster == s.target {
+        return;
+    }
+    let attacker = ids.peek(s.caster).unwrap_or(0);
+    for tick in &s.ticks {
+        if let PeriodicTick::Damage { amount, .. } = tick {
+            hurt(&wc, me.single().ok(), HURT_MAGIC, *amount, attacker, 0);
+        }
+    }
+}
+
+/// Lava, slime, fire and fatigue hurt; falling and drowning are Minecraft's own.
+fn on_environmental_damage(
+    In(ev): In<SessionEvent>,
+    wc: Res<WowCraft>,
+    self_guid: Res<SelfGuid>,
+    me: Query<&ObjectStore, With<SelfPlayer>>,
+) {
+    let SessionEvent::EnvironmentalDamageLog(e) = ev else { return };
+    if Some(e.victim) != self_guid.0 {
+        return;
+    }
+    // 0 fatigue, 1 drowning, 2 falling, 3 lava, 4 slime, 5 fire.
+    if matches!(e.damage_type, 1 | 2) {
+        return;
+    }
+    hurt(&wc, me.single().ok(), HURT_OTHER, e.damage, 0, 0);
+}
+
+/// Our swings are Minecraft's: WoW's auto-attack, started by a click with WoW's cursor or a key,
+/// is stopped.
+fn on_attack_start(
+    In(ev): In<SessionEvent>,
+    wc: Res<WowCraft>,
+    self_guid: Res<SelfGuid>,
+    index: Res<GuidIndex>,
+    stores: Query<&ObjectStore>,
+    names: Res<NameCache>,
+    gm: Gm,
+) {
+    let SessionEvent::AttackStart { attacker, victim } = ev else { return };
+    if Some(attacker) != self_guid.0 || !wc.mc_in_world() {
+        return;
+    }
+    let store = index.0.get(&victim).and_then(|&e| stores.get(e).ok());
+    let name = names.peek_unit(victim, store).unwrap_or("?");
+    info!("wowcraft: stopping WoW's auto-attack on {name}");
+    gm.send(ClientCommand::AttackStop);
+}
