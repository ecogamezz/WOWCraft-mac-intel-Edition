+/// Minecraft's loose things, from its world entity table each frame: dropped items (as sprites
+/// facing us, or little cubes for blocks), arrows, a block being mined's cracks, the fishing line,
+/// and the outline of the block Minecraft's crosshair is on, which its own frame (the overlay)
+/// doesn't draw.
+#[allow(clippy::too_many_arguments)]
+fn draw_world_entities(
+    wc: Res<WowCraft>,
+    mut scene: ResMut<Scene>,
+    mut commands: Commands,
+    mut meshes: ResMut<Assets<Mesh>>,
+    mut materials: ResMut<Assets<StandardMaterial>>,
+    camera: Query<&GlobalTransform, With<benilla_world::view::WorldCamera>>,
+    mut visibility: Query<&mut Visibility>,
+    mut gizmos: Gizmos,
+) {
+    let table = if wc.mc_in_world() { wc.link.read_world_entities() } else { None };
+    let Some((header, list)) = table else {
+        if let Some((e, _)) = scene.loose {
+            if let Ok(mut v) = visibility.get_mut(e) {
+                *v = Visibility::Hidden;
+            }
+        }
+        return;
+    };
+    if header.has_selection != 0 {
+        let (lo, hi) = (Vec3::from(header.sel_min), Vec3::from(header.sel_max));
+        let t = Transform::from_translation((lo + hi) * 0.5).with_scale(hi - lo + Vec3::splat(0.004));
+        gizmos.cube(t, Color::srgba(0.0, 0.0, 0.0, 0.7));
+    }
+    let eye = camera.single().map(|t| t.translation()).unwrap_or(Vec3::ZERO);
+    let mut quads = Quads::default();
+    for e in &list {
+        let p = Vec3::from(e.pos);
+        match e.kind {
+            WE_ITEM => {
+                let h = e.scale.max(0.1) * 0.5;
+                let mut to_eye = eye - p;
+                to_eye.y = 0.0;
+                let right = Vec3::Y.cross(to_eye.normalize_or(Vec3::Z)).normalize_or(Vec3::X) * h;
+                let up = Vec3::Y * h;
+                quads.push([p - right + up, p + right + up, p + right - up, p - right - up], e.uv[0]);
+            }
+            WE_BLOCK => {
+                let h = e.scale.max(0.05) * 0.5;
+                let rot = Quat::from_rotation_y((-e.yaw).to_radians());
+                // Faces: north's sprite round the sides, then up and down.
+                quads.cube(p, Vec3::splat(h), rot, [e.uv[0], e.uv[1], e.uv[2]]);
+            }
+            WE_CRACK => {
+                let ext = Vec3::from(e.ext);
+                quads.cube(p + ext * 0.5, ext * 0.5, Quat::IDENTITY, [e.uv[0]; 3]);
+            }
+            WE_ARROW | WE_TRIDENT => {
+                let (yaw, pitch) = (e.yaw.to_radians(), e.pitch.to_radians());
+                let d = Vec3::new(-yaw.sin() * pitch.cos(), -pitch.sin(), yaw.cos() * pitch.cos()).normalize_or(Vec3::Z);
+                let side = d.cross(Vec3::Y).normalize_or(Vec3::X);
+                let up = side.cross(d);
+                let (half, w) = (0.25 * e.scale.max(0.5), 0.06);
+                let (a, b) = (p - d * half, p + d * half);
+                quads.push([a + up * w, b + up * w, b - up * w, a - up * w], e.uv[0]);
+                quads.push([a + side * w, b + side * w, b - side * w, a - side * w], e.uv[0]);
+            }
+            WE_LINE => gizmos.line(p, Vec3::from(e.ext), Color::srgba(0.1, 0.1, 0.1, 0.8)),
+            _ => {}
+        }
+    }
+    let mesh = quads.mesh();
+    match scene.loose.clone() {
+        Some((e, handle)) => {
+            let _ = meshes.insert(&handle, mesh);
+            if let Ok(mut v) = visibility.get_mut(e) {
+                let want = if quads.is_empty() { Visibility::Hidden } else { Visibility::Visible };
+                if *v != want {
+                    *v = want;
+                }
+            }
+        }
+        None => {
+            let handle = meshes.add(mesh);
+            let mat = material(&mut scene, &mut materials, Look { texture: 0, translucent: false });
+            let e = commands.spawn((Name::new("wowcraft loose things"), Mesh3d(handle.clone()), MeshMaterial3d(mat), Transform::default())).id();
+            scene.loose = Some((e, handle));
+        }
+    }
+}
+
+/// Textured quads on the atlas, built up into one mesh.
+#[derive(Default)]
+struct Quads {
+    pos: Vec<[f32; 3]>,
+    uv: Vec<[f32; 2]>,
+    nrm: Vec<[f32; 3]>,
+}
+
+impl Quads {
+    fn is_empty(&self) -> bool {
+        self.pos.is_empty()
+    }
+
+    /// Corners from the top left, clockwise as seen; `rect` is the sprite's u0, v0, u1, v1.
+    fn push(&mut self, c: [Vec3; 4], rect: [f32; 4]) {
+        let [u0, v0, u1, v1] = rect;
+        let uv = [[u0, v0], [u1, v0], [u1, v1], [u0, v1]];
+        let n = (c[1] - c[0]).cross(c[3] - c[0]).normalize_or(Vec3::Y).to_array();
+        for i in [0, 1, 2, 0, 2, 3] {
+            self.pos.push(c[i].to_array());
+            self.uv.push(uv[i]);
+            self.nrm.push(n);
+        }
+    }
+
+    /// A box round `centre`: the sides take `faces[0]`, the top `faces[1]`, the bottom `faces[2]`.
+    fn cube(&mut self, centre: Vec3, half: Vec3, rot: Quat, faces: [[f32; 4]; 3]) {
+        let at = |x: f32, y: f32, z: f32| centre + rot * Vec3::new(x * half.x, y * half.y, z * half.z);
+        // North, east, south, west, each from its top left seen from outside.
+        self.push([at(1.0, 1.0, -1.0), at(-1.0, 1.0, -1.0), at(-1.0, -1.0, -1.0), at(1.0, -1.0, -1.0)], faces[0]);
+        self.push([at(1.0, 1.0, 1.0), at(1.0, 1.0, -1.0), at(1.0, -1.0, -1.0), at(1.0, -1.0, 1.0)], faces[0]);
+        self.push([at(-1.0, 1.0, 1.0), at(1.0, 1.0, 1.0), at(1.0, -1.0, 1.0), at(-1.0, -1.0, 1.0)], faces[0]);
+        self.push([at(-1.0, 1.0, -1.0), at(-1.0, 1.0, 1.0), at(-1.0, -1.0, 1.0), at(-1.0, -1.0, -1.0)], faces[0]);
+        self.push([at(-1.0, 1.0, -1.0), at(1.0, 1.0, -1.0), at(1.0, 1.0, 1.0), at(-1.0, 1.0, 1.0)], faces[1]);
+        self.push([at(-1.0, -1.0, 1.0), at(1.0, -1.0, 1.0), at(1.0, -1.0, -1.0), at(-1.0, -1.0, -1.0)], faces[2]);
+    }
+
+    fn mesh(&self) -> Mesh {
+        let n = self.pos.len();
+        Mesh::new(PrimitiveTopology::TriangleList, RenderAssetUsages::RENDER_WORLD)
+            .with_inserted_attribute(Mesh::ATTRIBUTE_POSITION, self.pos.clone())
+            .with_inserted_attribute(Mesh::ATTRIBUTE_NORMAL, self.nrm.clone())
+            .with_inserted_attribute(Mesh::ATTRIBUTE_UV_0, self.uv.clone())
+            .with_inserted_attribute(Mesh::ATTRIBUTE_COLOR, vec![[0.9f32, 0.9, 0.9, 1.0]; n])
+    }
+}
