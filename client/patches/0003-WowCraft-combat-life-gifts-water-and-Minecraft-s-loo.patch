+/// Nodes Minecraft took stay hidden here until they're back.
+fn hide_taken_nodes(
+    fights: Res<Fights>,
+    index: Res<GuidIndex>,
+    mut shown: Query<&mut Visibility>,
+    time: Res<Time>,
+) {
+    let now = time.elapsed_secs();
+    for (g, &until) in &fights.taken {
+        if now >= until {
+            continue;
+        }
+        if let Some(mut v) = index.0.get(g).and_then(|&e| shown.get_mut(e).ok()) {
+            if *v != Visibility::Hidden {
+                *v = Visibility::Hidden;
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn nodes_by_name() {
+        assert_eq!(node_of("Copper Vein").map(|n| n.kind), Some(0));
+        assert_eq!(node_of("Ooze Covered Silver Vein").map(|n| n.kind), Some(3));
+        assert_eq!(node_of("Small Thorium Vein").map(|n| n.kind), Some(7));
+        assert_eq!(node_of("Peacebloom").map(|n| n.kind), Some(13));
+        assert_eq!(node_of("Arthas' Tears").map(|n| n.kind), Some(21));
+        assert_eq!(node_of("Anvil").map(|n| n.kind), Some(28));
+        assert_eq!(node_of("Battered Chest").map(|n| n.kind), Some(32));
+        assert_eq!(node_of("Wanted Poster"), None);
+        // Every kind is one the mod has (0..=39).
+        for (_, k) in ORES.iter().chain(HERBS) {
+            assert!(*k < 40);
+        }
+    }
+
+    #[test]
+    fn traders() {
+        assert!(is_trader(NPC_INNKEEPER, None));
+        assert!(is_trader(NPC_VENDOR, Some("General Goods")));
+        assert!(is_trader(NPC_VENDOR | 1, Some("Trade Supplies")));
+        assert!(!is_trader(NPC_VENDOR, Some("Weaponsmith")));
+        assert!(!is_trader(0, Some("General Goods")));
+    }
+
+    #[test]
+    fn damage_both_ways() {
+        // A wooden sword (4) on a level-1 boar of 42: about three hits.
+        let d = wow_damage(4.0, 1, 42);
+        assert!((12..=16).contains(&d), "{d}");
+        // A stone sword (5) on a level-10 wolf of 200: four or five.
+        let d = wow_damage(5.0, 10, 200);
+        assert!(200 / d >= 3 && 200 / d <= 5, "{d}");
+        // Netherite (8) on a level-60 elite of 20000 still lands real hits.
+        assert!(wow_damage(8.0, 60, 20000) >= 4000);
+        assert_eq!(wow_damage(0.0, 10, 200), 0);
+        // A hit for a tenth of our health at level 1: a little over two half hearts.
+        let mc = mc_damage(10, 100, 1);
+        assert!((2.5..2.7).contains(&mc), "{mc}");
+        // The mod divides by a hundred, then by five.
+        assert_eq!(hurt_amount(2.0), 1000);
+    }
+
+    #[test]
+    fn names_fit_the_record() {
+        let n = name_bytes("Defias Pillager");
+        assert_eq!(&n[..15], b"Defias Pillager");
+        assert_eq!(n[15], 0);
+        let long = name_bytes("Ragnaros the Firelord of Molten Core");
+        assert_eq!(long[23], 0);
+        // A multi-byte character isn't split.
+        let s = "ééééééééééééé"; // 26 bytes
+        let b = name_bytes(s);
+        assert!(std::str::from_utf8(&b[..b.iter().position(|&c| c == 0).unwrap()]).is_ok());
+    }
+
+    #[test]
+    fn loot_by_kind() {
+        let boar = loot_for("Mottled Boar", 1, 2, 7);
+        assert!(boar.iter().any(|(i, _)| super::super::gifts::TABLE[*i as usize] == "porkchop"));
+        let skeleton = loot_for("Rattlecage Skeleton", 6, 5, 9);
+        assert!(skeleton.iter().any(|(i, _)| super::super::gifts::TABLE[*i as usize] == "rotten_flesh"));
+        // The same creature drops the same.
+        assert_eq!(loot_for("Kobold Miner", 7, 3, 42), loot_for("Kobold Miner", 7, 3, 42));
+    }
+
+    #[test]
+    fn form_ids_are_stable_and_never_zero() {
+        let mut ids = FormIds::default();
+        let a = ids.id(0xF130_0000_0000_0001);
+        let b = ids.id(0xF130_0000_0000_0002);
+        assert_ne!(a, 0);
+        assert_ne!(a, b);
+        assert_eq!(ids.id(0xF130_0000_0000_0001), a);
+        assert_eq!(ids.guid(b), Some(0xF130_0000_0000_0002));
+    }
+}
diff --git a/crates/benilla-app/src/wowcraft/gifts.rs b/crates/benilla-app/src/wowcraft/gifts.rs
new file mode 100644
index 00000000..afe2b390
--- /dev/null
+++ b/crates/benilla-app/src/wowcraft/gifts.rs
@@ -0,0 +1,234 @@
+//! What WoW gives, Minecraft gets:
+//! - each WoW character has its own Minecraft inventory: `IN_CHARACTER` tells the mod whose
+//!   things Minecraft's player holds, on entering the world and whenever Minecraft comes back;
+//! - a finished quest gives emeralds (its money), a piece of gear for our level (enchanted as we
+//!   go up), food and experience;
+//! - experience WoW awards turns up as Minecraft experience, as orbs where the kill fell.
+//!
+//! Items cross as indexes into the mod's `WowGifts.TABLE` ([`TABLE`]).
+
+use benilla_protocol::{SessionEvent, SessionEventKind};
+use bevy::prelude::*;
+
+use wowcraft_link::proto::*;
+use wowcraft_link::Link;
+
+use super::WowCraft;
+use crate::char_select::ClientState;
+use crate::net::{GuidIndex, NetHandlerApp, ObjectStore, SelfGuid, SelfPlayer};
+
+/// The mod's `WowGifts.TABLE`, in its order: index 0 is experience points.
+pub(crate) const TABLE: &[&str] = &[
+    "experience", "beef", "porkchop", "mutton", "chicken", "rabbit", "cod", "salmon", "cooked_beef",
+    "cooked_porkchop", "cooked_mutton", "cooked_chicken", "cooked_rabbit", "cooked_cod",
+    "cooked_salmon", "emerald", "bread", "golden_apple", "golden_carrot", "stone_sword",
+    "iron_sword", "diamond_sword", "netherite_sword", "stone_axe", "iron_axe", "diamond_axe",
+    "netherite_axe", "bow", "crossbow", "shield", "arrow", "leather_helmet", "leather_chestplate",
+    "leather_leggings", "leather_boots", "chainmail_helmet", "chainmail_chestplate",
+    "chainmail_leggings", "chainmail_boots", "iron_helmet", "iron_chestplate", "iron_leggings",
+    "iron_boots", "diamond_helmet", "diamond_chestplate", "diamond_leggings", "diamond_boots",
+    "netherite_helmet", "netherite_chestplate", "netherite_leggings", "netherite_boots", "bone",
+    "rotten_flesh", "string", "spider_eye", "leather", "feather", "gunpowder", "redstone",
+    "glowstone_dust", "iron_nugget", "gold_nugget", "iron_ingot", "coal", "ink_sac",
+    "blaze_powder", "ender_pearl", "slime_ball", "torch",
+];
+
+/// An item's index in [`TABLE`]; a name not in it is a bug, caught by the tests.
+pub(crate) fn item(name: &str) -> u8 {
+    TABLE.iter().position(|t| *t == name).unwrap_or_else(|| panic!("wowcraft: {name} isn't a gift")) as u8
+}
+
+/// The levels Minecraft's materials go with: leather and stone, chainmail, iron, diamond,
+/// netherite (the mod's `Progression.TIER_LEVELS`).
+const TIER_LEVELS: [u32; 5] = [1, 10, 20, 35, 50];
+
+pub(crate) fn tier_of(level: u32) -> usize {
+    TIER_LEVELS.iter().rposition(|&l| level >= l).unwrap_or(0)
+}
+
+pub(crate) fn plugin(app: &mut App) {
+    use SessionEventKind as K;
+    app.add_systems(Update, tell_character)
+        .net_handler(K::QuestComplete, on_quest_complete)
+        .net_handler(K::XpGain, on_xp_gain);
+}
+
+/// Put `count` of an item into Minecraft's inventory (`enchant` 0 to 3).
+pub(crate) fn give(link: &Link, item: u8, count: u32, enchant: u32) {
+    if count == 0 {
+        return;
+    }
+    info!("wowcraft: giving {count} x {}{}", TABLE[item as usize], if enchant > 0 { format!(" (enchant {enchant})") } else { String::new() });
+    link.push_input(IN_GIVE, item as u16, count.min(i32::MAX as u32) as i32, enchant.min(3) as i32, 0);
+}
+
+/// Drop `count` of an item (or experience) into Minecraft's world at `at`.
+pub(crate) fn drop_at(link: &Link, item: u8, count: u8, at: Vec3) {
+    if count == 0 {
+        return;
+    }
+    debug!("wowcraft: dropping {count} x {} at {at:?}", TABLE[item as usize]);
+    let code = item as u16 | (count as u16) << 8;
+    let eighth = |v: f32| (v * 8.0).round() as i32;
+    link.push_input(IN_DROP, code, eighth(at.x), eighth(at.y), eighth(at.z));
+}
+
+/// Whose Minecraft things these are: our WoW character, once per character and per Minecraft.
+fn tell_character(
+    wc: Res<WowCraft>,
+    state: Res<State<ClientState>>,
+    self_guid: Res<SelfGuid>,
+    mut told: Local<Option<(u64, u32)>>,
+) {
+    if *state.get() != ClientState::InWorld || !wc.mc_in_world() {
+        return;
+    }
+    let Some(guid) = self_guid.0 else { return };
+    let now = (guid, wc.mc_pid());
+    if *told == Some(now) {
+        return;
+    }
+    info!("wowcraft: Minecraft's things are WoW character {guid:#x}'s");
+    wc.link.push_input(IN_CHARACTER, 0, guid as u32 as i32, (guid >> 32) as u32 as i32, 0);
+    *told = Some(now);
+}
+
+/// A quest's reward in Minecraft.
+#[derive(Debug, PartialEq)]
+pub(crate) struct QuestGifts {
+    pub(crate) emeralds: u32,
+    /// The gear piece and its enchant level.
+    pub(crate) gear: (u8, u32),
+    pub(crate) arrows: u32,
+    pub(crate) food: (u8, u32),
+    pub(crate) experience: u32,
+}
+
+pub(crate) fn quest_gifts(quest_id: u32, money: u32, xp: u32, level: u32) -> QuestGifts {
+    let tier = tier_of(level);
+    let pieces: &[&str] = match tier {
+        0 => &["stone_sword", "stone_axe", "bow", "shield", "leather_helmet", "leather_chestplate", "leather_leggings", "leather_boots"],
+        1 => &["stone_sword", "stone_axe", "crossbow", "shield", "chainmail_helmet", "chainmail_chestplate", "chainmail_leggings", "chainmail_boots"],
+        2 => &["iron_sword", "iron_axe", "crossbow", "shield", "iron_helmet", "iron_chestplate", "iron_leggings", "iron_boots"],
+        3 => &["diamond_sword", "diamond_axe", "bow", "diamond_helmet", "diamond_chestplate", "diamond_leggings", "diamond_boots"],
+        _ => &["netherite_sword", "netherite_axe", "crossbow", "netherite_helmet", "netherite_chestplate", "netherite_leggings", "netherite_boots"],
+    };
+    let mix = (quest_id as u64).wrapping_mul(0x9E37_79B9_7F4A_7C15) >> 32;
+    let piece = pieces[(mix % pieces.len() as u64) as usize];
+    let enchant = match tier {
+        0 => 0,
+        1 => (mix >> 8) as u32 % 2,
+        2 => 1,
+        3 => 2,
+        _ => 3,
+    };
+    let foods = ["cooked_beef", "cooked_porkchop", "cooked_mutton", "cooked_chicken", "cooked_cod", "cooked_salmon", "bread"];
+    let food = foods[((mix >> 16) % foods.len() as u64) as usize];
+    QuestGifts {
+        emeralds: (1 + ((money as f32 / 25.0).sqrt() as u32)).min(16),
+        gear: (item(piece), enchant),
+        arrows: if matches!(piece, "bow" | "crossbow") { 16 } else { 0 },
+        food: (item(food), 2 + (mix >> 24) as u32 % 3),
+        experience: (xp / 10).clamp(2, 200),
+    }
+}
+
+fn on_quest_complete(
+    In(ev): In<SessionEvent>,
+    wc: Res<WowCraft>,
+    me: Query<&ObjectStore, With<SelfPlayer>>,
+) {
+    let SessionEvent::QuestComplete(q) = ev else { return };
+    if !wc.mc_in_world() {
+        return;
+    }
+    let level = me.single().ok().and_then(|s| s.0.unit_level()).unwrap_or(1);
+    let g = quest_gifts(q.quest_id, q.money, q.xp, level);
+    info!("wowcraft: quest {} done ({} xp, {} copper): Minecraft rewards", q.quest_id, q.xp, q.money);
+    give(&wc.link, item("emerald"), g.emeralds, 0);
+    give(&wc.link, g.gear.0, 1, g.gear.1);
+    give(&wc.link, item("arrow"), g.arrows, 0);
+    give(&wc.link, g.food.0, g.food.1, 0);
+    give(&wc.link, 0, g.experience, 0);
+}
+
+/// Minecraft experience for WoW's: a kill's as orbs where it fell (and the kill is our loot's),
+/// any other straight in.
+fn on_xp_gain(
+    In(ev): In<SessionEvent>,
+    wc: Res<WowCraft>,
+    index: Res<GuidIndex>,
+    at: Query<&GlobalTransform>,
+    mut fights: ResMut<super::combat::Fights>,
+) {
+    let SessionEvent::XpGain(x) = ev else { return };
+    if !wc.mc_in_world() {
+        return;
+    }
+    let points = (x.total / 8).clamp(1, 100);
+    let fell = (x.kill && x.victim != 0)
+        .then(|| index.0.get(&x.victim).and_then(|&e| at.get(e).ok()))
+        .flatten()
+        .map(|t| t.translation() + Vec3::Y * 0.5);
+    if x.kill && x.victim != 0 {
+        fights.kills.push(x.victim);
+    }
+    match fell {
+        Some(pos) => {
+            let mut left = points;
+            while left > 0 {
+                let n = left.min(255);
+                drop_at(&wc.link, 0, n as u8, pos);
+                left -= n;
+            }
+        }
+        None => give(&wc.link, 0, points, 0),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_table_is_the_mods() {
+        assert_eq!(TABLE.len(), 69);
+        assert_eq!(TABLE[0], "experience");
+        assert_eq!(item("emerald"), 15);
+        assert_eq!(item("netherite_boots"), 50);
+        assert_eq!(item("torch"), 68);
+        // Every loot name the combat side uses is in it.
+        for kind in 0..12 {
+            for name in ["Mottled Boar", "Plainstrider", "Kobold Miner", "Rattlecage Skeleton", "Webwood Spider", "Murloc Raider"] {
+                for (i, _) in super::super::combat::loot_for(name, kind, 30, 3) {
+                    assert!((i as usize) < TABLE.len());
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn tiers_by_level() {
+        assert_eq!(tier_of(1), 0);
+        assert_eq!(tier_of(9), 0);
+        assert_eq!(tier_of(10), 1);
+        assert_eq!(tier_of(34), 2);
+        assert_eq!(tier_of(35), 3);
+        assert_eq!(tier_of(60), 4);
+    }
+
+    #[test]
+    fn a_quest_rewards_gear_for_our_level() {
+        let low = quest_gifts(783, 35, 80, 2);
+        let name = TABLE[low.gear.0 as usize];
+        assert!(name.starts_with("stone") || name.starts_with("leather") || name == "bow" || name == "shield", "{name}");
+        assert_eq!(low.gear.1, 0);
+        assert!(low.emeralds >= 1 && low.emeralds <= 3);
+        let high = quest_gifts(4001, 60_000, 9000, 60);
+        let name = TABLE[high.gear.0 as usize];
+        assert!(name.starts_with("netherite") || name == "crossbow", "{name}");
+        assert_eq!(high.gear.1, 3);
+        assert_eq!(high.emeralds, 16);
+        assert_eq!(high.experience, 200);
+    }
+}
