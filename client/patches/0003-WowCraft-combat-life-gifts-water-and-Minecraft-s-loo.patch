diff --git a/crates/benilla-app/src/wowcraft/ui.rs b/crates/benilla-app/src/wowcraft/ui.rs
new file mode 100644
index 00000000..583e9251
--- /dev/null
+++ b/crates/benilla-app/src/wowcraft/ui.rs
@@ -0,0 +1,144 @@
+//! WoW's interface under WowCraft, as WowCraft has it:
+//! - the action bars hide while Minecraft has the input (its hotbar stands where they were) and come
+//!   back with WoW's cursor (C);
+//! - Log Out is off (Minecraft plays along; the launcher's Stop closes everything), and the
+//!   durability figure, which Minecraft's own armour replaces, is hidden;
+//! - our own overhead name is off (the Minecraft body has its own), the first-login cinematic is
+//!   skipped and every tutorial tip is marked seen;
+//! - character creation offers our Minecraft name.
+
+use bevy::prelude::*;
+
+use benilla_ui::script::UiScript;
+
+use super::{InputOwner, WowCraft};
+use crate::char_select::ClientState;
+
+const HIDE_BARS: &str = "for _, n in ipairs({'MainMenuBar', 'MultiBarBottomLeft', 'MultiBarBottomRight', 'ShapeshiftBarFrame', 'PetActionBarFrame'}) do local f = getglobal(n) if f then f:Hide() end end";
+const SHOW_BARS: &str = "if MainMenuBar then MainMenuBar:Show() end if MultiActionBar_Update then MultiActionBar_Update() end if ShapeshiftBar_Update then ShapeshiftBar_Update() end if PetActionBar_Update then PetActionBar_Update() end";
+const SETUP: &str = "if GameMenuButtonLogout then GameMenuButtonLogout:Disable() end if DurabilityFrame then pcall(function() DurabilityFrame:UnregisterAllEvents() end) DurabilityFrame:Hide() end";
+/// What a refused Log Out says, in WoW's system-message gold.
+pub(crate) const LOGOUT_REFUSED: &str = "if DEFAULT_CHAT_FRAME then DEFAULT_CHAT_FRAME:AddMessage('Log Out is off in WowCraft: Minecraft plays along. Close the game with the launcher\\'s Stop.', 1, 0.82, 0.25) end";
+
+pub(crate) fn plugin(app: &mut App) {
+    app.add_systems(
+        Update,
+        (prepare_ui, action_bars, skip_cinematic, mark_tutorials, offer_minecraft_name).after(crate::ui_script::UiInput),
+    );
+}
+
+/// Once per interface load in the world: Log Out off, the durability figure gone, our name off.
+fn prepare_ui(
+    script: Option<NonSendMut<UiScript>>,
+    state: Res<State<ClientState>>,
+    mut cvars: ResMut<crate::cvars::Cvars>,
+    mut memo: Local<crate::ui_script::VmMemo<bool>>,
+) {
+    let Some(script) = script else { return };
+    if *state.get() != ClientState::InWorld || !memo.claim(&script) {
+        return;
+    }
+    if let Err(e) = script.run_chunk(SETUP.as_bytes()) {
+        warn!("wowcraft: couldn't turn off Log Out: {e}");
+    }
+    for name in ["UnitNamePlayer", "UnitNameOwn"] {
+        let _ = cvars.set(name, "0");
+    }
+}
+
+/// The action bars follow who has the input.
+fn action_bars(
+    script: Option<NonSendMut<UiScript>>,
+    owner: Res<InputOwner>,
+    wc: Res<WowCraft>,
+    state: Res<State<ClientState>>,
+    mut shown: Local<Option<bool>>,
+    mut memo: Local<crate::ui_script::VmMemo<bool>>,
+) {
+    let Some(script) = script else { return };
+    if *state.get() != ClientState::InWorld {
+        *shown = None;
+        return;
+    }
+    // A fresh interface starts with them shown.
+    if memo.claim(&script) {
+        *shown = None;
+    }
+    // Shown with WoW's cursor or with no Minecraft to play; hidden while Minecraft plays.
+    let want = !owner.minecraft || !wc.mc_in_world();
+    if *shown == Some(want) {
+        return;
+    }
+    let chunk = if want { SHOW_BARS } else { HIDE_BARS };
+    match script.run_chunk(chunk.as_bytes()) {
+        Ok(()) => {
+            info!("wowcraft: action bars {}", if want { "shown" } else { "hidden" });
+            *shown = Some(want);
+        }
+        Err(e) => warn!("wowcraft: couldn't change the action bars: {e}"),
+    }
+}
+
+/// The first login's race cinematic: Minecraft's player would stand through it.
+fn skip_cinematic(mut cine: ResMut<crate::cinematic::Cinematic>, net: Option<Res<crate::net::NetCommands>>) {
+    if cine.is_playing() {
+        info!("wowcraft: skipping the cinematic");
+        crate::cinematic::stop(&mut cine, net.as_deref());
+    }
+}
+
+/// Every tip seen, once a world session's flags have landed.
+fn mark_tutorials(mut tutorials: ResMut<crate::tutorial::Tutorials>, state: Res<State<ClientState>>, mut done: Local<bool>) {
+    if *state.get() != ClientState::InWorld {
+        *done = false;
+        return;
+    }
+    if !*done && tutorials.flags_known() {
+        tutorials.clear_all();
+        info!("tutorial: WowCraft marks every tip seen");
+        *done = true;
+    }
+}
+
+/// Our Minecraft name, written by the mod, as the new character's (WoW's rules: letters only, two
+/// to twelve, one capital).
+fn offer_minecraft_name(state: Res<State<ClientState>>, sel: Option<ResMut<crate::char_create::CreateSelection>>, mut offered: Local<bool>) {
+    if *state.get() != ClientState::CharCreate {
+        *offered = false;
+        return;
+    }
+    let Some(mut sel) = sel else { return };
+    if *offered {
+        return;
+    }
+    *offered = true;
+    let Some(path) = super::env_file("WOWCRAFT_NAME_FILE") else { return };
+    let Some(name) = std::fs::read_to_string(path).ok().and_then(|t| wow_name(&t)) else { return };
+    if sel.prefill_name(&name) {
+        info!("wowcraft: offering the Minecraft name {name} for the new character");
+    }
+}
+
+/// A Minecraft name as a WoW one: its letters, at most twelve, capitalised; none if under two.
+pub(crate) fn wow_name(minecraft: &str) -> Option<String> {
+    let letters: String = minecraft.chars().filter(|c| c.is_ascii_alphabetic()).take(12).collect();
+    if letters.len() < 2 {
+        return None;
+    }
+    let mut out = letters[..1].to_ascii_uppercase();
+    out.push_str(&letters[1..].to_ascii_lowercase());
+    Some(out)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_minecraft_name_becomes_a_wow_one() {
+        assert_eq!(wow_name("Notch").as_deref(), Some("Notch"));
+        assert_eq!(wow_name("xX_Steve_99_Xx\n").as_deref(), Some("Xxstevexx"));
+        assert_eq!(wow_name("CaptainSparklez123").as_deref(), Some("Captainspark"));
+        assert_eq!(wow_name("a1").as_deref(), None);
+    }
+}
