diff --git a/crates/benilla-app/src/wowcraft/life.rs b/crates/benilla-app/src/wowcraft/life.rs
new file mode 100644
index 00000000..b1ac43b8
--- /dev/null
+++ b/crates/benilla-app/src/wowcraft/life.rs
@@ -0,0 +1,131 @@
+//! Minecraft's hearts are our life. On entering the world the WoW body is made unkillable
+//! (GM `.cheat god on`, which leaves it at one hit point at worst) and GM mode goes off, so
+//! creatures fight us. When Minecraft's player dies, so does the WoW body (`.die`); the spirit is
+//! released at once, and the ghost, once at the graveyard, is revived there (`.revive`) and made
+//! unkillable again. Minecraft's player respawns and follows us to the graveyard.
+
+use bevy::prelude::*;
+
+use wowcraft_link::proto::*;
+
+use super::combat::Gm;
+use super::WowCraft;
+use crate::char_select::ClientState;
+use crate::net::{ClientCommand, ObjectStore, SelfGuid, SelfPlayer};
+
+/// How long a step waits for the server before it's asked again.
+const RETRY_SECS: f32 = 5.0;
+/// A ghost waits this long for the graveyard teleport to settle before it's revived.
+const GHOST_SETTLE_SECS: f32 = 2.0;
+
+pub(crate) fn plugin(app: &mut App) {
+    app.init_resource::<Life>().add_systems(Update, (take_over, follow_death).chain());
+}
+
+#[derive(Resource, Default, Debug)]
+struct Life {
+    /// Set up for this world session.
+    set_up: bool,
+    /// Minecraft's player was dead last frame.
+    mc_was_dead: bool,
+    /// We asked the server to kill the WoW body, at this time.
+    dying_since: Option<f32>,
+    /// We asked for the spirit's release, at this time.
+    released_at: Option<f32>,
+    /// The body became a ghost at this time.
+    ghost_since: Option<f32>,
+    /// We asked for the revive, at this time.
+    revived_at: Option<f32>,
+}
+
+/// GM mode off and the body unkillable, once per world session with Minecraft there.
+fn take_over(
+    mut life: ResMut<Life>,
+    wc: Res<WowCraft>,
+    state: Res<State<ClientState>>,
+    player: Res<crate::player::Player>,
+    self_guid: Res<SelfGuid>,
+    selection: Res<crate::target::Selection>,
+    gm: Gm,
+) {
+    if *state.get() != ClientState::InWorld {
+        *life = Life::default();
+        return;
+    }
+    if life.set_up || !player.active || !wc.mc_in_world() {
+        return;
+    }
+    let Some(guid) = self_guid.0 else { return };
+    info!("wowcraft: Minecraft's hearts are our life; the WoW body can't die on its own");
+    gm.say(".gm off");
+    // `.cheat god` takes the selected player, or us with none; a selected creature fails it.
+    gm.send(ClientCommand::SetSelection { guid });
+    gm.say(".cheat god on");
+    gm.send(ClientCommand::SetSelection { guid: selection.guid.unwrap_or(0) });
+    life.set_up = true;
+}
+
+/// Minecraft's death is ours; our death is a trip to the graveyard and back.
+fn follow_death(
+    mut life: ResMut<Life>,
+    wc: Res<WowCraft>,
+    state: Res<State<ClientState>>,
+    self_guid: Res<SelfGuid>,
+    me: Query<&ObjectStore, With<SelfPlayer>>,
+    selection: Res<crate::target::Selection>,
+    gm: Gm,
+    time: Res<Time>,
+) {
+    if *state.get() != ClientState::InWorld || !life.set_up {
+        return;
+    }
+    let (Some(guid), Ok(me)) = (self_guid.0, me.single()) else { return };
+    let now = time.elapsed_secs();
+    let ghost = me.0.player_is_ghost();
+    let dead = me.0.unit_is_dead() && !ghost;
+
+    // Minecraft's player died: so does the WoW body.
+    let mc_dead = wc.mc.is_some_and(|m| m.flags & MC_DEAD != 0) || wc.events.iter().any(|e| e.kind == EV_PLAYER_DIED);
+    let mc_died = mc_dead && !life.mc_was_dead;
+    life.mc_was_dead = wc.mc.is_some_and(|m| m.flags & MC_DEAD != 0);
+    if mc_died && !dead && !ghost && life.dying_since.is_none() {
+        info!("wowcraft: the Minecraft player died; so do we");
+        // `.die` takes the selection, and ends god mode on it.
+        gm.send(ClientCommand::SetSelection { guid });
+        gm.say(".die");
+        gm.send(ClientCommand::SetSelection { guid: selection.guid.unwrap_or(0) });
+        life.dying_since = Some(now);
+    }
+    if let Some(since) = life.dying_since {
+        if dead || ghost || now - since > RETRY_SECS {
+            life.dying_since = None;
+        }
+    }
+
+    // Dead: the spirit goes to the graveyard.
+    if dead {
+        if life.released_at.is_none_or(|t| now - t > RETRY_SECS) {
+            info!("wowcraft: dead; releasing the spirit");
+            gm.send(ClientCommand::RepopRequest);
+            life.released_at = Some(now);
+        }
+    } else {
+        life.released_at = None;
+    }
+
+    // A ghost at the graveyard: back to life, unkillable again.
+    if ghost {
+        let since = *life.ghost_since.get_or_insert(now);
+        if now - since >= GHOST_SETTLE_SECS && life.revived_at.is_none_or(|t| now - t > RETRY_SECS) {
+            info!("wowcraft: a ghost at the graveyard; reviving");
+            gm.send(ClientCommand::SetSelection { guid });
+            gm.say(".revive");
+            gm.say(".cheat god on");
+            gm.send(ClientCommand::SetSelection { guid: selection.guid.unwrap_or(0) });
+            life.revived_at = Some(now);
+        }
+    } else {
+        life.ghost_since = None;
+        life.revived_at = None;
+    }
+}
diff --git a/crates/benilla-app/src/wowcraft/mod.rs b/crates/benilla-app/src/wowcraft/mod.rs
index 06467785..538c680a 100644
--- a/crates/benilla-app/src/wowcraft/mod.rs
+++ b/crates/benilla-app/src/wowcraft/mod.rs
@@ -19,8 +19,13 @@
 pub(crate) mod account;
 pub(crate) mod blocks;
 pub(crate) mod collision;
+pub(crate) mod combat;
+pub(crate) mod gifts;
