+/// Everything near us, as Minecraft's actor table.
+fn publish_actors(
+    wc: Res<WowCraft>,
+    player: Res<Player>,
+    around: Around,
+    mut ids: ResMut<FormIds>,
+    fights: Res<Fights>,
+    time: Res<Time>,
+    mut next: Local<f32>,
+    mut said: Local<f32>,
+) {
+    let now = time.elapsed_secs();
+    if now < *next {
+        return;
+    }
+    *next = now + ACTOR_PERIOD;
+    let me = around.me.single().ok();
+    let mut near: Vec<(f32, ActorRecord)> = Vec::new();
+    for (_, guid, store, at, height) in &around.objects {
+        let pos = at.translation();
+        let d = pos.distance(player.pos);
+        if d > ACTOR_RANGE {
+            continue;
+        }
+        let g = guid.0;
+        if guid::is_gameobject(g) {
+            if fights.taken.get(&g).is_some_and(|&until| now < until) {
+                continue;
+            }
+            let Some(node) = around.templates.as_ref().and_then(|t| t.get(g)).and_then(|t| node_of(&t.name)) else {
+                continue;
+            };
+            // The mod reads a node's box from its corner: x and z sizes in `width` and
+            // `health_frac`, the height in `height`.
+            near.push((
+                d,
+                ActorRecord {
+                    form_id: ids.id(g),
+                    flags: ACTOR_ORE,
+                    pos: [pos.x - node.size[0] * 0.5, pos.y, pos.z - node.size[2] * 0.5],
+                    yaw: 0.0,
+                    width: node.size[0],
+                    height: node.size[1],
+                    health_frac: node.size[2],
+                    level: node.kind,
+                    pad: 0,
+                    name: [0; 24],
+                },
+            ));
+            continue;
+        }
+        if !store.is_unit() {
+            continue;
+        }
+        let f = &store.0;
+        let reaction = crate::ui_unit::unit_reaction(around.factions.as_deref(), &around.reputations, store, me);
+        let mut flags = 0;
+        if reaction <= 3 {
+            flags |= ACTOR_HOSTILE;
+        }
+        if reaction >= 5 || f.unit_flags() & UNIT_UNHITTABLE != 0 {
+            flags |= ACTOR_FRIENDLY;
+        }
+        if f.unit_is_dead() {
+            flags |= ACTOR_DEAD;
+        }
+        if f.unit_flags() & UNIT_IN_COMBAT != 0 {
+            flags |= ACTOR_IN_COMBAT;
+        }
+        let entry = f.object_entry().unwrap_or(0);
+        if !guid::is_player(g) && is_trader(f.unit_npc_flags(), around.names.creature_subname(entry)) {
+            flags |= ACTOR_TRADER;
+        }
+        let health = f.unit_health().unwrap_or(1) as f32;
+        let max = f.unit_max_health().unwrap_or(1).max(1) as f32;
+        let scale = f.object_scale_x().filter(|s| *s > 0.0).unwrap_or(1.0);
+        let width = (f.unit_bounding_radius() * 2.0 * scale).clamp(0.6, 6.0);
+        let height = height.map_or(2.0, |h| h.0).clamp(0.5, 12.0);
+        let (yaw, _, _) = at.rotation().to_euler(EulerRot::YXZ);
+        let name = around.names.peek_unit(g, Some(store)).unwrap_or("");
+        near.push((
+            d,
+            ActorRecord {
+                form_id: ids.id(g),
+                flags,
+                pos: pos.to_array(),
+                yaw: super::mc_yaw_of(yaw),
+                width,
+                height,
+                health_frac: (health / max).clamp(0.0, 1.0),
+                level: f.unit_level().unwrap_or(1).min(u16::MAX as u32) as u16,
+                pad: 0,
+                name: name_bytes(name),
+            },
+        ));
+    }
+    near.sort_by(|a, b| a.0.total_cmp(&b.0));
+    near.truncate(MAX_ACTORS);
+    // Once in a while: what decides hostility, ours and the nearest unit's.
+    if now >= *said {
+        *said = now + 30.0;
+        if let (Some(me), Some((_, _, store, _, _))) = (me, around.objects.iter().filter(|o| o.2.is_unit()).min_by(|a, b| a.3.translation().distance(player.pos).total_cmp(&b.3.translation().distance(player.pos)))) {
+            debug!(
+                "wowcraft: our faction template {:?} (player flags {:#x}); the nearest unit's {:?} reads {}",
+                me.0.unit_faction_template(),
+                me.0.player_flags(),
+                store.0.unit_faction_template(),
+                crate::ui_unit::unit_reaction(around.factions.as_deref(), &around.reputations, store, Some(me)),
+            );
+        }
+    }
+    let records: Vec<ActorRecord> = near.into_iter().map(|(_, r)| r).collect();
+    wc.link.write_actors(&records);
+}
+
+/// WoW damage for a Minecraft hit on a creature: by its level (a stone sword, 5, takes a level-10
+/// creature in about five), and never fewer than forty of Minecraft's hearts' worth of its health,
+/// so a high-level one stays fightable.
+pub(crate) fn wow_damage(mc_damage: f32, level: u32, max_health: u32) -> u32 {
+    if mc_damage <= 0.0 {
+        return 0;
+    }
+    let by_level = mc_damage * (3.0 + 0.6 * level as f32);
+    let by_health = max_health as f32 * mc_damage / 40.0;
+    by_level.max(by_health).round().max(1.0) as u32
+}
+
+/// Minecraft damage (half hearts) for a WoW hit on us: the share of our health it would take, of
+/// Minecraft's twenty, a little harder as we level (Minecraft's armour takes its part after).
+pub(crate) fn mc_damage(wow_damage: u32, max_health: u32, level: u32) -> f32 {
+    if wow_damage == 0 {
+        return 0.0;
+    }
+    let share = wow_damage as f32 / max_health.max(1) as f32;
+    share * 20.0 * (1.25 + 0.05 * level as f32)
+}
+
+/// `IN_HURT`'s amount: the mod takes it as hundredths of a Skyrim point, five to a half heart.
+fn hurt_amount(mc: f32) -> i32 {
+    (mc * 500.0).round() as i32
+}
