+    /// Our WoW body stays hidden though the exterior cull admits it every frame.
+    #[test]
+    fn the_wow_body_stays_hidden_past_the_exterior_cull() {
+        let mut app = App::new();
+        let cull = |mut bodies: Query<&mut Visibility>| {
+            for mut v in &mut bodies {
+                *v = Visibility::Inherited;
+            }
+        };
+        app.add_systems(PostUpdate, cull.in_set(benilla_world::exterior_cull::ExteriorCullSet))
+            .add_systems(PostUpdate, after_the_cull(hide_wow_body));
+        let me = app.world_mut().spawn((crate::net::SelfPlayer, Visibility::Inherited)).id();
+        for _ in 0..3 {
+            app.update();
+            assert_eq!(app.world().get::<Visibility>(me), Some(&Visibility::Hidden));
+        }
+    }
