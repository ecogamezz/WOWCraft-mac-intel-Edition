+
+/// Last before visibility propagates: the exterior cull sets every body it admits back to
+/// `Inherited` each frame, so a body hidden any earlier is drawn all the same.
+fn after_the_cull<M>(
+    systems: impl bevy::ecs::schedule::IntoScheduleConfigs<bevy::ecs::system::ScheduleSystem, M>,
+) -> bevy::ecs::schedule::ScheduleConfigs<bevy::ecs::system::ScheduleSystem> {
+    systems
+        .after(benilla_world::exterior_cull::ExteriorCullSet)
+        .before(bevy::camera::visibility::VisibilitySystems::VisibilityPropagate)
+}
+
+fn mc_in_world(wc: Res<WowCraft>) -> bool {
