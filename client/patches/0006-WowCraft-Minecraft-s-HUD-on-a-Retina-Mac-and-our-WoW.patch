+/// Minecraft sizes its window (SDL) in the display's points. On macOS a Retina window has twice as
+/// many pixels as points, so Minecraft gets our size, and the cursor, in points there, and its
+/// frame (which the mod reads back as the overlay, and drops past 3840 × 2160) comes out at our
+/// pixel size. Elsewhere a window is sized in pixels, and Minecraft gets ours.
+pub(crate) const MINECRAFT_IN_POINTS: bool = cfg!(target_os = "macos");
+
+/// The viewport Minecraft sizes its window to, for our window `physical` pixels at `scale`, and
+/// whether it is a high-DPI window's pixels ([`SKY_HIRES`]: Minecraft scales its GUI up).
+pub(crate) fn minecraft_viewport(physical: UVec2, scale: f32, in_points: bool) -> (UVec2, bool) {
+    let hires = scale > 1.0;
+    if in_points && hires {
+        ((physical.as_vec2() / scale).round().as_uvec2().max(UVec2::ONE), false)
+    } else {
+        (physical, hires)
+    }
+}
