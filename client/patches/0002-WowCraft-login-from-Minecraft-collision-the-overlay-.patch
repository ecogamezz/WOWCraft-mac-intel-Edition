--- /dev/null
+++ b/crates/benilla-app/src/wowcraft/overlay.rs
@@ -0,0 +1,100 @@
+//! Minecraft's own screen over WoW's: its hotbar, hearts and hunger, crosshair, first-person hand,
+//! chat and every screen it opens (the inventory, a chest, its menu). The mod reads Minecraft's
+//! frame back each frame (transparent where its world would be, premultiplied, bottom-up rows) at
+//! our window's pixel size, and publishes it through the overlay triple buffer; here it becomes one
+//! quad over the whole window, painted after all of WoW's interface in the player-UI pass.
+
+use bevy::asset::RenderAssetUsages;
+use bevy::math::Rect;
+use bevy::prelude::*;
+use bevy::render::render_resource::{Extent3d, TextureDimension, TextureFormat};
+use bevy::window::PrimaryWindow;
+
+use super::WowCraft;
+use crate::char_select::ClientState;
+use crate::ui_pass::{UiQuad, UiQuads};
+
+pub(crate) fn plugin(app: &mut App) {
+    app.init_resource::<Overlay>().add_systems(
+        Update,
+        (take_frame, show_frame.in_set(crate::ui_pass::UiQuadAppend)).chain(),
+    );
+}
+
+#[derive(Resource, Default)]
+struct Overlay {
+    image: Option<Handle<Image>>,
+    size: UVec2,
+    /// A frame arrived since Minecraft (re)joined its world.
+    ready: bool,
+}
+
+/// The newest published frame, into our texture.
+fn take_frame(wc: Res<WowCraft>, mut overlay: ResMut<Overlay>, mut images: ResMut<Assets<Image>>) {
+    if !wc.mc_in_world() {
+        overlay.ready = false;
+        return;
+    }
+    if !wc.link.acquire_overlay() {
+        return;
+    }
+    let (header, pixels) = wc.link.overlay_front();
+    let (w, h) = (header.width, header.height);
+    if w == 0 || h == 0 || pixels.len() < (w * h * 4) as usize {
+        return;
+    }
+    let size = UVec2::new(w, h);
+    if overlay.image.is_none() || overlay.size != size {
+        let image = Image::new_fill(
+            Extent3d { width: w, height: h, depth_or_array_layers: 1 },
+            TextureDimension::D2,
+            &[0, 0, 0, 0],
+            // Minecraft's frame is display bytes, as a BLP is: decoded on sampling like the UI's.
+            TextureFormat::Rgba8UnormSrgb,
+            RenderAssetUsages::RENDER_WORLD | RenderAssetUsages::MAIN_WORLD,
+        );
+        overlay.image = Some(images.add(image));
+        overlay.size = size;
+    }
+    let Some(image) = overlay.image.as_ref().and_then(|h| images.get_mut(h)) else {
+        return;
+    };
+    let row = (w * 4) as usize;
+    let data = image.data.get_or_insert_with(Vec::new);
+    data.resize(row * h as usize, 0);
+    if header.flags & 1 != 0 {
+        // Read back from the GPU's origin, bottom row first: flipped into ours, top first.
+        for y in 0..h as usize {
+            let src = (h as usize - 1 - y) * row;
+            data[y * row..(y + 1) * row].copy_from_slice(&pixels[src..src + row]);
+        }
+    } else {
+        data.copy_from_slice(&pixels[..row * h as usize]);
+    }
+    overlay.ready = true;
+}
+
+/// Over every WoW frame: the append lane's quads sort with the interface's, and this one's key is
+/// the highest.
+fn show_frame(
+    overlay: Res<Overlay>,
+    wc: Res<WowCraft>,
+    state: Res<State<ClientState>>,
+    window: Query<&Window, With<PrimaryWindow>>,
+    mut quads: ResMut<UiQuads>,
+) {
+    if !overlay.ready || !wc.mc_in_world() || *state.get() != ClientState::InWorld {
+        return;
+    }
+    let (Some(image), Ok(window)) = (overlay.image.as_ref(), window.single()) else {
+        return;
+    };
+    quads.overlays.push(UiQuad {
+        rect: Rect::new(0.0, 0.0, window.width(), window.height()),
+        z_key: u64::MAX,
+        texture: Some(image.clone()),
+        // Drawn over a transparent clear with straight-alpha blending: the bytes are premultiplied.
+        premultiplied: true,
+        ..default()
+    });
+}
