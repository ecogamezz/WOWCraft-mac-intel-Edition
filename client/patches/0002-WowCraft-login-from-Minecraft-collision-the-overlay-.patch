+    /// WowCraft: an account from Minecraft's world (`crate::wowcraft::account`), submitted at
+    /// once the way the env fast path's is; the env path is spent so it can't override it.
+    pub(crate) fn submit_external(&mut self, user: String, pass: String, now: f32) {
